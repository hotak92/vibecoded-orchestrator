{
  "name": "excalidraw-mcp-server",
  "mcpName": "io.github.debu-sinha/excalidraw",
  "version": "2.0.0",
  "description": "Security-hardened MCP server for Excalidraw with API key auth, rate limiting, and real-time canvas sync",
  "main": "dist/mcp/index.bundled.js",
  "type": "module",
  "bin": {
    "excalidraw-mcp-server": "dist/mcp/index.bundled.js"
  },
  "scripts": {
    "start": "node dist/mcp/index.bundled.js",
    "bundle": "esbuild dist/mcp/index.js --bundle --platform=node --format=esm --outfile=dist/mcp/index.bundled.js --define:process.env.NODE_ENV='\"production\"' --banner:js='import { createRequire as __vcoCreateRequire } from \"node:module\"; const require = __vcoCreateRequire(import.meta.url);'",
    "canvas": "node dist/canvas/index.js",
    "build": "npm run build:server && npm run build:widget && npm run build:frontend",
    "build:server": "tsc -p tsconfig.json",
    "build:widget": "vite build --config vite.widget.config.ts",
    "build:frontend": "vite build",
    "dev": "concurrently \"tsc -p tsconfig.json --watch\" \"vite\"",
    "lint": "eslint src test",
    "lint:fix": "eslint --fix src test",
    "format": "prettier --write src test",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run lint && npm run type-check && npm run test && npm run build",
    "generate-key": "node scripts/generate-api-key.cjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@excalidraw/mermaid-to-excalidraw": "^2.2.2",
    "@modelcontextprotocol/ext-apps": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.0.0",
    "mermaid": "^11.12.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite-plugin-singlefile": "^2.3.0",
    "ws": "^8.18.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "concurrently": "^10.0.5",
    "esbuild": "0.28.2",
    "eslint": "^10.10.0",
    "prettier": "^3.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "author": {
    "name": "Debu Sinha"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/debu-sinha/excalidraw-mcp-server.git"
  },
  "keywords": [
    "excalidraw",
    "mcp",
    "model-context-protocol",
    "diagramming",
    "security",
    "websocket",
    "real-time"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/**/*",
    "LICENSE",
    "README.md"
  ]
}
