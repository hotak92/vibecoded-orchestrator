#!/usr/bin/env bash
# Code Graph Analyzer wrapper - AST-based code entity extraction
# Usage: code-graph-analyze /path/to/repo [OPTIONS]

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Probe candidate venvs.
#
# Once the bundle install lands the script in a USER PROJECT's
# `.claude/scripts/`, `$SCRIPT_DIR/../../.venv` resolves to the
# project's OWN venv (e.g. /home/me/MediaLibrary/.venv) — which
# typically has the project's own deps but NOT weaviate-client +
# the analyzer deps. So we must:
#
# 1. Prefer `$VCT_INSTALL_ROOT/.venv` (the launcher always sets this
#    to the orchestrator clone, which has weaviate-client) over the
#    script-relative candidates. This is the canonical case for any
#    project registered via the launcher.
# 2. ALSO validate each candidate venv has weaviate-client installed
#    before activating it. This protects against the script being
#    run from an unrelated context where SCRIPT_DIR/../../.venv
#    happens to exist but is the wrong env.
#
# Bug history:
#   - 2026-04-28: example project codegraph build failed with
#     "weaviate-client not installed" because example/Code had
#     neither .venv nor claude_mcp_servers/.venv → added
#     VCT_INSTALL_ROOT fallbacks.
#   - 2026-05-07: MediaLibrary codegraph build failed with
#     `ModuleNotFoundError: weaviate` because the project HAS its
#     own `.venv/` (used by its own runtime) which the script
#     activated before getting to VCT_INSTALL_ROOT → reorder +
#     validate-has-weaviate-client.
CANDIDATES=(
    "${VCT_INSTALL_ROOT:-}/.venv"                      # launcher-provided install root (canonical)
    "${VCT_INSTALL_ROOT:-}/claude_mcp_servers/.venv"   # launcher-provided legacy path
    "$SCRIPT_DIR/../../.venv"                          # vco OSS install root (script in orch clone)
    "$SCRIPT_DIR/../../claude_mcp_servers/.venv"       # legacy Claude orch (script in orch clone)
)

# Validate a venv has the analyzer deps installed.
# Without this gate, an unrelated venv (e.g. the project's own venv
# at SCRIPT_DIR/../../.venv post bundle install) would be activated
# and the analyzer would crash with ModuleNotFoundError downstream.
venv_has_analyzer_deps() {
    local v="$1"
    local py=""
    if [ -x "$v/bin/python" ]; then py="$v/bin/python"
    elif [ -x "$v/bin/python3" ]; then py="$v/bin/python3"
    else return 1
    fi
    "$py" -c "import weaviate" 2>/dev/null
}

VENV_PATH=""
for c in "${CANDIDATES[@]}"; do
    [ -z "$c" ] && continue
    [ "$c" = "/.venv" ] && continue                # empty VCT_INSTALL_ROOT → skip
    [ "$c" = "/claude_mcp_servers/.venv" ] && continue
    if venv_has_analyzer_deps "$c"; then
        VENV_PATH="$c"
        break
    fi
done

if [ -n "$VENV_PATH" ]; then
    source "$VENV_PATH/bin/activate"
fi

# Run the Python script. Use the venv's python if we activated one,
# otherwise fall through to system python3 (which will fail loudly with
# "weaviate-client not installed" rather than silently using the wrong
# environment).
python3 "$SCRIPT_DIR/analyze_code_graph.py" "$@"
