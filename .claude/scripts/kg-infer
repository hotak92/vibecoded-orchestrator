#!/bin/bash
# Knowledge Graph Inference Wrapper
#
# Applies semantic inference rules to derive new facts from typed relationships.
#
# Usage:
#   .claude/scripts/kg-infer "Node Title"    # Infer for single node
#   .claude/scripts/kg-infer --all           # Infer for all nodes

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# Probe canonical .venv locations (OSS install-root first, legacy second).
for _c in "$PROJECT_ROOT/.venv" "$PROJECT_ROOT/claude_mcp_servers/.venv"; do
    if [ -f "$_c/bin/activate" ]; then
        source "$_c/bin/activate"
        break
    fi
done

# Run inference script
exec python "$SCRIPT_DIR/infer_knowledge.py" "$@"
