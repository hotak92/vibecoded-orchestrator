#!/bin/bash
# Wrapper script for sync_knowledge_graph.py with automatic venv activation

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# Probe canonical .venv locations. install-root/.venv (OSS) takes
# precedence; claude_mcp_servers/.venv kept as fallback for legacy
# private-Claude-orch installs.
VENV_PATH=""
for _c in "$PROJECT_ROOT/.venv" "$PROJECT_ROOT/claude_mcp_servers/.venv"; do
    if [ -x "$_c/bin/python" ] || [ -x "$_c/bin/python3" ]; then
        VENV_PATH="$_c"
        break
    fi
done

if [ -n "$VENV_PATH" ]; then
    source "$VENV_PATH/bin/activate"
fi

python "$SCRIPT_DIR/sync_knowledge_graph.py" "$@"
