<?xml version="1.0" encoding="UTF-8"?>
<!--
  {{INSTALLED_AT_PATH}}

  macOS LaunchAgent for the VCO model gateway (`vct-model-gateway`).

  DEFAULT OFF. This plist exists only because the user asked for it, via the
  `register-boot` flag of `vct-model-gateway` or the launcher's gateway
  toggle. The gateway proxies under the user's Claude login and any
  configured vendor subscription, so making it a login-time daemon widens
  the machine's security surface — the user's decision, not the
  installer's. `install.py` run with the `update` flag re-renders an
  EXISTING plist; it never creates a first one.

  (Long flags are named without their leading double hyphen throughout this
  comment: XML 1.0 forbids the two-hyphen sequence inside a comment, and the
  container-stack template carries the same note for the same reason.)

  Written by vco_lib/boot_service.py, the same home that registers the
  container stack's LaunchAgent and unregisters both. `launchctl bootstrap
  gui/<uid>` is the modern load path with `launchctl load -w` as the legacy
  fallback; re-registration is idempotent because an already-loaded agent's
  "Bootstrap failed: 17: File exists" is tolerated.

  Log paths: launchd refuses to start a job whose StandardOutPath directory
  does not exist, so boot_service.py creates it before bootstrapping.

  Template substitutions. NAMED WITHOUT THEIR BRACES on purpose (v0.2.95):
  boot_service.render_template substitutes every occurrence of a token,
  comments included, so a documented token here would be replaced by the
  VALUE — and a value containing a double hyphen (any path with one in it,
  which is legal everywhere) would then close this comment early and produce
  a plist launchd rejects outright. The braced forms appear below, in the
  document itself, which is the only place they belong.

    INSTALLED_AT_PATH — absolute path where this plist landed
    LABEL             — launchd label (reverse-DNS, must match filename)
    EXEC_ARGV_PLIST   — the ProgramArguments array body, pre-rendered as
                        <string> elements: the gateway entry point resolved
                        at registration time plus the `serve` verb
    WORKING_DIR       — directory the daemon runs in
    STATE_DIR         — VCT state root pinned at registration time
    SECRET_PROJECT    — the per-project OVERRIDE for the scope the daemon
                        resolves vendor keys in. EMPTY on every install that
                        did not ask for one, which is what leaves the daemon
                        resolving its own install root at RUNTIME
    BOOT_LOG_FILE     — where launchd captures the PROCESS's own output
                        (startup refusals, tracebacks). Deliberately NOT the
                        daemon's own log file: the daemon logs to stderr as
                        well as to that file, so pointing launchd at the same
                        path would write every record twice.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{{LABEL}}</string>

    <key>ProgramArguments</key>
    <array>
{{EXEC_ARGV_PLIST}}
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart on abnormal exit only. A bare KeepAlive=true would also
         restart after a clean shutdown, making "stop the gateway"
         impossible from the launcher. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- Throttle restarts so a gateway that cannot bind its port does not
         spin. macOS's own default is 10s; stated here so it is visible. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>WorkingDirectory</key>
    <string>{{WORKING_DIR}}</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- Pin the state dir chosen at registration time; a dev install
             with VCT_STATE_DIR set must not contaminate production state at
             the next login. -->
        <key>VCT_STATE_DIR</key>
        <string>{{STATE_DIR}}</string>

        <!-- The PER-PROJECT OVERRIDE for the scope the daemon resolves
             vendor keys in. Normally EMPTY, and empty is the working state:
             it reads back as unset, and the daemon then resolves THIS
             INSTALL'S orchestrator root itself, at startup
             (model_router.secrets). WorkingDirectory below is the state root,
             which is NOT a registered project — and `agent_secrets` resolves
             its hub tier (the ONLY route to an OS-keychain key) against
             `project or cwd()` — so before v0.2.95 a login-started gateway
             answered every vendor request "no key found" while the identical
             key resolved in milliseconds from any project's cwd (measured on
             Linux 2026-09-10; the cwd rule is the same on macOS). Resolving
             at RUNTIME rather than baking a path here is what makes that fix
             survive a MOVED install. Set this only to point the gateway at a
             specific project's own key;
             `vco_lib.boot_service.resolve_gateway_secret_project` never
             derives a value for it, and preserves one you set across every
             re-render. -->
        <key>VCT_MODEL_GATEWAY_SECRET_PROJECT</key>
        <string>{{SECRET_PROJECT}}</string>
    </dict>

    <key>StandardOutPath</key>
    <string>{{BOOT_LOG_FILE}}</string>
    <key>StandardErrorPath</key>
    <string>{{BOOT_LOG_FILE}}</string>

    <!-- Background, not Interactive: the gateway serves HTTP on loopback
         and has no UI, so it should not compete with foreground apps for
         scheduling priority. -->
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
