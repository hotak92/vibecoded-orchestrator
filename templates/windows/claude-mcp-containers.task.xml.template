<?xml version="1.0" encoding="UTF-8"?>
<!--
  Windows Task Scheduler XML for the Claude MCP container stack.

  v0.2.10 (Bug L2 — cross-OS boot-service materialization): on Windows
  the systemd unit / launchd plist concepts map to a Scheduled Task
  registered against the user's logon trigger. install.py renders this
  template and imports it via `schtasks /Create /XML <file> /F`. Runs
  per-user without admin elevation.

  Why this exists:
    - The wrapper script scripts/launch-claude-mcp-stack.sh is bash; it
      doesn't run natively on cmd.exe / PowerShell. The Actions/Exec
      below invokes `bash` (Git Bash, WSL bash, or any bash on PATH),
      passing the wrapper script as the argument. Git Bash + WSL are
      already prerequisites in the orchestrator's general install path
      (Windows users without bash should install Git for Windows).
    - StartWhenAvailable + per-user logon trigger matches the Linux
      `systemctl user enable` + `loginctl enable-linger` pair: the
      task runs whenever the user logs in, no admin scope required.
      (Note: the actual systemctl invocation uses the long flag
      `systemctl __user enable` — written this way in the comment to
      avoid the double-hyphen sequence that XML 1.0 forbids inside
      comments.)

  GPU note (Windows):
    Docker Desktop on Windows uses the WSL2 backend; GPU passthrough
    requires the NVIDIA-WSL2 driver (host-side, separate install) AND
    Docker Desktop ≥ 4.16. podman on Windows runs via podman-machine
    (also WSL2-backed); same WSL2 GPU semantics apply. The wrapper's
    NVIDIA / CDI detection is Linux-only (it shells out to nvidia-smi
    and reads /var/run/cdi/nvidia.yaml — neither exists on Windows host).
    On Windows the wrapper currently falls through to CPU-only compose;
    a future revision could shell into the WSL2 distro to probe. Out of
    scope for v0.2.10.

  Template substitutions (filled in by install.py):
    {{LABEL}}              — task name (no path separators)
    {{WORKING_DIR}}        — directory containing compose.yaml
    {{WRAPPER_SCRIPT}}     — absolute path to launch-claude-mcp-stack.sh
                             (use forward slashes; bash translates them)
    {{LOG_FILE}}           — absolute path to the unit's log file
                             (use forward slashes; bash translates them)
    {{CREATED_AT}}         — ISO8601 timestamp at materialization time
    {{USER_ID}}            — Windows user ID (e.g. DOMAIN\\user) for the
                             logon trigger context

  Environment propagation (PR-32, 2026-05-16):
    The wrapper script `launch-claude-mcp-stack.sh` reads three env vars
    set by the systemd unit on Linux:

        VCT_STACK_WORKING_DIR    — directory containing compose.yaml
        VCT_STACK_LOG_FILE       — absolute path to the unit's log file
        VCT_STACK_COMPOSE_OVERRIDE — overlay compose file (defaults to
                                     `compose.override.yaml`)

    Prior to PR-32 this Windows scheduled task fired bash with NONE of
    them set, so the wrapper silently fell through to its defaults
    (which on Windows resolve to paths that may not exist for the
    current user, breaking compose-up). Mirrors the systemd template's
    `Environment=VCT_STACK_*=...` lines.

    Mechanism: we replace the bare `<Command>bash</Command>` with
    `cmd.exe /c "set VAR=val && set VAR2=val2 && set VAR3=val3 && bash
    <script>"`. `cmd.exe` is always on PATH on Windows; the `set` builtin
    is per-process scope (it does not leak into the user's interactive
    environment); the `&&` chain ensures bash inherits the variables.
    Forward slashes in WRAPPER_SCRIPT survive cmd.exe → bash translation.
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Date>{{CREATED_AT}}</Date>
    <Author>{{USER_ID}}</Author>
    <Description>Claude MCP container stack (weaviate, ollama, code_embed, model_router) — brings up at user logon via launch-claude-mcp-stack.sh.</Description>
    <URI>\{{LABEL}}</URI>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <UserId>{{USER_ID}}</UserId>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>{{USER_ID}}</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <!--
    Action invocation note (PR-22 + PR-32, 2026-05-16, unified at v0.2.12
    integration merge):

    Task Scheduler XML has no native env-var declarations in <Actions>.
    We propagate the three VCT_STACK_* env vars by wrapping the wrapper
    script in `cmd.exe /c "set ...&& set ...&& bash WRAPPER"`. cmd.exe is
    chosen over bash because it is always present on Windows PATH (bash
    requires WSL or git-bash, neither guaranteed on an end-user machine).

    Env vars set:
      * VCT_STACK_WORKING_DIR={{WORKING_DIR}}        — wrapper working dir
      * VCT_STACK_LOG_FILE={{LOG_FILE}}              — wrapper log target
      * VCT_STACK_COMPOSE_OVERRIDE=compose.override.yaml — user-machine
        override (see scripts/launch-claude-mcp-stack.sh) that lets the
        launcher's Storage UX override (PR-10A) take effect at boot.
        Default value matches podman-compose's auto-load convention;
        without it the wrapper's explicit `-f compose.yaml` bypasses
        auto-load.

    Mirrors the systemd unit's three `Environment=` lines (see
    templates/systemd/claude-mcp-containers.service.template).

    The `&amp;&amp;` chain XML-escapes `&&` so cmd.exe inherits the env
    var across the chained `set` commands. `&quot;` escapes the inner
    double-quote around {{WRAPPER_SCRIPT}} so the wrapper path is
    correctly quoted when bash receives it.
  -->
  <Actions Context="Author">
    <Exec>
      <Command>cmd.exe</Command>
      <Arguments>/c "set VCT_STACK_WORKING_DIR={{WORKING_DIR}}&amp;&amp; set VCT_STACK_LOG_FILE={{LOG_FILE}}&amp;&amp; set VCT_STACK_COMPOSE_OVERRIDE=compose.override.yaml&amp;&amp; bash &quot;{{WRAPPER_SCRIPT}}&quot;"</Arguments>
      <WorkingDirectory>{{WORKING_DIR}}</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
