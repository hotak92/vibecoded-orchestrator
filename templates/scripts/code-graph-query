#!/usr/bin/env bash
# Code Graph Query wrapper - Semantic and structural code search
# Usage: code-graph-query search "query"
#        code-graph-query similar "full.function.name"
#        code-graph-query structure dependencies "path/to/module.py"
#
# Exit codes: whatever `query_code_graph.py` exits; 1 = REFUSAL - no Python
# environment with the dependencies this wrapper needs (wrapper-only).
#
# v0.2.37 (Gap 6c): sets PYTHONPATH so `query_code_graph.py` can import the
# `claude_mcp_servers` package.
#
# Bug history:
#   - 2026-05-27 (post-update validation): query_code_graph.py crashed
#     with `ModuleNotFoundError: No module named 'weaviate_mcp'` because
#     the wrapper activated a venv but never put claude_mcp_servers/ on
#     PYTHONPATH. The launcher exports VCT_ORCHESTRATOR_ROOT for this
#     purpose; the OSS install path didn't have it.
#   - v0.2.94: the venv ladder here was WEAKER than `kg-sync`'s (no
#     `$VCT_VENV` tier, no `.claude/env` tier, no VCO-clone discriminator),
#     gated on `weaviate` alone - which has not been enough since
#     `query_code_graph.py` began importing `vco_lib` at module scope - and
#     then fell through to a bare `python3`. A shipped component does not get
#     a silent fallback (standing rule). Ladder + refusal now come from the
#     ONE home every KG/code-graph wrapper shares.
#
# PARITY: this file and `code-graph-query.ps1` must stay in lockstep (same
# tiers, same gate, same refusal text, same PYTHONPATH, same forwarding).

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# The probe a candidate interpreter must pass, verbatim as it is executed.
# `query_code_graph.py` imports `vco_lib.codegraph_references` and
# `vco_lib.paths` at MODULE scope (unguarded); `weaviate` and
# `weaviate_mcp.server` are module-scope too, inside `try:` blocks that print
# and CONTINUE - so their absence produces a degraded run that reports "no
# matches" instead of failing, which is precisely the verdict the rule says a
# gate must protect. Gating on `weaviate` alone let both through.
LADDER_IMPORT="import weaviate, weaviate_mcp, vco_lib"

# Resolve the orchestrator root for PYTHONPATH BEFORE probing. Prefer
# $VCT_ORCHESTRATOR_ROOT (canonical, written into .claude/env by
# install-bundle as of v0.2.37 Gap 6a), fall back to $VCT_INSTALL_ROOT
# (legacy alias), then to script-relative paths.
#
# v0.2.94: this block used to run AFTER the venv probe, so the probe answered
# a question the script never faces - `weaviate_mcp` is importable via this
# PYTHONPATH on installs where it is not pip-installed. Probing with the same
# environment the script will run under is the only honest order.
ORCH_ROOT=""
if [ -n "${VCT_ORCHESTRATOR_ROOT:-}" ] && [ -d "${VCT_ORCHESTRATOR_ROOT}/claude_mcp_servers" ]; then
    ORCH_ROOT="${VCT_ORCHESTRATOR_ROOT}"
elif [ -n "${VCT_INSTALL_ROOT:-}" ] && [ -d "${VCT_INSTALL_ROOT}/claude_mcp_servers" ]; then
    ORCH_ROOT="${VCT_INSTALL_ROOT}"
elif [ -d "$SCRIPT_DIR/../../claude_mcp_servers" ]; then
    ORCH_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
fi

if [ -n "$ORCH_ROOT" ]; then
    export PYTHONPATH="$ORCH_ROOT/claude_mcp_servers:${PYTHONPATH:-}"
fi

# The ladder lives in ONE home, shipped beside this wrapper. A missing lib is
# a broken install, not a reason to fall back to a bare interpreter.
if [ ! -r "$SCRIPT_DIR/vct_venv_ladder.sh" ]; then
    echo "code-graph-query: ERROR - missing $SCRIPT_DIR/vct_venv_ladder.sh" >&2
    echo "code-graph-query: (broken install - re-run the orchestrator install)" >&2
    echo "⚠️  code-graph-query did NOT run (exit 1): its shared venv ladder is missing. See the lines above." >&2
    exit 1
fi
# shellcheck source=vct_venv_ladder.sh
. "$SCRIPT_DIR/vct_venv_ladder.sh"

vct_venv_ladder_resolve "$SCRIPT_DIR" "$LADDER_IMPORT"

# NO BARE `python3` FALLBACK - see the header. PARITY: the .ps1 sibling
# refuses identically.
if [ -z "$LADDER_PYTHON" ]; then
    vct_venv_ladder_refusal "code-graph-query" "$LADDER_IMPORT" "$SCRIPT_DIR"
    {
        echo "code-graph-query: Refusing to run with an unqualified interpreter -"
        echo "code-graph-query: a query that cannot reach the code graph must"
        echo "code-graph-query: never report 'no matches'."
        echo "code-graph-query: (exit 1 = did not run)"
    } >&2
    vct_venv_ladder_refusal_summary "code-graph-query" 1
    exit 1
fi

exec "$LADDER_PYTHON" "$SCRIPT_DIR/query_code_graph.py" "$@"
