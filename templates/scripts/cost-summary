#!/usr/bin/env bash
# cost-summary — back-compat shim for the portable cost-summary.py
# Usage: cost-summary [--days N] [--session SESSION_ID]
#
# v0.2.54 Track G (G-3): the summary logic moved to cost-summary.py so the
# same entry point works on Linux / macOS / Windows (stdlib-only Python).
# This wrapper survives for muscle memory + existing docs; it just execs
# the .py with the same args. The old heredoc version also had a broken
# argument path (read $1/$2 but consumed a never-exported DAYS env var) —
# delegating to argparse fixes `--days N` / `--session ID` for free.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

PYTHON="$(command -v python3 || command -v python)"
if [[ -z "$PYTHON" ]]; then
    echo "cost-summary: python3 not found on PATH" >&2
    exit 1
fi

exec "$PYTHON" "$SCRIPT_DIR/cost-summary.py" "$@"
