#!/usr/bin/env bash
# Code Graph Analyzer wrapper - AST-based code entity extraction
# Usage: code-graph-analyze /path/to/repo [OPTIONS]
#
# Exit codes: whatever `analyze_code_graph.py` exits; 1 = REFUSAL - no Python
# environment with the dependencies this wrapper needs (wrapper-only).
#
# Bug history (the ladder's, not the analyzer's):
#   - 2026-04-28: example project codegraph build failed with
#     "weaviate-client not installed" because example/Code had neither
#     .venv nor claude_mcp_servers/.venv → added VCT_INSTALL_ROOT fallbacks.
#   - 2026-05-07: a user project's codegraph build failed with
#     `ModuleNotFoundError: weaviate` because the project HAS its own
#     `.venv/` (used by its own runtime) which the script activated before
#     getting to VCT_INSTALL_ROOT → reorder + validate-has-weaviate-client.
#   - 2026-06-27 (RT-4): a project's INSTALLED shim hardcoded the removed
#     legacy `.../Claude/claude_mcp_servers/.venv/bin/python` and exited 127
#     → added the `$VCT_VENV` tier, which also accepts a DIRECT interpreter
#     path so a stale default is always recoverable by one override.
#   - v0.2.94: the tiers above were maintained HERE, a fourth copy of the
#     same decision, and this wrapper still fell through to a bare `python3`
#     when nothing qualified — running the analyzer against an interpreter
#     that cannot import its deps, which fails one layer deeper with a
#     message about the wrong thing. A shipped component does not get a
#     silent fallback (standing rule). Ladder + refusal now come from the ONE
#     home every KG/code-graph wrapper shares; the `$VCT_VENV`-as-interpreter
#     tier moved there with them, so nothing is lost.
#
# PARITY: this file and `code-graph-analyze.ps1` must stay in lockstep (same
# tiers, same gate, same refusal text, same forwarding).

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# The probe a candidate interpreter must pass, verbatim as it is executed.
# `analyze_code_graph.py` imports `vco_lib.embedding_service` at MODULE scope
# (unguarded, v0.2.75+); `weaviate` and `weaviate_mcp.code_truncation` /
# `.code_ranking` are module-scope inside `try:` blocks that CONTINUE - an
# analysis that cannot reach them writes nothing and looks like a build that
# produced nothing, which is the verdict the probe rule exists to protect.
# Gating on `weaviate` alone - the pre-v0.2.94 gate - let all of that through.
LADDER_IMPORT="import weaviate, weaviate_mcp, vco_lib"

# The ladder lives in ONE home, shipped beside this wrapper. A missing lib is
# a broken install, not a reason to fall back to a bare interpreter.
if [ ! -r "$SCRIPT_DIR/vct_venv_ladder.sh" ]; then
    echo "code-graph-analyze: ERROR - missing $SCRIPT_DIR/vct_venv_ladder.sh" >&2
    echo "code-graph-analyze: (broken install - re-run the orchestrator install)" >&2
    echo "⚠️  code-graph-analyze did NOT run (exit 1): its shared venv ladder is missing. See the lines above." >&2
    exit 1
fi
# shellcheck source=vct_venv_ladder.sh
. "$SCRIPT_DIR/vct_venv_ladder.sh"

vct_venv_ladder_resolve "$SCRIPT_DIR" "$LADDER_IMPORT"

# NO BARE `python3` FALLBACK - see the header. PARITY: the .ps1 sibling
# refuses identically.
if [ -z "$LADDER_PYTHON" ]; then
    vct_venv_ladder_refusal "code-graph-analyze" "$LADDER_IMPORT" "$SCRIPT_DIR"
    {
        echo "code-graph-analyze: Refusing to run with an unqualified interpreter -"
        echo "code-graph-analyze: an analysis that cannot write the collection must"
        echo "code-graph-analyze: never look like a build that produced nothing."
        echo "code-graph-analyze: (exit 1 = did not run)"
    } >&2
    vct_venv_ladder_refusal_summary "code-graph-analyze" 1
    exit 1
fi

exec "$LADDER_PYTHON" "$SCRIPT_DIR/analyze_code_graph.py" "$@"
