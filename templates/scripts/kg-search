#!/bin/bash
# Wrapper script for search_knowledge.py.
#
# Exit codes: whatever `search_knowledge.py` exits; 1 = REFUSAL - no Python
# environment with the dependency this wrapper needs (wrapper-only).
#
# v0.2.94: this wrapper resolved its interpreter through a WEAKER ladder than
# `kg-sync`'s (no `$VCT_VENV` tier, no `.claude/env` tier, no VCO-clone
# discriminator) and then fell through to a bare `python` when nothing
# qualified - so on a user project it ran whatever interpreter was first on
# PATH and died inside the script with a ModuleNotFoundError naming the wrong
# problem. A shipped component does not get a silent fallback (standing rule).
# Ladder + refusal now come from the ONE home every KG wrapper shares.
#
# PARITY: this file and `kg-search.ps1` must stay in lockstep (same tiers,
# same gate, same refusal text, same forwarding).

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# The probe a candidate interpreter must pass, verbatim as it is executed.
# The rule (see `vct_venv_ladder.sh`): name what the script needs to reach a
# CORRECT VERDICT. `weaviate` is a module-scope import; `vco_lib` is
# function-local but verdict-critical - without it `_get_target_vector_slot`
# falls back to the pre-v0.2.18 `ollama_embed` hardcode and searches a slot a
# qwen3/arctic install never populated, which answers "no results" rather than
# failing. `weaviate_mcp` is NOT named: its only use here is optional query
# telemetry, whose absence changes nothing a caller reads.
LADDER_IMPORT="import weaviate, vco_lib"

# The ladder lives in ONE home, shipped beside this wrapper. A missing lib is
# a broken install, not a reason to fall back to a bare interpreter.
if [ ! -r "$SCRIPT_DIR/vct_venv_ladder.sh" ]; then
    echo "kg-search: ERROR - missing $SCRIPT_DIR/vct_venv_ladder.sh" >&2
    echo "kg-search: (broken install - re-run the orchestrator install)" >&2
    echo "⚠️  kg-search did NOT run (exit 1): its shared venv ladder is missing. See the lines above." >&2
    exit 1
fi
# shellcheck source=vct_venv_ladder.sh
. "$SCRIPT_DIR/vct_venv_ladder.sh"

vct_venv_ladder_resolve "$SCRIPT_DIR" "$LADDER_IMPORT"

# NO BARE `python` FALLBACK - see the header. PARITY: the .ps1 sibling refuses
# identically.
if [ -z "$LADDER_PYTHON" ]; then
    vct_venv_ladder_refusal "kg-search" "$LADDER_IMPORT" "$SCRIPT_DIR"
    {
        echo "kg-search: Refusing to run with an unqualified interpreter - a"
        echo "kg-search: search that cannot reach the collection must never"
        echo "kg-search: report 'no results'."
        echo "kg-search: (exit 1 = did not run)"
    } >&2
    vct_venv_ladder_refusal_summary "kg-search" 1
    exit 1
fi

exec "$LADDER_PYTHON" "$SCRIPT_DIR/search_knowledge.py" "$@"
