#!/bin/bash
# Knowledge Graph Vocabulary Migration
#
# Migrate knowledge nodes to vocabulary standard (VOCABULARY.md, TAG_HIERARCHY.md)
#
# Usage:
#   .claude/scripts/kg-migrate --check              # Check all nodes, report issues
#   .claude/scripts/kg-migrate --fix                # Apply automatic fixes
#   .claude/scripts/kg-migrate --interactive        # Interactive mode with prompts
#   .claude/scripts/kg-migrate --file <path>        # Check/fix single file
#
# Exit codes: whatever `migrate_to_vocabulary.py` exits; 1 = REFUSAL - no
# Python environment with the dependencies this wrapper needs (wrapper-only).
#
# v0.2.94: this wrapper resolved its interpreter through a WEAKER ladder than
# `kg-sync`'s (no `$VCT_VENV` tier, no `.claude/env` tier, no VCO-clone
# discriminator), gated on `weaviate` alone - which is NOT enough for this
# script - and then fell through to a bare `python`. A shipped component does
# not get a silent fallback (standing rule). Ladder + refusal now come from
# the ONE home every KG wrapper shares.
#
# PARITY: this file and `kg-migrate.ps1` must stay in lockstep (same tiers,
# same gate, same refusal text, same forwarding).

# `set -e` as shipped before v0.2.94: a refactor may not change this
# file's failure posture as a side effect. The shared ladder is
# `set -e`-safe (its `[ … ] && …` guards are non-final members of AND
# lists, which bash exempts, and `vct_venv_ladder_resolve` ends in an
# `if` that returns 0 on the miss path) — pinned by
# tests/test_v0294_wrapper_venv_ladder_parity.py.
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# The probe a candidate interpreter must pass, verbatim as it is executed.
# `migrate_to_vocabulary.py` imports `sync_knowledge_graph` AT MODULE SCOPE,
# and that module hard-imports `weaviate_mcp.chunking` plus several `vco_lib`
# modules. So a venv with `weaviate` alone - the pre-v0.2.94 gate - passes the
# check and then dies at import time inside the script.
LADDER_IMPORT="import weaviate, weaviate_mcp, vco_lib"

# The ladder lives in ONE home, shipped beside this wrapper. A missing lib is
# a broken install, not a reason to fall back to a bare interpreter.
if [ ! -r "$SCRIPT_DIR/vct_venv_ladder.sh" ]; then
    echo "kg-migrate: ERROR - missing $SCRIPT_DIR/vct_venv_ladder.sh" >&2
    echo "kg-migrate: (broken install - re-run the orchestrator install)" >&2
    echo "⚠️  kg-migrate did NOT run (exit 1): its shared venv ladder is missing. See the lines above." >&2
    exit 1
fi
# shellcheck source=vct_venv_ladder.sh
. "$SCRIPT_DIR/vct_venv_ladder.sh"

vct_venv_ladder_resolve "$SCRIPT_DIR" "$LADDER_IMPORT"

# NO BARE `python` FALLBACK - see the header. PARITY: the .ps1 sibling refuses
# identically.
if [ -z "$LADDER_PYTHON" ]; then
    vct_venv_ladder_refusal "kg-migrate" "$LADDER_IMPORT" "$SCRIPT_DIR"
    {
        echo "kg-migrate: Refusing to run with an unqualified interpreter - a"
        echo "kg-migrate: migration that cannot validate against the vocabulary"
        echo "kg-migrate: must never report 'no issues', let alone --fix."
        echo "kg-migrate: (exit 1 = did not run)"
    } >&2
    vct_venv_ladder_refusal_summary "kg-migrate" 1
    exit 1
fi

exec "$LADDER_PYTHON" "$SCRIPT_DIR/migrate_to_vocabulary.py" "$@"
