#!/bin/bash
# Wrapper script for sync_knowledge_graph.py with automatic venv activation.
#
# v0.2.37 (Gap 6b): backports the validate-has-weaviate-client pattern
# from `code-graph-analyze`. Pre-v0.2.37 this wrapper only probed
# `$PROJECT_ROOT/.venv` + `$PROJECT_ROOT/claude_mcp_servers/.venv`, both
# of which are absent in a fresh OSS install where the bundle lands in a
# user project that has its own (unrelated) `.venv`. The canonical
# venv-with-weaviate-client lives in `$VCT_INSTALL_ROOT/.venv` (set by
# the launcher) or at script-relative paths inside the orchestrator
# clone. We also validate each candidate has `weaviate` importable so an
# unrelated project venv at SCRIPT_DIR/../../.venv doesn't get picked up
# by accident.
#
# v0.2.49 Bug K: the v0.2.37 validator only checked `import weaviate`
# (the upstream client lib). That let unrelated project venvs through
# that had pip-installed weaviate-client themselves but lacked the
# editable `weaviate_mcp` package (installed by install.py A1, v0.2.38
# — see sync_knowledge_graph.py line 52:
# `from weaviate_mcp.chunking import TokenCounter, Chunker`). The post-
# fix validator gates on BOTH imports in a single subprocess. The
# wrapper also gained Windows-shape python detection
# (`$v/Scripts/python.exe` under Git Bash / WSL2) and stopped relying
# on `source bin/activate` (which doesn't exist in Windows venv
# layouts) — we now invoke the venv's python binary directly,
# exporting VIRTUAL_ENV so subprocesses still see the venv as active.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Validate a venv has BOTH `weaviate` (the upstream client) AND
# `weaviate_mcp` (our internal editable module installed by install.py
# A1, v0.2.38) importable. v0.2.49 Bug K: pre-fix this only checked
# `weaviate` — which let unrelated project venvs through that had pip-
# installed the upstream lib but lacked weaviate_mcp, causing
# sync_knowledge_graph.py to crash at `from weaviate_mcp.chunking
# import Chunker`. Gate on both imports so the picker rejects venvs
# that can't actually run the script.
venv_has_kg_deps() {
    local v="$1"
    local py=""
    if [ -x "$v/bin/python" ]; then py="$v/bin/python"
    elif [ -x "$v/bin/python3" ]; then py="$v/bin/python3"
    elif [ -x "$v/Scripts/python.exe" ]; then py="$v/Scripts/python.exe"  # Windows (Git Bash / WSL2)
    elif [ -x "$v/Scripts/python3.exe" ]; then py="$v/Scripts/python3.exe"
    else return 1
    fi
    "$py" -c "import weaviate, weaviate_mcp" 2>/dev/null
}

# Probe candidate venvs. Launcher-provided $VCT_INSTALL_ROOT canonical
# install-root takes precedence; script-relative paths are fallbacks for
# direct CLI use inside the orchestrator clone.
CANDIDATES=(
    "${VCT_INSTALL_ROOT:-}/.venv"                      # launcher-provided install root (canonical)
    "${VCT_INSTALL_ROOT:-}/claude_mcp_servers/.venv"   # launcher-provided legacy path
    "$SCRIPT_DIR/../../.venv"                          # vco OSS install root (script in orch clone)
    "$SCRIPT_DIR/../../claude_mcp_servers/.venv"       # legacy Claude orch (script in orch clone)
)

VENV_PATH=""
for c in "${CANDIDATES[@]}"; do
    [ -z "$c" ] && continue
    [ "$c" = "/.venv" ] && continue                    # empty VCT_INSTALL_ROOT → skip
    [ "$c" = "/claude_mcp_servers/.venv" ] && continue
    if venv_has_kg_deps "$c"; then
        VENV_PATH="$c"
        break
    fi
done

# v0.2.49 Bug K: invoke the venv's python binary directly rather than
# `source bin/activate`. The source-then-python pattern was POSIX-only
# — Windows venvs (incl. those used under Git Bash / WSL2) don't have
# a `bin/activate` script. Direct invocation works on every OS, and
# exporting VIRTUAL_ENV keeps any spawned subprocesses informed that a
# venv is active (some libraries probe $VIRTUAL_ENV directly).
if [ -n "$VENV_PATH" ]; then
    export VIRTUAL_ENV="$VENV_PATH"
    if [ -x "$VENV_PATH/bin/python" ]; then
        VENV_PYTHON="$VENV_PATH/bin/python"
    elif [ -x "$VENV_PATH/Scripts/python.exe" ]; then
        VENV_PYTHON="$VENV_PATH/Scripts/python.exe"
    elif [ -x "$VENV_PATH/bin/python3" ]; then
        VENV_PYTHON="$VENV_PATH/bin/python3"
    elif [ -x "$VENV_PATH/Scripts/python3.exe" ]; then
        VENV_PYTHON="$VENV_PATH/Scripts/python3.exe"
    else
        echo "kg-sync: WARNING: VENV_PATH=$VENV_PATH has no python binary at conventional paths" >&2
        VENV_PYTHON="python3"
    fi
else
    VENV_PYTHON="python3"
fi

"$VENV_PYTHON" "$SCRIPT_DIR/sync_knowledge_graph.py" "$@"
