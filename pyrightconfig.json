{
    // v0.2.54 Track E amendment: scope the CI pyright gate (ci.yml
    // `python-typecheck` job) to the surfaces where the gate is REAL —
    // zero errors today, so any new error is a regression and fails
    // the build. Running pyright repo-wide reported 813 pre-existing
    // errors across 429 files (tests/, templates/, scripts/, launcher
    // frontend is covered by svelte-check), which is why the old job
    // needed `|| true` and was decorative.
    //
    // If your PR adds a NEW type error inside this scope: fix it, or
    // annotate the single line with `# pyright: ignore[<rule>]` plus a
    // rationale comment. Do NOT re-add `|| true` in ci.yml and do NOT
    // grow the exclude list without logging the error count + a
    // CHANGELOG backlog entry, as done for the two exclusions below.
    // v0.2.92: `claude_mcp_servers/model_router` joins the gate. It is new
    // this cycle and it typechecks 0/0 today, so it lands with no cleanup
    // debt — which is the ONLY moment adding a surface is free. A package
    // that ships without being in `include` is a package whose first type
    // error arrives in the field.
    //
    // v0.2.95 (review MINOR-5 — "the scope is an accretion, not a decision"):
    // two omissions are now DECISIONS, recorded here rather than left to be
    // re-derived.
    //   * `.github/scripts` JOINS: it is gate code — the hook-parity gate
    //     runs from there — and it measured 0 errors / 0 warnings on
    //     2026-09-16, so it lands free. Gate code that is itself ungated is
    //     how an F841 sat in it unnoticed until the v0.2.95 ruff sweep.
    //   * `VCThelpers` STAYS OUT, with the cost measured: 5 errors on
    //     2026-09-16, ALL of them `reportAttributeAccessIssue` on `winreg`
    //     attributes in `license/validator.py::_read_windows_machine_guid`
    //     (lines 238-244). They are an artefact of running pyright on Linux,
    //     where the `winreg` stub is attribute-less; the code itself is
    //     correctly guarded by `try: import winreg / except ImportError`.
    //     The honest fixes are a per-line `# pyright: ignore` litter across
    //     shipped license code or a platform-scoped config, and neither is
    //     worth doing blind — so it is BACKLOGGED (CHANGELOG, v0.2.95) with
    //     the count above, per this file's own exclusion contract. ruff DOES
    //     gate it (ci.yml `python-lint`), so it is not unlinted.
    "include": [
        "vco_lib",
        "claude_mcp_servers/weaviate_mcp",
        "claude_mcp_servers/search_mcp",
        "claude_mcp_servers/model_router",
        ".github/scripts"
    ],
    "exclude": [
        "**/.venv",
        "**/node_modules",
        "**/target",
        "**/dist",
        ".claude/worktrees",
        // Backlog (v0.2.55, see CHANGELOG): 93 pre-existing errors,
        // dominated by reportArgumentType friction against
        // weaviate-client v4 stubs. Gate it after that cleanup.
        "claude_mcp_servers/weaviate_mcp/server.py"
        // NOTE: install.py (34 pre-existing errors, 26k lines) is a
        // second backlog item — it is simply NOT in `include` above,
        // so it needs no exclude entry. Add it to `include` once the
        // v0.2.55 backlog clears it.
    ],
    "pythonVersion": "3.12",
    // v0.2.92: unused-import ratchet ON. The 21-violation backlog this
    // surfaced was cleared (11 dead imports deleted; 10 deliberate
    // re-exports / importability probes kept with per-line
    // `# pyright: ignore[reportUnusedImport]` + reason). Any new unused
    // import now fails the gate.
    "reportUnusedImport": "error"
}
