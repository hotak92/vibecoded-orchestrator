#!/bin/bash
# VCT wrapper around the Claude Code CLI.
#
# Auto-sources `.claude/env` from the current working directory before
# exec'ing the real `claude` binary. The env file is generated by the
# VCT Launcher when a project is created (see `write_project_env_files`
# in launcher/src-tauri/src/commands/projects_v2.rs) and contains the
# per-project KG_COLLECTION, PROJECT_NAME, etc. — so the CLI sees the
# same workspace-scoped routing that VS Code users get via
# `.vscode/settings.json`'s `claude-code.env` block.
#
# Install: copy this file to a directory in $PATH BEFORE the directory
# containing the real claude binary, OR alias `claude` to it:
#
#   alias claude='/path/to/vibecoded-orchestrator/tools/claude'
#
# If you prefer direnv, see docs/CLAUDE_CODE_COMPATIBILITY.md for an
# alternative `.envrc` approach.

set -e

# Source per-project env if present. `set -a` exports every variable
# defined while it's active, so the env file can use plain assignments
# OR explicit `export` lines.
if [[ -f "$PWD/.claude/env" ]]; then
    set -a
    # shellcheck source=/dev/null
    source "$PWD/.claude/env"
    set +a
fi

# Find the real claude binary, skipping ourselves so we don't recurse.
SELF="$(readlink -f "$0" 2>/dev/null || realpath "$0")"
REAL_CLAUDE=""
IFS=':' read -ra DIRS <<< "$PATH"
for dir in "${DIRS[@]}"; do
    candidate="$dir/claude"
    if [[ -x "$candidate" ]]; then
        resolved="$(readlink -f "$candidate" 2>/dev/null || realpath "$candidate" 2>/dev/null || echo "$candidate")"
        if [[ "$resolved" != "$SELF" ]]; then
            REAL_CLAUDE="$candidate"
            break
        fi
    fi
done

if [[ -z "$REAL_CLAUDE" ]]; then
    echo "vct-claude: could not locate a real 'claude' binary on PATH (excluding this wrapper)." >&2
    echo "  Install Claude Code from https://docs.anthropic.com/en/docs/claude-code first." >&2
    exit 127
fi

exec "$REAL_CLAUDE" "$@"
