#!/usr/bin/env bash
# Git credential helper — reads from ~/.vct-secrets/shared/github_pat
# (or project-scoped override at ~/.vct-secrets/projects/<name>/github_pat).
# Only responds to `get` (we never let git rewrite secrets).
#
# Registered via: git config --global credential.https://github.com.helper '!<this-script>'
set -euo pipefail

VCT_DIR="${VCT_SECRETS_DIR:-$HOME/.vct-secrets}"
SHARED_FILE="$VCT_DIR/shared/github_pat"

op="${1:-}"
[[ "$op" != "get" ]] && exit 0

declare -A q
while IFS='=' read -r k v; do
  [[ -z "$k" ]] && break
  q["$k"]="$v"
done

# Only serve github.com
[[ "${q[host]:-}" != "github.com" ]] && exit 0

# Project-scoped override: if $PWD is under a known project root, try that first.
# Resolution order:
#   1. Walk up from $PWD looking for a `.vct-project` file (preferred — explicit).
#   2. Match against $VCT_PROJECT_ROOT_PATTERN (default: $HOME/dev),
#      treating the next path segment as the project name.
#      v0.2.54 S-6: default unified on $HOME/dev (docs previously said
#      $HOME/dev while the script shipped a different machine-specific
#      default). Set VCT_PROJECT_ROOT_PATTERN if your projects live
#      elsewhere, or drop a .vct-project marker file (preferred).
project_secret=""
project=""
# E-5: track HOW the project name was derived so we can warn when a
# project-scoped PAT is served via the (unverified) prefix fallback rather
# than an explicit .vct-project marker. Values: "marker" | "prefix" | "".
project_origin=""

# 1. Walk up from $PWD for a .vct-project marker file.
cur="$PWD"
while [[ "$cur" != "/" && -n "$cur" ]]; do
    if [[ -f "$cur/.vct-project" ]]; then
        project=$(head -n1 "$cur/.vct-project" | tr -d '[:space:]')
        project_origin="marker"
        break
    fi
    cur=$(dirname "$cur")
done

# 2. Fallback: literal prefix match against $VCT_PROJECT_ROOT_PATTERN/<name>/...
#    (v0.2.54: was a regex match with an unused escape variable — paths with
#    regex metacharacters mis-matched; now a literal prefix strip.)
#    E-5: this path derives the project name from $PWD alone with NO
#    verification that it corresponds to the repo's actual remote/owner. It
#    can silently serve a DIFFERENT project's PAT (or fall through to the
#    shared PAT). We flag it as "prefix" so a provenance note fires below.
if [[ -z "$project" ]]; then
    pattern="${VCT_PROJECT_ROOT_PATTERN:-$HOME/dev}"
    pattern="${pattern%/}"
    if [[ "$PWD" == "$pattern"/* ]]; then
        rest="${PWD#"$pattern"/}"
        project="${rest%%/*}"
        project_origin="prefix"
    fi
fi

if [[ -n "$project" ]]; then
    project_dir="$VCT_DIR/projects/${project// /_}"
    candidate="$project_dir/github_pat"
    if [[ -f "$candidate" ]]; then
        project_secret="$candidate"
    fi
fi

# E-5 (optional remote-owner gate): when the project name came from the
# UNVERIFIED prefix fallback, cross-check the repo's push remote owner
# against the derived project name before trusting the project-scoped PAT.
# git feeds the target host/protocol on stdin but NOT the remote URL, so we
# read it from the repo we're standing in. This is best-effort: if there is
# no git remote (or git is unavailable) we do NOT block — we keep serving
# and rely on the provenance note. Gate is OFF unless the operator opts in
# with VCT_GIT_CREDENTIAL_OWNER_GATE=1 (avoids surprising existing setups).
if [[ -n "$project_secret" && "$project_origin" == "prefix" \
      && "${VCT_GIT_CREDENTIAL_OWNER_GATE:-}" == "1" ]]; then
    remote_url=$(git config --get remote.origin.url 2>/dev/null || true)
    if [[ -n "$remote_url" ]]; then
        # Extract the owner segment for github.com remotes:
        #   git@github.com:OWNER/repo.git  |  https://github.com/OWNER/repo(.git)
        owner=""
        case "$remote_url" in
            *github.com:*) owner="${remote_url#*github.com:}"; owner="${owner%%/*}" ;;
            *github.com/*) owner="${remote_url#*github.com/}"; owner="${owner%%/*}" ;;
        esac
        if [[ -n "$owner" && "${owner,,}" != "${project,,}" ]]; then
            echo "[git-credential-vct] prefix-derived project '${project}' does not match" \
                 "the repo's github.com owner '${owner}'; NOT serving the project-scoped" \
                 "PAT (owner-gate on). Add a .vct-project marker to resolve explicitly." >&2
            project_secret=""
        fi
    fi
fi

resolved_file="${project_secret:-$SHARED_FILE}"

# Safety: legacy fallback in case migration incomplete
if [[ ! -f "$resolved_file" ]] && [[ -f "$VCT_DIR/github_pat" ]]; then
    resolved_file="$VCT_DIR/github_pat"
fi

[[ ! -f "$resolved_file" ]] && exit 0

perms=$(stat -c %a "$resolved_file" 2>/dev/null || stat -f %Lp "$resolved_file" 2>/dev/null)
if [[ "$perms" != "600" && "$perms" != "400" ]]; then
    echo "[git-credential-vct] refusing to read $resolved_file (perms $perms, expected 600)" >&2
    exit 0
fi

tok=$(tr -d '[:space:]' < "$resolved_file")
[[ -z "$tok" ]] && exit 0

# E-5 provenance note: when the served PAT was selected via the UNVERIFIED
# prefix fallback (project name derived from $PWD, not from an explicit
# .vct-project marker), emit a one-line stderr note naming the KEY and the
# SCOPE it came from — so a wrong-PAT selection is observable instead of
# silent. The token VALUE is NEVER printed to stderr (only to stdout, per
# the git-credential protocol). Suppress with VCT_GIT_CREDENTIAL_QUIET=1.
if [[ "$project_origin" == "prefix" && "${VCT_GIT_CREDENTIAL_QUIET:-}" != "1" ]]; then
    if [[ -n "$project_secret" ]]; then
        scope_desc="project '${project}' (prefix-derived from \$PWD; unverified)"
    else
        scope_desc="shared (no project-scoped github_pat matched the prefix-derived project '${project}')"
    fi
    echo "[git-credential-vct] serving github_pat for github.com via ${scope_desc}." \
         "Add a .vct-project marker for explicit resolution." >&2
fi

# Username: prefer git's q[username], then $VCT_GIT_USERNAME env, else "git"
# (GitHub accepts any non-empty username when PAT is the password).
printf 'username=%s\n' "${q[username]:-${VCT_GIT_USERNAME:-git}}"
printf 'password=%s\n' "$tok"
printf '\n'
