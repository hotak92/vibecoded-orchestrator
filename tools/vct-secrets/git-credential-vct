#!/usr/bin/env bash
# Git credential helper — reads from ~/.vct-secrets/shared/github_pat
# (or project-scoped override at ~/.vct-secrets/projects/<name>/github_pat).
# Only responds to `get` (we never let git rewrite secrets).
#
# Registered via: git config --global credential.https://github.com.helper '!<this-script>'
set -euo pipefail

VCT_DIR="${VCT_SECRETS_DIR:-$HOME/.vct-secrets}"
SHARED_FILE="$VCT_DIR/shared/github_pat"

op="${1:-}"
[[ "$op" != "get" ]] && exit 0

declare -A q
while IFS='=' read -r k v; do
  [[ -z "$k" ]] && break
  q["$k"]="$v"
done

# Only serve github.com
[[ "${q[host]:-}" != "github.com" ]] && exit 0

# Project-scoped override: if $PWD is under a known project root, try that first.
# Resolution order:
#   1. Walk up from $PWD looking for a `.vct-project` file (preferred — explicit).
#   2. Match against $VCT_PROJECT_ROOT_PATTERN (default: $HOME/dev),
#      treating the next path segment as the project name.
#      v0.2.54 S-6: default unified on $HOME/dev (docs previously said
#      $HOME/dev while the script shipped a different machine-specific
#      default). Set VCT_PROJECT_ROOT_PATTERN if your projects live
#      elsewhere, or drop a .vct-project marker file (preferred).
project_secret=""
project=""

# 1. Walk up from $PWD for a .vct-project marker file.
cur="$PWD"
while [[ "$cur" != "/" && -n "$cur" ]]; do
    if [[ -f "$cur/.vct-project" ]]; then
        project=$(head -n1 "$cur/.vct-project" | tr -d '[:space:]')
        break
    fi
    cur=$(dirname "$cur")
done

# 2. Fallback: literal prefix match against $VCT_PROJECT_ROOT_PATTERN/<name>/...
#    (v0.2.54: was a regex match with an unused escape variable — paths with
#    regex metacharacters mis-matched; now a literal prefix strip.)
if [[ -z "$project" ]]; then
    pattern="${VCT_PROJECT_ROOT_PATTERN:-$HOME/dev}"
    pattern="${pattern%/}"
    if [[ "$PWD" == "$pattern"/* ]]; then
        rest="${PWD#"$pattern"/}"
        project="${rest%%/*}"
    fi
fi

if [[ -n "$project" ]]; then
    project_dir="$VCT_DIR/projects/${project// /_}"
    candidate="$project_dir/github_pat"
    if [[ -f "$candidate" ]]; then
        project_secret="$candidate"
    fi
fi

resolved_file="${project_secret:-$SHARED_FILE}"

# Safety: legacy fallback in case migration incomplete
if [[ ! -f "$resolved_file" ]] && [[ -f "$VCT_DIR/github_pat" ]]; then
    resolved_file="$VCT_DIR/github_pat"
fi

[[ ! -f "$resolved_file" ]] && exit 0

perms=$(stat -c %a "$resolved_file" 2>/dev/null || stat -f %Lp "$resolved_file" 2>/dev/null)
if [[ "$perms" != "600" && "$perms" != "400" ]]; then
    echo "[git-credential-vct] refusing to read $resolved_file (perms $perms, expected 600)" >&2
    exit 0
fi

tok=$(tr -d '[:space:]' < "$resolved_file")
[[ -z "$tok" ]] && exit 0

# Username: prefer git's q[username], then $VCT_GIT_USERNAME env, else "git"
# (GitHub accepts any non-empty username when PAT is the password).
printf 'username=%s\n' "${q[username]:-${VCT_GIT_USERNAME:-git}}"
printf 'password=%s\n' "$tok"
printf '\n'
