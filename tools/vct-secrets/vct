#!/usr/bin/env bash
# vct — VCT Secrets Primitive CLI (Phase 1, Bash)
# Per-project secret store with project-first resolution + audit log.
# Design: docs/VCT_SECRETS_PRIMITIVE.md (in the vibecoded-orchestrator repo)
#
# Root: $VCT_SECRETS_DIR (default: ~/.vct-secrets)
#   projects/<NAME>/<KEY>  — per-project secret files (chmod 600)
#   shared/<KEY>           — cross-project fallback
#   audit.log              — append-only JSON-lines log
#
# Safety: umask 077, no secrets on argv, no secrets in logs. The store itself
# never touches the network; the ONLY network access is a bounded, read-only,
# localhost-only vct-hub probe on a file-store MISS (v0.2.76 R4) purely to make
# the miss message honest — it never fetches or writes a value and soft-fails
# silently when the hub is absent/unreachable. v0.2.91: that probe may make ONE
# extra bounded request when a PROVABLY-stale $VCT_HUB_TOKEN was refused
# (401/403) and the on-disk hub.token differs — set VCT_HUB_TOKEN_STRICT=1 to
# disable. Still read-only, still localhost, still never a value in a log.

set -u
umask 077

# ---------- Configuration ----------
VCT_SECRETS_DIR="${VCT_SECRETS_DIR:-$HOME/.vct-secrets}"
AUDIT_LOG="$VCT_SECRETS_DIR/audit.log"
VERSION="0.1.0-phase1"

# Capability stamp — the guards THIS copy of the CLI actually implements.
#
# WHY a capability list and not a bumped VERSION: `vct` is deployed by COPY
# (the documented setup is "copy it from tools/vct-secrets/"), and nothing in
# install.py refreshes that copy — so a deployed CLI can be arbitrarily far
# behind the repo while still printing a plausible version string. A version
# number tells you what the author CLAIMED; this list tells you which guards
# are present in the bytes that are about to run. `vct version` prints it and
# `vct doctor` greps a second deployed copy for it (see
# _doctor_check_deployed_copy), which is how a stale deployment is DETECTED
# instead of silently trusted.
#
# Append a token when you add a guard; never remove one.
#   value-shape      — write-time blob/multi-line predicate (v0.2.80)
#   name-shape       — credential-shaped KEY/PROJECT name refusal
#   shared-scope     — `set --shared` writes the real shared namespace
#   symlink-self     — resolves its own symlink before locating lib/
VCT_GUARDS="value-shape name-shape shared-scope symlink-self"

# ---------- Shared secret-shape predicate (bash mirror of the Python SSOT) ----------
# tools/vct-secrets/lib/secret_shape.sh defines _is_single_line_secret() and
# _classify_secret_value(), the bash mirror of vco_lib/secret_value_shape.py
# (locked by tests/fixtures/secret_value_shape_parity.json). ONE copy, sourced
# by both this CLI and migrate-shared.sh (SHARED-CODE RULE — no duplication).
# The lib lives next to this script even when `vct` is deployed to
# ~/.vct-secrets/vct (install materialises the whole tools/vct-secrets tree).

# _vct_resolve_self_dir — echo the directory holding the REAL script file,
# following the script's own symlink chain first.
#
# WHY: `dirname "${BASH_SOURCE[0]}"` yields the SYMLINK's directory, not the
# target's. The documented way to put this CLI on PATH is a symlink (e.g.
# ~/.local/bin/vct -> <checkout>/tools/vct-secrets/vct), and under that setup
# the un-resolved form looked for ~/.local/bin/lib/secret_shape.sh, did not
# find it, and hard-exited "broken install" — i.e. the ONE delivery mechanism
# that cannot go stale was the one that could not start. Resolving the chain
# makes symlink deployment work, which is what lets a user point at the
# checkout instead of taking a copy that then rots.
#
# `readlink` WITHOUT -f on purpose: `readlink -f` is GNU-only (macOS ships the
# BSD one, which has no -f), and this CLI must run on Linux + macOS + WSL2.
# The loop is bounded at 16 hops so a symlink cycle terminates.
# CDPATH= prefixes the `cd` (neutralises a user CDPATH); not a var assignment.
# shellcheck disable=SC1007
_vct_resolve_self_dir() {
    local src="${BASH_SOURCE[0]:-$0}" dir="" hops=0
    while [ -L "$src" ] && [ "$hops" -lt 16 ]; do
        dir=$(CDPATH= cd -- "$(dirname -- "$src")" && pwd) || break
        src=$(readlink -- "$src") || break
        case "$src" in
            /*) ;;                 # absolute link target — use as-is
            *)  src="$dir/$src" ;; # relative link target — resolve against the link's dir
        esac
        hops=$((hops + 1))
    done
    CDPATH= cd -- "$(dirname -- "$src")" && pwd
}
_VCT_SELF_DIR=$(_vct_resolve_self_dir)
# BOTH shared predicate libs are REQUIRED:
#   lib/secret_shape.sh      — secret VALUE shape (line structure); mirror of
#                              vco_lib/secret_value_shape.py.
#   lib/credential_shapes.sh — credential SHAPE vocabulary, `argv_name`
#                              context; mirror of vco_lib/credential_shapes.py.
# Sourced through ONE loop so the broken-install message has a single home
# (SHARED-CODE RULE) and a third lib cannot later ship without the same guard.
# shellcheck source=lib/secret_shape.sh
# shellcheck source=lib/credential_shapes.sh
for _vct_lib in secret_shape.sh credential_shapes.sh; do
    if [ -r "$_VCT_SELF_DIR/lib/$_vct_lib" ]; then
        # shellcheck disable=SC1090
        . "$_VCT_SELF_DIR/lib/$_vct_lib"
    else
        # Loud-fail: a broken deployment missing a shared predicate must NOT
        # silently run unguarded (the write-time and name-shape guards are the
        # whole point). Name BOTH supported deployments — a partial copy of
        # just the `vct` file is the common way to land here.
        printf 'vct: error: shared predicate missing at %s/lib/%s — broken install.\n' \
            "$_VCT_SELF_DIR" "$_vct_lib" >&2
        printf 'vct: this CLI needs the whole tools/vct-secrets/ tree, not the single file. Either\n' >&2
        printf 'vct:   symlink it (preferred, never goes stale):  ln -sfn <checkout>/tools/vct-secrets/vct ~/.local/bin/vct\n' >&2
        printf 'vct:   or copy the tree:                          cp -a <checkout>/tools/vct-secrets/. ~/.vct-secrets/\n' >&2
        exit 1
    fi
done
unset _vct_lib

# Env vars to preserve into child when not --preserve-env.
# Covers locale, terminal, PATH, home — drops everything else.
PRESERVE_ENV_VARS=(PATH HOME USER LOGNAME TERM LANG SHELL PWD TMPDIR)

# ---------- Utility ----------
die() { printf 'vct: error: %s\n' "$*" >&2; exit 1; }
die_code() { local c=$1; shift; printf 'vct: error: %s\n' "$*" >&2; exit "$c"; }
warn() { printf 'vct: warning: %s\n' "$*" >&2; }

# ---------- vct-hub miss-hint probe (v0.2.76 R4) ----------
#
# `vct` reads ONLY the file store. Secrets saved via the launcher GUI live in
# the OS keychain and are served by vct-hub `/env`, NOT by this CLI — so a
# file-store miss for a GUI-saved key used to print `Fix: vct set …`, which,
# if followed, creates a SECOND divergent copy on disk (live bug
# "vct-get-hub-keychain-disjoint"). These helpers let the MISS path ASK the hub
# whether it has the key so the message can point at the resolver instead.
#
# Hub discovery mirrors templates/scripts/vct_secrets_resolve.sh (port/token
# files under $VCT_STATE_DIR, per-project token preferred). Everything here is
# best-effort and MUST soft-fail silently: no curl / no hub / no token / any
# non-200 → treated as "hub doesn't have it", falling back to the old message.
_hub_port() {
    if [ -n "${VCT_HUB_PORT:-}" ]; then printf '%s' "$VCT_HUB_PORT"; return 0; fi
    local state_dir="${VCT_STATE_DIR:-$HOME/.vct}" p
    if [ -f "$state_dir/hub.port" ]; then
        p=$(tr -d '[:space:]' < "$state_dir/hub.port" 2>/dev/null)
        [ -n "$p" ] && { printf '%s' "$p"; return 0; }
    fi
    printf '7700'
}

_hub_token() {
    # $1 = optional project id/slug (prefers the per-project token file).
    # The env pin wins here, as everywhere — only a PROVABLE refusal sets
    # it aside, via `_hub_stale_env_fallback_token` below.
    local project_id="${1:-}"
    if [ -n "${VCT_HUB_TOKEN:-}" ]; then printf '%s' "$VCT_HUB_TOKEN"; return 0; fi
    _hub_token_on_disk "$project_id"
}

# ── Stale-env hub-token fallback (v0.2.91, WP-D item 4) ─────────────────
#
# MUST MATCH the SSOT `vco_lib/project_config.py::_stale_env_token_fallback`
# and the mirrors in `templates/scripts/vct_secrets_resolve.{sh,ps1}`,
# `templates/scripts/vct_project_config.{sh,ps1}`,
# `claude_mcp_servers/wrappers/_base.py` and
# `launcher/tools/vct-cli/src/main.rs`.
#
# WHY here: the hub probe below is best-effort, but a stale exported
# `VCT_HUB_TOKEN` makes it answer "refused (401/403) — key state UNKNOWN"
# on a machine where the on-disk token would have answered definitively.
# One bounded extra request fixes the diagnostic; nothing loops.

# The ONE definitive line. Byte-identical across every mirror.
_VCT_STALE_ENV_TOKEN_MESSAGE="stale VCT_HUB_TOKEN in env overridden by on-disk hub.token — run \`unset VCT_HUB_TOKEN\` or open a new shell"
_VCT_STALE_ENV_WARNED=0

_warn_stale_env_token() {
    # Once per process, on stderr (never stdout — `vct get` pipes stdout).
    if [ "$_VCT_STALE_ENV_WARNED" -eq 0 ]; then
        _VCT_STALE_ENV_WARNED=1
        warn "$_VCT_STALE_ENV_TOKEN_MESSAGE"
    fi
}

_hub_token_on_disk() {
    # $1 = optional project id/slug. Prints the ON-DISK token, IGNORING
    # $VCT_HUB_TOKEN, preserving the scoped-vs-global preference.
    local project_id="${1:-}" state_dir="${VCT_STATE_DIR:-$HOME/.vct}"
    if [ -n "$project_id" ] && [ -r "$state_dir/hub.token.$project_id" ]; then
        tr -d '[:space:]' < "$state_dir/hub.token.$project_id" 2>/dev/null
        return 0
    fi
    if [ -f "$state_dir/hub.token" ]; then
        tr -d '[:space:]' < "$state_dir/hub.token" 2>/dev/null
        return 0
    fi
    printf ''
}

_hub_stale_env_fallback_token() {
    # $1 = optional project id/slug. Prints the on-disk token to retry
    # with and returns 0, or returns 1 (no output). Rules, in order:
    #   1. VCT_HUB_TOKEN_STRICT=1        → 1 (the pin is authoritative)
    #   2. VCT_HUB_TOKEN unset/empty     → 1 (nothing was pinned)
    #   3. no readable on-disk token     → 1 (nothing better to try)
    #   4. on-disk == env (whitespace-normalised) → 1 (pin is not stale)
    local project_id="${1:-}" env_tok disk_tok
    # Trimmed comparison to the literal 1 — the SSOT's spelling, so a
    # `VCT_HUB_TOKEN_STRICT=1` written with a trailing newline/CR means the
    # same thing in bash, PowerShell, Rust and Python.
    [ "$(printf '%s' "${VCT_HUB_TOKEN_STRICT:-}" | tr -d '[:space:]')" = "1" ] \
        && return 1
    env_tok=$(printf '%s' "${VCT_HUB_TOKEN:-}" | tr -d '[:space:]')
    [ -n "$env_tok" ] || return 1
    disk_tok=$(_hub_token_on_disk "$project_id")
    [ -n "$disk_tok" ] || return 1
    [ "$disk_tok" = "$env_tok" ] && return 1
    printf '%s' "$disk_tok"
    return 0
}

# hub_has_key PROJECT KEY → probe the launcher keychain via the hub.
# Exit codes:
#   0  confirmed HIT — the hub served a NON-EMPTY value for KEY on PROJECT.
#   2  hub reachable but the probe was REFUSED (403) or UNAUTHORIZED (401)
#      — the KEY STATE IS UNKNOWN. This is the v0.2.77 flip reality: the
#      probe presents `hub.token.<project>`, but scoped tokens are keyed by
#      launcher PROJECT_ID (a UUID) while PROJECT here is the FILE-STORE
#      NAME, so the scoped file rarely exists → the probe rides the global
#      hub.token → post-flip /env refuses it with 403. A 403/401 must NOT
#      be read as "the hub doesn't have the key" (see die_miss).
#   1  soft-fail — no curl / no hub / no token / any OTHER non-200. Treat
#      as "hub couldn't answer"; caller falls back to the file-store hint.
# Bounded (--max-time 3), localhost-only, token off argv (`--header @-`).
hub_has_key() {
    local project="$1" key="$2"
    command -v curl >/dev/null 2>&1 || return 1
    # "shared" is a file-store scope name, not a launcher project → don't probe.
    [ "$project" = "shared" ] && return 1
    local port token
    port=$(_hub_port)
    token=$(_hub_token "$project")
    [ -n "$token" ] || return 1
    local url="http://127.0.0.1:${port}/api/v1/projects/${project}/env?key=${key}"
    local body status
    body=$(curl --silent --show-error --max-time 3 \
                --header @- --output - --write-out '\n%{http_code}' "$url" \
                <<<"Authorization: Bearer ${token}" 2>/dev/null) || return 1
    status="${body##*$'\n'}"
    body="${body%$'\n'*}"
    # v0.2.91 (WP-D item 4): before classifying a refusal, give the ONE
    # bounded on-disk-token retry a chance — a stale exported
    # VCT_HUB_TOKEN otherwise degrades every probe to "UNKNOWN" on a
    # machine whose hub.token would have answered. Failure of the retry
    # leaves the classification below byte-identical.
    case "$status" in
        403|401)
            local fallback retry retry_status
            if fallback=$(_hub_stale_env_fallback_token "$project"); then
                if retry=$(curl --silent --show-error --max-time 3 \
                                --header @- --output - --write-out '\n%{http_code}' "$url" \
                                <<<"Authorization: Bearer ${fallback}" 2>/dev/null); then
                    retry_status="${retry##*$'\n'}"
                    # ADOPT only an answer that PROVES the fallback
                    # credential was accepted: 2xx, or 404 (the hub answers
                    # "no row" only AFTER its auth middleware accepted the
                    # bearer — a post-auth answer like a 200). Anything
                    # else — 5xx included — proves nothing, so the ORIGINAL
                    # 401/403 stands, this probe still reports UNKNOWN, and
                    # no definitive line is printed (v0.2.91 wave-3,
                    # MINOR-1).
                    case "$retry_status" in
                        2??|404)
                            _warn_stale_env_token
                            status="$retry_status"
                            body="${retry%$'\n'*}"
                            ;;
                        *) : ;;   # not proof — keep the original refusal
                    esac
                fi
            fi
            ;;
    esac
    # v0.2.77 Part 8 Task 4b (option iv): a 403/401 means the hub is up but
    # this probe's credential was refused — the key state is UNKNOWN, NOT a
    # confirmed absence. Signal that distinctly so die_miss withholds the
    # divergent-copy `vct set` hint.
    case "$status" in
        403|401) return 2 ;;
    esac
    [ "$status" = "200" ] || return 1
    # A 200 with an empty/absent value for the key is NOT a hit.
    case "$body" in
        ""|"{}"|"null") return 1 ;;
    esac
    # The value is present in the body — the hub has it. We do NOT parse or
    # print the value (this CLI never resolves keychain values).
    return 0
}

# Emit the correct miss diagnostic for a file-store miss on `verb` and exit `code`.
#
# Three outcomes from the hub probe:
#   * confirmed HIT (0)          → point at the RESOLVER (the keychain has
#                                  it; `vct set` would fork a divergent copy).
#   * reachable-but-refused (2)  → key state UNKNOWN (v0.2.77 flip: the probe
#                                  rode the global token and got 403/401).
#                                  Withhold the `vct set` hint — a wrong-copy
#                                  `vct set` while the keychain MIGHT already
#                                  hold the value is exactly the divergence we
#                                  avoid. Point at the resolver instead, noting
#                                  the probe couldn't confirm.
#   * soft-fail (1)              → hub couldn't answer → classic `vct set` hint.
#
# CREDENTIAL-SHAPED KEY (name-shape guard): a `vct get --key <the token>` typo
# is the read-side twin of the `vct set` swap. The read paths do NOT fail
# closed on a credential-shaped name (they may be operating on an already-
# damaged store), so this function has to withhold the two things that would
# turn the miss into an exposure:
#   (a) the hub probe, which interpolates the key into a URL query string and
#       hands it to curl — a real credential would land in the hub's request
#       log and in the process table; and
#   (b) the key itself in the diagnostic text.
# Both are suppressed and the caller is told to rotate.
die_miss() {
    local verb="$1" code="$2" project="$3" key="$4"
    if is_credential_shaped_name "$key" || is_credential_shaped_name "$project"; then
        die_code "$code" "$verb: not found, and the name you passed has the shape of a live credential, so \
it was NOT sent to the hub probe and is not echoed here. You most likely swapped the VALUE into the NAME \
position. If you pasted a real credential, it reached argv (shell history + process table) — treat it as \
EXPOSED and rotate it."
    fi
    hub_has_key "$project" "$key"
    local probe=$?
    if [ "$probe" -eq 0 ]; then
        die_code "$code" "$verb: not in the file store, but the launcher keychain HAS project=$project key=$key. \
Resolve it via '.claude/scripts/vct_secrets_resolve.sh <project_folder> $key' (or vco_lib.agent_secrets.get('$key')). \
Do NOT 'vct set' it — that creates a second, divergent copy on disk."
    fi
    if [ "$probe" -eq 2 ]; then
        die_code "$code" "$verb: not in the file store. The hub is running but this probe could not confirm the \
launcher keychain (403/401 — the per-project token file hub.token.<project_id> is keyed by the launcher PROJECT ID, \
not the name '$project', so the probe fell back to the global hub.token which the /env route no longer accepts). \
The keychain MAY already hold project=$project key=$key — resolve it via \
'.claude/scripts/vct_secrets_resolve.sh <project_folder> $key' (or vco_lib.agent_secrets.get('$key')). \
Do NOT 'vct set' it blindly — that risks a second, divergent copy on disk."
    fi
    die_code "$code" "$verb: secret not found — project=$project key=$key. Fix: vct set --project $project --key $key"
}

# ---------- Credential-shaped NAME guard ----------
#
# THE HAZARD: `validate_name` below rejects empty / over-long / path-traversal
# / out-of-charset names. It says nothing about whether the name IS a live
# credential. A swapped argument — the VALUE typed where the NAME belongs,
# `vct set --key <the token>` — sails through every one of those checks,
# because the common token shapes are entirely `[A-Za-z0-9_.-]` and well under
# 128 chars. The credential then becomes (a) a FILENAME on disk and (b) a
# cleartext entry in audit.log's `secrets` field. Both survive the shell
# history the user knows to clear.
#
# VOCABULARY SOURCE (one concern, one home): the shapes are NOT defined here.
# They come from the credential-shape vocabulary SSOT
# vco_lib/credential_shapes.py, via this tool's bash mirror
# lib/credential_shapes.sh (sourced above), `argv_name` context. Adding a shape
# to the SSOT propagates here automatically; the parity fixture
# tests/fixtures/credential_shape_parity.json fails every mirror that drifts.
# Do NOT re-inline a literal alternation here — that is precisely the fork this
# indirection removed.
#
# WHY `argv_name` AND NOT A FILE-SCANNING CONTEXT: a name is one complete
# token, not a line of file content, so every arm is whole-string anchored and
# the `sk-` arm can stay WIDE. The file-scan contexts narrow that arm only to
# avoid matching vendored Excalidraw locale asset names (`sk-SK-<hash>-<hash>`,
# still present in this repo) during repo-wide scanning; that haystack cannot
# occupy a `--key` argument, and the narrow form would MISS the whole
# `sk-<vendor>-<tail>` family — i.e. the shape that motivated this guard.
# Prefix families keep EXACT lengths so `github_pat_personal` stays a legal
# name. See the SSOT docstring for the full per-context rationale.
#
# NO OVERRIDE FLAG, by design: a `--force`-shaped escape hatch is a thing a
# user pastes into a script once and then carries forever, which permanently
# re-enables the exact hazard. A false positive has a real remedy that keeps
# the guard intact — pick a name that is not credential-shaped (names are
# arbitrary; prefix it) — and the error message says so.
_VCT_CREDENTIAL_NAME_SHAPES="$_CREDSHAPES_ARGV_NAME_RE"

# The placeholder that stands in for a credential-shaped name in any message,
# audit row or report. Never interpolate the name itself alongside it.
_VCT_REDACTED_NAME='<redacted:credential-shaped-name>'

# is_credential_shaped_name NAME → exit 0 if NAME has the shape of a live
# credential, 1 otherwise. NEVER prints the input (not even truncated).
# Pure predicate: no side effects, no logging, safe to call anywhere.
is_credential_shaped_name() {
    printf '%s' "${1:-}" | LC_ALL=C grep -qE "$_VCT_CREDENTIAL_NAME_SHAPES"
}

# redact_name NAME → echo NAME, or the fixed placeholder when NAME is
# credential-shaped. Use at EVERY point a name reaches a message, a log line
# or a report, so an already-stored credential-shaped name cannot re-leak.
redact_name() {
    if is_credential_shaped_name "${1:-}"; then
        printf '%s' "$_VCT_REDACTED_NAME"
    else
        printf '%s' "${1:-}"
    fi
}

# assert_name_not_credential_shaped KIND NAME — hard refusal for the boundaries
# that CREATE or RENAME a binding (`set`, `copy`, `migrate-from-env`'s project,
# `recover-blob`'s scope). MUST be called before ANY filesystem or audit
# side-effect, so nothing bearing the name is ever created or recorded.
#
# NOT called from `revoke` / `list` / `get` / `resolve` / `can-read`: those
# operate on a binding that ALREADY exists, and `revoke` in particular is the
# remediation path — failing closed there would lock a victim out of deleting
# the artifact with the tool that created it. Those paths get redaction
# (redact_name) rather than refusal.
assert_name_not_credential_shaped() {
    local kind=$1 val=$2
    is_credential_shaped_name "$val" || return 0
    # NOTE: not one byte of $val appears below, on any line.
    printf 'vct: error: refusing to use that as a %s NAME — it has the shape of a live credential.\n' "$kind" >&2
    printf 'vct: Nothing was written and nothing was logged.\n' >&2
    printf 'vct: This is almost always a swapped argument. The VALUE goes on stdin, the NAME on --key:\n' >&2
    printf 'vct:     printf %%s "$TOKEN" | vct set --shared --key github_pat\n' >&2
    printf 'vct: If this really is meant to be a name, choose one that is not credential-shaped\n' >&2
    printf 'vct: (prefix it, e.g. "svc_<name>"). There is deliberately no override flag.\n' >&2
    printf 'vct: IMPORTANT: if you just pasted a real credential here it reached argv, so it is in\n' >&2
    printf 'vct: your shell history and was visible in the process table — treat it as EXPOSED and rotate it.\n' >&2
    exit 1
}

# Reject keys/projects with path-traversal or control chars.
# Allow: [A-Za-z0-9_.-], length 1..128.
#
# NONE of these messages may echo $val. The rejected input is, by definition,
# something the caller got wrong — and the way it is most often wrong is that
# it is a secret VALUE in the NAME position. Printing it turns the check that
# EXISTS to prevent an exposure into a second exposure (stderr, CI logs, the
# terminal scrollback). Say what was wrong structurally; never quote the input.
validate_name() {
    local kind=$1 val=$2
    if [ -z "$val" ]; then
        die "$kind cannot be empty"
    fi
    if [ "${#val}" -gt 128 ]; then
        die "$kind too long (>128 chars) — value not echoed; check the argument you passed"
    fi
    case "$val" in
        *..*|*/*|*$'\n'*|*$'\t'*|.*|-*)
            die "$kind contains invalid characters (path separator, '..', control char, or a leading '.'/'-') — value not echoed"
            ;;
    esac
    # Reject anything outside [A-Za-z0-9_.-]
    if printf '%s' "$val" | LC_ALL=C grep -q '[^A-Za-z0-9_.-]'; then
        die "$kind contains invalid characters (allowed: A-Z a-z 0-9 _ . -) — value not echoed"
    fi
}

ensure_root() {
    if [ ! -d "$VCT_SECRETS_DIR" ]; then
        mkdir -p "$VCT_SECRETS_DIR"
        chmod 700 "$VCT_SECRETS_DIR"
    fi
    mkdir -p "$VCT_SECRETS_DIR/projects" "$VCT_SECRETS_DIR/shared"
    chmod 700 "$VCT_SECRETS_DIR/projects" "$VCT_SECRETS_DIR/shared" 2>/dev/null || true
    if [ ! -f "$AUDIT_LOG" ]; then
        touch "$AUDIT_LOG"
        chmod 600 "$AUDIT_LOG"
    fi
}

# ---------- Canonical deferral bridge (recover-blob collision, ruling #6) ----------
#
# recover-blob's collision handling must NOT hand-roll an UPDATE_DEFERRED writer.
# The canonical emitter is vco_lib.deferral_report (DeferralReport + safe_emit_
# entry), the SAME SSOT the Rust launcher shells out to (services/deferral.rs::
# emit_deferral_entry). deferral_report.py has NO CLI entrypoint, so we invoke it
# via an inline `python - <<PY` heredoc — mirroring the Rust bridge. On ANY
# failure (no python, no repo root, import error, bad target folder) we SOFT-FAIL
# to a clear stderr message (key names only) and never crash recover-blob, never
# fabricate a .claude/ tree in a non-project dir.

# _resolve_vco_python — echo a python interpreter that can import vco_lib, or
# empty on none found. Mirrors resolve_python_for_vco_lib()'s RT-4 ladder:
#   1. $VCT_PYTHON            (explicit override — interpreter binary)
#   2. $VCT_VENV              (venv dir or interpreter binary)
#   3. $VCT_INSTALL_ROOT      (<root>/.venv, <root>/claude_mcp_servers/.venv)
#   4. walk up from this script (≤8 hops) probing the same two venv layouts
#   5. python3 on PATH        (last resort)
_resolve_vco_python() {
    local c
    # 1. $VCT_PYTHON — explicit interpreter path.
    if [ -n "${VCT_PYTHON:-}" ] && [ -x "${VCT_PYTHON}" ]; then
        printf '%s' "$VCT_PYTHON"; return 0
    fi
    # 2. $VCT_VENV — venv dir or interpreter binary.
    if [ -n "${VCT_VENV:-}" ]; then
        for c in "$VCT_VENV/bin/python" "$VCT_VENV/bin/python3" "$VCT_VENV/Scripts/python.exe"; do
            [ -x "$c" ] && { printf '%s' "$c"; return 0; }
        done
        [ -x "${VCT_VENV}" ] && { printf '%s' "$VCT_VENV"; return 0; }
    fi
    # 3. $VCT_INSTALL_ROOT — two known venv layouts.
    if [ -n "${VCT_INSTALL_ROOT:-}" ]; then
        for c in "$VCT_INSTALL_ROOT/.venv/bin/python" "$VCT_INSTALL_ROOT/.venv/bin/python3" \
                 "$VCT_INSTALL_ROOT/claude_mcp_servers/.venv/bin/python" \
                 "$VCT_INSTALL_ROOT/claude_mcp_servers/.venv/bin/python3"; do
            [ -x "$c" ] && { printf '%s' "$c"; return 0; }
        done
    fi
    # 4. Walk up from this script's dir (≤8 hops).
    local cur="$_VCT_SELF_DIR" i
    for i in 1 2 3 4 5 6 7 8; do
        for c in "$cur/.venv/bin/python" "$cur/.venv/bin/python3" \
                 "$cur/claude_mcp_servers/.venv/bin/python" \
                 "$cur/claude_mcp_servers/.venv/bin/python3"; do
            [ -x "$c" ] && { printf '%s' "$c"; return 0; }
        done
        [ "$cur" = "/" ] && break
        cur=$(dirname "$cur")
    done
    # 5. PATH fallback.
    if command -v python3 >/dev/null 2>&1; then
        printf 'python3'; return 0
    fi
    printf ''
    return 1
}

# _resolve_vco_lib_root — echo a directory that contains an importable
# `vco_lib` package (has vco_lib/deferral_report.py), or empty. Checked:
#   1. $VCT_INSTALL_ROOT
#   2. walk up from this script's dir (≤8 hops)
_resolve_vco_lib_root() {
    if [ -n "${VCT_INSTALL_ROOT:-}" ] && [ -f "$VCT_INSTALL_ROOT/vco_lib/deferral_report.py" ]; then
        printf '%s' "$VCT_INSTALL_ROOT"; return 0
    fi
    local cur="$_VCT_SELF_DIR" i
    for i in 1 2 3 4 5 6 7 8; do
        if [ -f "$cur/vco_lib/deferral_report.py" ]; then
            printf '%s' "$cur"; return 0
        fi
        [ "$cur" = "/" ] && break
        cur=$(dirname "$cur")
    done
    printf ''
    return 1
}

# _resolve_deferral_target_folder — echo the project/orchestrator folder whose
# .claude/context/UPDATE_DEFERRED.md the deferral lands in, or empty (rootless).
#   (a) walk up from PWD for a .vct-project → the containing project root
#   (b) else the resolvable vco_lib root (orchestrator/install root)
#   (c) else empty → caller soft-fails to a stderr message
# NEVER fabricate a .claude/ tree — only return a folder that already looks like
# a managed project (has a .vct-project, a .claude/ dir, or is the vco_lib root).
_resolve_deferral_target_folder() {
    local cur
    cur=$(pwd -P 2>/dev/null) || cur=""
    while [ -n "$cur" ] && [ "$cur" != "/" ]; do
        if [ -f "$cur/.vct-project" ] || [ -d "$cur/.claude" ]; then
            printf '%s' "$cur"; return 0
        fi
        cur=$(dirname "$cur")
    done
    local root
    if root=$(_resolve_vco_lib_root) && [ -n "$root" ] && [ -d "$root/.claude" ]; then
        printf '%s' "$root"; return 0
    fi
    printf ''
    return 1
}

# emit_blob_collision_deferral KEY BACKUP_PATH  — route a secret_blob_collision
# through the canonical Python emitter. Key names only; NO values. Soft-fails to
# a stderr message when python / vco_lib root / project folder can't resolve.
emit_blob_collision_deferral() {
    local key="$1" backup="$2"
    local py root folder
    py=$(_resolve_vco_python)
    root=$(_resolve_vco_lib_root)
    folder=$(_resolve_deferral_target_folder)
    if [ -z "$py" ] || [ -z "$root" ] || [ -z "$folder" ]; then
        warn "recover-blob: collision on key '$key' (kept the existing standalone value; \
extracted copy differs). Could not record an UPDATE_DEFERRED entry (no VCO install / project \
folder resolved). Blob backup: $backup. Reconcile the two values manually."
        return 1
    fi
    # Pass all data via argv (never inline into the program text) so a key name
    # can't break the heredoc. The heredoc program reads sys.argv only.
    if "$py" - "$root" "$folder" "$key" "$backup" <<'PY' 2>/dev/null; then
import sys
root, folder, key, backup = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
sys.path.insert(0, root)
from pathlib import Path
from vco_lib.deferral_report import DeferralReport, safe_emit_entry
report = DeferralReport.read(Path(folder))
safe_emit_entry(
    report,
    condition_id="secret_blob_collision",
    title="Secret blob recovery — key collision (standalone kept)",
    detected=(
        f"'vct recover-blob' split a multi-secret blob and found key '{key}' already "
        f"exists as a standalone secret with a DIFFERENT value. The standalone value "
        f"was KEPT (never overwritten); the blob-embedded copy was left in the backup."
    ),
    why_deferred=(
        "The two values differ and recover-blob cannot know which is correct — "
        "resolving requires a human decision."
    ),
    command_to_apply=(
        f"# Compare the standalone value with the blob-embedded copy in the backup, "
        f"then keep the correct one:\n"
        f"#   backup: {backup}\n"
        f"#   key:    {key}\n"
        f"# (values are NOT shown here; inspect the chmod-600 files directly)"
    ),
    severity="warning",
)
report.write(Path(folder))
PY
        printf 'vct: recorded UPDATE_DEFERRED entry (secret_blob_collision) for key %s in %s\n' \
            "$key" "$folder" >&2
        return 0
    fi
    warn "recover-blob: collision on key '$key' (kept the existing standalone value). \
The canonical deferral emitter failed (python/import error). Blob backup: $backup. \
Reconcile the two values manually."
    return 1
}

# JSON-escape a string (minimal: quotes, backslashes, control chars).
json_escape() {
    local s=$1
    s=${s//\\/\\\\}
    s=${s//\"/\\\"}
    s=${s//$'\n'/\\n}
    s=${s//$'\r'/\\r}
    s=${s//$'\t'/\\t}
    printf '%s' "$s"
}

# audit op project keys_array caller_cmd
audit() {
    local op=$1 project=$2 keys=$3 caller_cmd=${4:-}
    local ts
    ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    local line
    line=$(printf '{"ts":"%s","op":"%s","project":"%s","secrets":%s,"caller_pid":%d,"caller_cmd":"%s"}' \
        "$ts" \
        "$(json_escape "$op")" \
        "$(json_escape "$(redact_name "$project")")" \
        "$keys" \
        "$$" \
        "$(json_escape "$caller_cmd")")
    printf '%s\n' "$line" >> "$AUDIT_LOG"
}

# Build JSON array from space-separated list.
#
# Names are REDACTED here rather than at each call site because this is the
# single chokepoint every audit row's `secrets` field passes through (every
# caller is `audit ... "$(json_array_from_list ...)"`). The create-time guard
# means a credential-shaped name can no longer ENTER the store — but a store
# damaged before the guard existed would otherwise re-leak the name into
# audit.log on every subsequent get/exec/revoke. audit.log is an append-only
# artifact that outlives the incident and is read by other tooling, so it gets
# redaction; `vct list`, which prints names to stdout on explicit request and
# is how a user finds the damage in order to revoke it, deliberately does not.
json_array_from_list() {
    local first=1 out='['
    local k
    for k in "$@"; do
        if [ $first -eq 1 ]; then first=0; else out+=','; fi
        out+='"'$(json_escape "$(redact_name "$k")")'"'
    done
    out+=']'
    printf '%s' "$out"
}

# ---------- Write-scope resolution (the shared-namespace write path) ----------
#
# THE BUG THIS FIXES: `set` used to hardcode projects/<project>/<key>, so
# `vct set --project shared --key K` created a PROJECT literally named
# "shared" at projects/shared/K. Nothing that CONSUMES the shared namespace
# reads that path — not resolve_secret's per-project order
# (projects/<NAME>/ then shared/), not templates/scripts/vct_secrets_resolve.sh,
# not vco_lib/agent_secrets.py, not tools/vct-secrets/git-credential-vct. The
# write was accepted, reported as "stored shared/K", and inert everywhere it
# mattered. The only readers that could see it were `vct get`/`vct list` run
# with the SAME wrong invocation — which is precisely what made it look like
# it had worked.
#
# `--project shared` is ALIASED to the shared namespace rather than REFUSED.
# The instruction to spell it that way is emitted from two places this file
# cannot fix in lockstep — the shared-store README that install materialises
# into the user's own secrets directory
# (templates/vct-secrets-shared-readme.template) and the miss message in
# vco_lib/agent_secrets.py. Refusing would turn both into hard-failing advice
# the moment this lands; aliasing makes both correct immediately. The
# trade-off is that a project literally named "shared" can no longer be
# written — acceptable, because the store layout already reserves that name
# for the shared namespace at its top level.
#
# ONE implementation, called by every subcommand that resolves a WRITE scope
# (`set`, `revoke`), so `--project shared` cannot come to mean one thing in
# one subcommand and something else in another.
#
# WRITE-ONLY, deliberately. The READ subcommands (`get`, `exec`, `can-read`,
# `resolve`, `list`) are NOT routed through here, and that is a decision, not
# an oversight:
#   * resolve_secret() already tries projects/<NAME>/ then shared/, so a read
#     with `--project shared` finds the shared file today via the fallback.
#     Nothing is broken on the read side; only the write path was.
#   * `vct list --project shared` is the one command that ENUMERATES a
#     damaged store's projects/shared/ orphans. Aliasing it would make the
#     misfiled set invisible from inside the tool at exactly the moment a
#     user is trying to clean it up. (`vct doctor` names each path too, so
#     the information exists in two places rather than none.)
# The cost is that `--project shared` reaches projects/shared/ in `list` and
# the shared namespace in `set`/`revoke`. That asymmetry is bounded to a
# store that is already damaged, and it disappears entirely once
# `doctor --fix-shared-scope` has emptied projects/shared/.
#
# Out-vars (bash 3.2 has no namerefs; documented rather than returned):
#   _VCT_SCOPE_DIR        absolute directory the key lives in
#   _VCT_SCOPE_PROJECT    normalised scope label ("shared" or the project name)
#   _VCT_SCOPE_IS_SHARED  1 when the shared namespace, else 0
#   _VCT_SCOPE_FLAG       the canonical flag to quote back in messages
_VCT_SCOPE_DIR=""
_VCT_SCOPE_PROJECT=""
_VCT_SCOPE_IS_SHARED=0
_VCT_SCOPE_FLAG=""
resolve_write_scope() {
    local subcmd="$1" shared="$2" project="$3"
    if [ "$shared" -eq 1 ] && [ -n "$project" ] && [ "$project" != "shared" ]; then
        die "$subcmd: --shared and --project $project are mutually exclusive — pick one scope"
    fi
    if [ "$shared" -eq 0 ] && [ "$project" = "shared" ]; then
        warn "$subcmd: '--project shared' means the SHARED namespace, not a project called \
'shared'. Using the shared namespace; the canonical spelling is '--shared'."
        shared=1
    fi
    [ "$shared" -eq 1 ] || [ -n "$project" ] \
        || die "$subcmd: --project NAME (or --shared) required"
    if [ "$shared" -eq 1 ]; then
        _VCT_SCOPE_DIR="$VCT_SECRETS_DIR/shared"
        _VCT_SCOPE_PROJECT="shared"
        _VCT_SCOPE_IS_SHARED=1
        _VCT_SCOPE_FLAG="--shared"
    else
        validate_name "project" "$project"
        _VCT_SCOPE_DIR="$VCT_SECRETS_DIR/projects/$project"
        _VCT_SCOPE_PROJECT="$project"
        _VCT_SCOPE_IS_SHARED=0
        _VCT_SCOPE_FLAG="--project $project"
    fi
    # NOTE: the credential-shaped-NAME refusal is deliberately NOT applied
    # here. This function is the scope MECHANISM; whether a credential-shaped
    # name is fatal is per-boundary POLICY — fatal for `set` (a CREATE), not
    # for `revoke` (the remediation path). Each caller applies its own.
}

# Per-project opt-out marker for the SHARED fallback. MIRRORED,
# byte-for-byte, in vco_lib/agent_secrets.py (NO_SHARED_FALLBACK_MARKER),
# templates/scripts/vct_secrets_resolve.sh (NO_SHARED_FALLBACK_MARKER)
# and templates/scripts/vct_secrets_resolve.ps1 ($VctNoSharedFallbackMarker)
# — and WRITTEN by the launcher's shared-secrets toggle in
# launcher/src-tauri/src/commands/secrets_cmd.rs. The five spellings are
# locked by tests/test_no_shared_fallback_marker_parity.py; the BEHAVIOUR
# is pinned by tests/vct_secrets_cli_suite.sh.
NO_SHARED_FALLBACK_MARKER=".no-shared-fallback"

# shared_fallback_disabled — true when $1 has opted out of shared/.
#
# An empty project means the caller has no project identity, so there is
# nothing to opt out of. The literal name "shared" is excluded too: it is
# this CLI's own default scope label (`get`/`exec`/`can-read`/`resolve`
# fall back to project="shared" when --project is omitted), so honouring a
# marker there would let one stray projects/shared/ orphan disable every
# shared read on the machine. Must match
# agent_secrets._shared_fallback_disabled, shared_fallback_disabled (.sh)
# and Test-SharedFallbackDisabled (.ps1).
shared_fallback_disabled() {
    local project=$1
    [ -n "$project" ] && [ "$project" != "shared" ] || return 1
    [ -e "$VCT_SECRETS_DIR/projects/$project/$NO_SHARED_FALLBACK_MARKER" ]
}

# Resolve path for a secret. Prints the path on stdout; exit 0 if found, 2 if not.
resolve_secret() {
    local project=$1 key=$2
    local p_path="$VCT_SECRETS_DIR/projects/$project/$key"
    local s_path="$VCT_SECRETS_DIR/shared/$key"
    if [ -f "$p_path" ]; then
        printf '%s' "$p_path"
        return 0
    fi
    # Read-side half of the launcher's per-project "Disable shared secrets"
    # gate. READS only: `revoke` routes through resolve_write_scope, so an
    # opted-out project can still delete its own keys.
    if shared_fallback_disabled "$project"; then
        return 2
    fi
    if [ -f "$s_path" ]; then
        printf '%s' "$s_path"
        return 0
    fi
    return 2
}

# ---------- Subcommands ----------

cmd_help() {
    cat <<'EOF'
vct — VCT Secrets Primitive (Phase 1, Bash)

USAGE:
  vct <subcommand> [args...]
  vct secret <subcommand> [args...]    # 'secret' is optional for compatibility

SUBCOMMANDS:
  list [--project NAME]
        List secret keys (names only) for a project, or shared if no --project.

  set (--project NAME | --shared) --key KEY [--confirm-tty] [--allow-multiline]
        Store a secret. Value read from stdin ONLY (never from argv).
        Refuses interactive TTY stdin unless --confirm-tty given.
        A scope stays REQUIRED for writes (writing should be deliberate):
        --project NAME → projects/NAME/KEY, --shared → shared/KEY.
        '--project shared' is accepted as an alias for --shared (it used to
        create a project literally called "shared" at projects/shared/KEY,
        which no resolver ever reads).
        Refuses a KEY or PROJECT whose NAME has the shape of a live
        credential — the swapped-argument accident that turns a token into
        a filename. There is no override flag; pick another name.
        Rejects a multi-secret BLOB (a bare token + KEY=value continuation
        lines) at the write boundary — a single file must hold ONE secret.
        A legitimate multi-line secret (PEM/cert/OpenSSH) is accepted
        automatically; pass --allow-multiline only for a multi-line format
        the allowlist does not yet recognise.

  get --key KEY [--project NAME] [--trusted]
        Print a secret value to stdout. Requires --trusted when stdout is a TTY
        (tripwire against shell-history capture). Prefer 'exec' instead.
        Without --project, resolves from the shared scope.

  exec [--project NAME] [--secret KEY[=VAR_NAME]]... [--preserve-env] -- CMD [ARGS...]
        Inject named secrets into child env, then exec CMD. Secrets never
        touch the parent shell. Missing secret → exit 2, CMD not run.
        Without --preserve-env, only a safe minimal env is carried through.
        Without --project, resolves from the shared scope (symmetric with
        'get' and 'list').

  can-read --key KEY [--project NAME]
        Exit 0 if KEY is resolvable (project scope first, then shared),
        exit 1 if not. Prints nothing. For scripts/agents that want to
        probe availability without reading the value.

  resolve --key KEY [--project NAME]
        Print the file path the resolver would read for KEY (project
        scope wins over shared). Exit 2 if the key resolves nowhere.
        Never prints the secret value.

  revoke (--project NAME | --shared) --key KEY [--yes]
        Delete a secret file from a project or the shared namespace.
        Prompts unless --yes. Same scope vocabulary as 'set'.
        Deliberately NOT blocked on credential-shaped names — this is the
        remediation path for a store damaged before that guard existed.

  copy --from-project SRC --to-project DST --key KEY [--yes]
        Explicit cross-project copy. Prompts unless --yes.

  migrate-from-env FILE --project NAME [--dry-run]
        Parse a dotenv file (KEY=VALUE lines, # comments, quoted values)
        and store each key into the project. Renames source → FILE.migrated
        on success (not in --dry-run).

  recover-blob [--key KEY] [--project NAME | --shared] [--all]
        Split a multi-secret BLOB file (a bare token on line 0 + KEY=value
        continuation lines) into separate standalone secret files. OPT-IN,
        never auto-mutates. Backs up the blob to .<key>.blob-backup-<ts>
        first, then extracts every worth-saving line. If an extracted key
        already exists standalone with a DIFFERENT value, the standalone is
        KEPT (never overwritten) and the conflict is recorded in the
        project's UPDATE_DEFERRED.md. Idempotent: a re-run on a clean file
        is a no-op. Never prints a secret value.
        --key targets one file; --all scans the scope for blobs.

  doctor [--fix-shape] [--fix-shared-scope]
        Audit dir/file permissions. Fixes chmod to 700/600 where needed.
        Also reports two store-integrity conditions it never auto-repairs:
          * secrets misfiled under projects/shared/ (the pre-fix
            'set --project shared' landing spot, which no resolver reads).
            --fix-shared-scope moves each one to the real shared namespace
            with an atomic rename, and REFUSES on collision — it never
            overwrites and never deletes.
          * a SECOND deployed copy of this CLI inside the store that is
            missing guards this one has. Reported only; never overwritten.
        Also shape-checks GitHub token files (any key named github_pat
        or github_pat.*): classifies each as ok / blob / length_corruption
        / legit_multiline and warns with the right remediation (blob →
        recover-blob; length_corruption → manual re-issue; PEM → note).
        Reads ONLY github_pat-named files for the shape check; never prints
        secret contents.
        --fix-shape additionally RUNS recover-blob on every blob-classified
        github_pat file (length_corruption / legit_multiline are never
        auto-mutated). Without --fix-shape, doctor never mutates a secret.

  detect-project
        Walks up from PWD to find a .vct-project file; echoes its content.
        Exits 1 if not found.

  help | --help | -h
        Show this message.

  version | --version
        Show version.

ENVIRONMENT:
  VCT_SECRETS_DIR    Override secret store root (default: ~/.vct-secrets)

See: docs/VCT_SECRETS_PRIMITIVE.md (in the vibecoded-orchestrator repo)
EOF
}

cmd_version() {
    printf 'vct %s\n' "$VERSION"
    # Capability stamp — see VCT_GUARDS at the top of this file. A deployed
    # COPY that predates a guard prints a shorter list (or, if it predates the
    # stamp entirely, no `guards:` line at all), which is what makes staleness
    # detectable without a version registry anywhere.
    printf 'guards: %s\n' "$VCT_GUARDS"
    printf 'source: %s\n' "$_VCT_SELF_DIR"
}

cmd_list() {
    local project=""
    while [ $# -gt 0 ]; do
        case $1 in
            --project) project=$2; shift 2 ;;
            -h|--help) cmd_help; return 0 ;;
            *) die "list: unknown arg: $1" ;;
        esac
    done
    ensure_root
    local dir
    if [ -n "$project" ]; then
        validate_name "project" "$project"
        dir="$VCT_SECRETS_DIR/projects/$project"
    else
        dir="$VCT_SECRETS_DIR/shared"
    fi
    if [ ! -d "$dir" ]; then
        return 0
    fi
    # Print basenames of regular files, sorted. No values.
    # `_README.md` is the agent-facing schema doc (materialized by
    # install.py), not a secret — skip it.
    local f
    for f in "$dir"/*; do
        [ -f "$f" ] || continue
        case "$(basename "$f")" in _README.md) continue ;; esac
        basename "$f"
    done | sort
}

cmd_set() {
    local project="" key="" confirm_tty=0 allow_multiline=0 shared=0
    while [ $# -gt 0 ]; do
        case $1 in
            --project) project=$2; shift 2 ;;
            # --shared: write the real SHARED namespace ($VCT_SECRETS_DIR/shared).
            # Same flag name and meaning as `recover-blob --shared`.
            --shared) shared=1; shift ;;
            --key) key=$2; shift 2 ;;
            --confirm-tty) confirm_tty=1; shift ;;
            --allow-multiline) allow_multiline=1; shift ;;
            --value|--value=*)
                die "set: --value is forbidden (secrets must come from stdin)"
                ;;
            -h|--help) cmd_help; return 0 ;;
            *) die "set: unknown arg: $1" ;;
        esac
    done

    resolve_write_scope "set" "$shared" "$project"
    shared=$_VCT_SCOPE_IS_SHARED
    project=$_VCT_SCOPE_PROJECT
    [ -n "$key" ] || die "set: --key required"
    validate_name "key" "$key"
    # CREATE boundary — must precede ensure_root, mkdir, mktemp and audit so a
    # credential-shaped name never becomes a filename or an audit row. The next
    # statement that touches the filesystem is ensure_root, two lines below;
    # nothing above this point has written to disk (resolve_write_scope only
    # computes paths, and its one output is a stderr warning naming the literal
    # string "shared").
    assert_name_not_credential_shaped "project" "$project"
    assert_name_not_credential_shaped "key" "$key"
    ensure_root

    if [ -t 0 ] && [ $confirm_tty -eq 0 ]; then
        die "set: stdin is a TTY — pipe the value in, e.g. 'printf %s \"\$TOKEN\" | vct set ...' (or pass --confirm-tty to type it interactively)"
    fi

    local scope_dir="$_VCT_SCOPE_DIR"
    mkdir -p "$scope_dir"
    chmod 700 "$scope_dir"
    local proj_dir="$scope_dir"
    local target="$scope_dir/$key"

    # Read stdin into temp file (never echo), rename atomically.
    local tmp
    tmp=$(mktemp "$proj_dir/.$key.tmp.XXXXXX") || die "set: mktemp failed"
    chmod 600 "$tmp"
    # shellcheck disable=SC2094
    cat > "$tmp" || { rm -f "$tmp"; die "set: stdin read failed"; }

    # Write-time shape guard (Part A). Read the buffered value back binary-safe
    # (never echo it) and run the parity-locked single-line predicate. A blob is
    # rejected HERE — the origin boundary — instead of being faithfully written
    # and later handed multi-line to git/gh. A legit PEM passes without the flag
    # (the predicate accepts the allowlisted format); --allow-multiline is the
    # escape hatch for a multi-line format the allowlist doesn't yet recognise.
    local _val _reason _scope_flag
    if [ "$shared" -eq 1 ]; then _scope_flag="--shared"; else _scope_flag="--project $project"; fi
    _val=$(cat -- "$tmp"; printf x); _val=${_val%x}
    if ! _reason=$(_is_single_line_secret "$_val" "$key" "$allow_multiline"); then
        rm -f "$tmp"
        die "set: refusing to store a malformed/blob value for $project/$key (reason: $_reason). \
A single secret file must hold ONE secret. If this is a legitimate multi-line secret the \
allowlist doesn't recognise, re-run with --allow-multiline. If this is several secrets glued \
together (a blob), recover them with 'vct recover-blob $_scope_flag --key $key' after \
storing the raw file, or split them into separate keys."
    fi
    unset _val

    mv "$tmp" "$target"
    chmod 600 "$target"
    audit "set" "$project" "$(json_array_from_list "$key")" ""
    # Report the RESOLVED PATH, not just "<scope>/<key>". The old message
    # printed "vct: stored shared/K" for a write that had landed in
    # projects/shared/K — wording that matched exactly what the user expected
    # while describing a different location. A path cannot be ambiguous.
    printf 'vct: stored %s\n' "$target" >&2
}

cmd_get() {
    local project="" key="" trusted=0
    while [ $# -gt 0 ]; do
        case $1 in
            --project) project=$2; shift 2 ;;
            --key) key=$2; shift 2 ;;
            --trusted) trusted=1; shift ;;
            -h|--help) cmd_help; return 0 ;;
            *) die "get: unknown arg: $1 (expected --key KEY [--project NAME] [--trusted])" ;;
        esac
    done
    # Symmetric default (v0.2.54 S-2): no --project → shared scope,
    # matching `list` and `exec`. resolve_secret() already falls
    # through projects/shared/ (normally absent) to shared/.
    [ -n "$project" ] || project="shared"
    [ -n "$key" ]     || die "get: --key required"
    validate_name "project" "$project"
    validate_name "key" "$key"
    ensure_root

    if [ -t 1 ] && [ $trusted -eq 0 ]; then
        die "get: stdout is a TTY — refusing to print secret. Pass --trusted if you really mean it."
    fi

    local path
    if ! path=$(resolve_secret "$project" "$key"); then
        die_miss "get" 2 "$project" "$key"
    fi
    audit "get" "$project" "$(json_array_from_list "$key")" ""
    cat "$path"
}

cmd_revoke() {
    local project="" key="" yes=0 shared=0
    while [ $# -gt 0 ]; do
        case $1 in
            --project) project=$2; shift 2 ;;
            # Same scope vocabulary as `set` and `recover-blob`. `revoke` had
            # NO way to delete a shared-namespace secret before this; more
            # importantly, routing it through resolve_write_scope keeps
            # '--project shared' from meaning the shared namespace in `set`
            # and projects/shared/ in `revoke`.
            --shared) shared=1; shift ;;
            --key) key=$2; shift 2 ;;
            --yes|-y) yes=1; shift ;;
            -h|--help) cmd_help; return 0 ;;
            *) die "revoke: unknown arg: $1" ;;
        esac
    done
    resolve_write_scope "revoke" "$shared" "$project"
    project=$_VCT_SCOPE_PROJECT
    [ -n "$key" ] || die "revoke: --key required"
    validate_name "key" "$key"
    ensure_root

    local target="$_VCT_SCOPE_DIR/$key"
    if [ ! -f "$target" ]; then
        die_code 2 "revoke: not found — $(redact_name "$project")/$(redact_name "$key")"
    fi
    # NOTE: `revoke` is deliberately NOT guarded by
    # assert_name_not_credential_shaped. It is the remediation path for a store
    # damaged before the guard existed — failing closed here would leave the
    # victim unable to delete the artifact with the tool that created it. The
    # name is REDACTED in the prompt, the confirmation and the audit row
    # instead, so removing the artifact does not reprint it.
    if [ $yes -eq 0 ]; then
        printf 'Revoke %s/%s? [y/N] ' "$(redact_name "$project")" "$(redact_name "$key")" >&2
        local ans=""
        read -r ans </dev/tty || die "revoke: cannot read confirmation"
        case "$ans" in
            y|Y|yes|YES) ;;
            *) printf 'vct: revoke cancelled\n' >&2; return 1 ;;
        esac
    fi
    rm -f -- "$target"
    audit "revoke" "$project" "$(json_array_from_list "$key")" ""
    printf 'vct: revoked %s/%s\n' "$(redact_name "$project")" "$(redact_name "$key")" >&2
}

cmd_copy() {
    local src="" dst="" key="" yes=0
    while [ $# -gt 0 ]; do
        case $1 in
            --from-project) src=$2; shift 2 ;;
            --to-project)   dst=$2; shift 2 ;;
            --key) key=$2; shift 2 ;;
            --yes|-y) yes=1; shift ;;
            -h|--help) cmd_help; return 0 ;;
            *) die "copy: unknown arg: $1" ;;
        esac
    done
    [ -n "$src" ] || die "copy: --from-project required"
    [ -n "$dst" ] || die "copy: --to-project required"
    [ -n "$key" ] || die "copy: --key required"
    validate_name "project" "$src"
    validate_name "project" "$dst"
    validate_name "key" "$key"
    # CREATE boundary — `copy` writes projects/<dst>/<key>, so all three names
    # are guarded. The SOURCE is guarded too: copying out of a credential-shaped
    # binding would propagate the bad name to a second location rather than
    # remediate it (the remediation is `revoke`, which is deliberately not
    # guarded). Must precede ensure_root / mkdir / cp / audit.
    assert_name_not_credential_shaped "project" "$src"
    assert_name_not_credential_shaped "project" "$dst"
    assert_name_not_credential_shaped "key" "$key"
    ensure_root

    local src_path="$VCT_SECRETS_DIR/projects/$src/$key"
    [ -f "$src_path" ] || die_code 2 "copy: source not found — $src/$key"

    local dst_dir="$VCT_SECRETS_DIR/projects/$dst"
    local dst_path="$dst_dir/$key"

    if [ $yes -eq 0 ]; then
        printf 'Copy secret %s from project=%s to project=%s? [y/N] ' "$key" "$src" "$dst" >&2
        local ans=""
        read -r ans </dev/tty || die "copy: cannot read confirmation"
        case "$ans" in
            y|Y|yes|YES) ;;
            *) printf 'vct: copy cancelled\n' >&2; return 1 ;;
        esac
    fi

    mkdir -p "$dst_dir"
    chmod 700 "$dst_dir"
    cp -- "$src_path" "$dst_path"
    chmod 600 "$dst_path"
    audit "copy" "$dst" "$(json_array_from_list "$key")" "from=$src"
    printf 'vct: copied %s/%s → %s/%s\n' "$src" "$key" "$dst" "$key" >&2
}

cmd_exec() {
    local project="" preserve_env=0
    # Parallel arrays: source keys, and env var names they map to (same index).
    local -a src_keys=() var_names=()
    local saw_dashdash=0

    while [ $# -gt 0 ]; do
        case $1 in
            --project) project=$2; shift 2 ;;
            --secret)
                local spec=$2; shift 2
                local sk vn
                if [[ "$spec" == *=* ]]; then
                    sk=${spec%%=*}
                    vn=${spec#*=}
                else
                    sk=$spec
                    vn=$spec
                fi
                validate_name "key" "$sk"
                # var_name: must be a valid env identifier
                case "$vn" in
                    ''|*[^A-Za-z0-9_]*) die "exec: invalid env var name: $vn" ;;
                esac
                case "$vn" in
                    [0-9]*) die "exec: env var name cannot start with digit: $vn" ;;
                esac
                src_keys+=("$sk")
                var_names+=("$vn")
                ;;
            --preserve-env) preserve_env=1; shift ;;
            --) saw_dashdash=1; shift; break ;;
            -h|--help) cmd_help; return 0 ;;
            -*) die "exec: unknown flag: $1" ;;
            *) die "exec: unexpected arg before --: $1" ;;
        esac
    done
    # Symmetric default (v0.2.54 S-2): no --project → shared scope,
    # matching `list` and `get`. Removes the friction where
    # `vct exec --secret K=V -- cmd` failed on shared-scope keys.
    [ -n "$project" ] || project="shared"
    validate_name "project" "$project"
    [ $saw_dashdash -eq 1 ] || die "exec: missing -- before command"
    [ $# -gt 0 ] || die "exec: no command given after --"
    ensure_root

    # Resolve each secret up-front. Fail fast before executing CMD.
    local -a resolved_paths=()
    local i
    for ((i = 0; i < ${#src_keys[@]}; i++)); do
        local sk=${src_keys[$i]}
        local path
        if ! path=$(resolve_secret "$project" "$sk"); then
            die_miss "exec" 2 "$project" "$sk"
        fi
        resolved_paths+=("$path")
    done

    # Audit BEFORE exec (exec replaces process; no return).
    local keys_json
    keys_json=$(json_array_from_list "${var_names[@]:-}")
    audit "exec" "$project" "$keys_json" "$*"

    # Build env command. Read each secret into a variable, pass with env -S style.
    # We use `env -i` plus preserved-env assignments and the secret assignments.
    local -a env_args=()
    if [ $preserve_env -eq 0 ]; then
        env_args+=(-i)
        local ev
        for ev in "${PRESERVE_ENV_VARS[@]}"; do
            if [ -n "${!ev-}" ]; then
                env_args+=("$ev=${!ev}")
            fi
        done
    fi
    # Append secret assignments
    for ((i = 0; i < ${#src_keys[@]}; i++)); do
        local vn=${var_names[$i]}
        local pth=${resolved_paths[$i]}
        local val
        # read binary-safe: cat, strip trailing newline only if present
        val=$(cat -- "$pth"; printf x)
        val=${val%x}
        # Strip exactly one trailing newline if present (common for files created by echo)
        val=${val%$'\n'}
        env_args+=("$vn=$val")
    done

    exec env "${env_args[@]}" "$@"
}

cmd_migrate_from_env() {
    local file="" project="" dry_run=0
    while [ $# -gt 0 ]; do
        case $1 in
            --project) project=$2; shift 2 ;;
            --dry-run) dry_run=1; shift ;;
            -h|--help) cmd_help; return 0 ;;
            -*) die "migrate-from-env: unknown flag: $1" ;;
            *)
                if [ -z "$file" ]; then file=$1; shift
                else die "migrate-from-env: unexpected arg: $1"
                fi
                ;;
        esac
    done
    [ -n "$file" ]    || die "migrate-from-env: FILE required"
    [ -n "$project" ] || die "migrate-from-env: --project required"
    validate_name "project" "$project"
    # CREATE boundary (scope). Per-KEY guarding happens in the parse loop below
    # and SKIPS rather than dies — one malformed line must not abort a whole
    # dotenv migration.
    assert_name_not_credential_shaped "project" "$project"
    [ -f "$file" ]    || die "migrate-from-env: no such file: $file"
    ensure_root

    local proj_dir="$VCT_SECRETS_DIR/projects/$project"
    mkdir -p "$proj_dir"
    chmod 700 "$proj_dir"

    local imported=0 skipped=0
    local line key value trimmed
    while IFS= read -r line || [ -n "$line" ]; do
        # Strip leading whitespace
        trimmed=${line#"${line%%[![:space:]]*}"}
        # Skip blanks and comments
        [ -z "$trimmed" ] && continue
        case "$trimmed" in \#*) continue ;; esac
        # Strip optional 'export '
        case "$trimmed" in
            export\ *) trimmed=${trimmed#export } ;;
        esac
        # Must contain '='
        case "$trimmed" in
            *=*) ;;
            *) skipped=$((skipped+1)); continue ;;
        esac
        key=${trimmed%%=*}
        value=${trimmed#*=}
        # Strip surrounding quotes on value (single or double)
        case "$value" in
            \"*\") value=${value#\"}; value=${value%\"} ;;
            \'*\') value=${value#\'}; value=${value%\'} ;;
        esac
        # Strip trailing whitespace on key
        key=${key%"${key##*[![:space:]]}"}
        # Validate key. The warning does NOT echo the key: a dotenv line whose
        # LHS is credential-shaped is the same swapped-argument accident as
        # `vct set --key <token>`, and the message that reports it must not
        # become the leak. Non-credential invalid keys are named (useful, and
        # they are by construction not credential-shaped).
        if [ -z "$key" ] || printf '%s' "$key" | LC_ALL=C grep -q '[^A-Za-z0-9_.-]'; then
            warn "skipping invalid key: $(redact_name "$key")"
            skipped=$((skipped+1))
            continue
        fi
        # CREATE boundary (per key) — skip, never write, never name it.
        if is_credential_shaped_name "$key"; then
            warn "skipping a key whose NAME has the shape of a live credential (name not echoed). \
That dotenv line is almost certainly 'VALUE=...' with the value in the key position — fix the \
source file. Nothing was written or logged for it."
            skipped=$((skipped+1))
            continue
        fi
        if [ $dry_run -eq 1 ]; then
            printf 'would import: %s/%s (%d bytes)\n' "$project" "$key" "${#value}"
        else
            local target="$proj_dir/$key"
            local tmp
            tmp=$(mktemp "$proj_dir/.$key.tmp.XXXXXX") || die "migrate: mktemp failed"
            chmod 600 "$tmp"
            printf '%s' "$value" > "$tmp"
            mv "$tmp" "$target"
            chmod 600 "$target"
            audit "set" "$project" "$(json_array_from_list "$key")" "source=migrate-from-env"
            printf 'imported: %s/%s\n' "$project" "$key"
        fi
        imported=$((imported+1))
    done < "$file"

    if [ $dry_run -eq 1 ]; then
        printf 'vct: DRY-RUN — %d keys would be imported, %d skipped. Source file unchanged.\n' "$imported" "$skipped" >&2
    else
        local migrated="${file}.migrated"
        mv -- "$file" "$migrated"
        printf 'vct: imported %d keys, skipped %d. Source renamed → %s\n' "$imported" "$skipped" "$migrated" >&2
    fi
}

# ---------- recover-blob (Part B) ----------
#
# Given a multi-secret BLOB file (a bare token on line 0 + KEY=value continuation
# lines), split every worth-saving line into its own standalone secret file.
# OPT-IN only — never auto-mutates. Direct file-ops (NOT `vct set`, which would
# reject the blob) but every written key is audit-logged ("recover-blob").
#
# Steps (Opus review #6/#8, ruling #1/#2/#4):
#   1. Idempotency FIRST — if the file is already single-line-clean → exit 0 no-op
#      (no backup, no split). Re-running twice is safe.
#   2. Back up the blob → `.<key>.blob-backup-<ts>` (chmod 600). Nothing destroyed.
#   3. Classify line 0 — if `^(export )?WORD=` it is itself a KEY= line (extract to
#      its own key; WARN the base key had no bare token). Else line 0 = base value.
#   4. Split ALL `(export )?KEY=value` lines → key `KEY`, value only (awk first-`=`
#      split preserves `==` base64 padding + `=` inside the value).
#   5. Collision — if an extracted KEY already exists standalone: same hash → drop
#      (redundant); differ → KEEP standalone, emit a CANONICAL UPDATE_DEFERRED entry.
#   6. Verify post-split shapes (single-line, predicate-ok) without printing.
#   7. Print a summary (key names only). NEVER print a secret value.

# _recover_one_blob PROJECT KEY FILEPATH → recover a single blob file in place.
# Returns 0 on success (recovered or idempotent no-op), non-zero on hard error.
_recover_one_blob() {
    local project="$1" key="$2" src="$3"
    local scope_dir; scope_dir=$(dirname "$src")

    # (1) Idempotency: already single-line-clean → no-op.
    local cur reason
    cur=$(cat -- "$src"; printf x); cur=${cur%x}
    if reason=$(_is_single_line_secret "$cur" "$key" 0); then
        printf 'vct: recover-blob: %s/%s is already single-line-clean — nothing to do.\n' \
            "$project" "$key" >&2
        unset cur
        return 0
    fi
    # A control_char / length-corruption single-line value is NOT a splittable
    # blob — recovery is manual. Guard: only proceed for multi-line blobs.
    local tax
    tax=$(_classify_secret_value "$cur" "$key")
    if [ "$tax" = "length_corruption" ]; then
        warn "recover-blob: $project/$key is length_corruption (malformed single-line token, \
reason: $reason) — nothing to split. Re-issue or delete the token manually."
        unset cur
        return 1
    fi

    # (2) Back up before any mutation.
    local ts backup
    ts=$(date -u +%Y%m%dT%H%M%SZ)
    backup="$scope_dir/.$key.blob-backup-$ts"
    cp -- "$src" "$backup"
    chmod 600 "$backup"
    printf 'vct: recover-blob: backed up %s/%s → %s\n' "$project" "$key" "$(basename "$backup")" >&2

    # Normalise line endings for splitting (same as the predicate's line model).
    local normalized
    normalized=$(printf '%s' "$cur" | _secret_shape_normalize_lines)
    unset cur

    # (3)+(4) Walk the lines. Line 0: bare token → base key; else if `KEY=` →
    # extract as its own key (warn: base had no bare token). Lines 1+: every
    # `(export )?KEY=` continuation → extracted. `written_keys` holds ONLY the
    # extracted continuation keys (NOT the base key, which targets `src` itself).
    local -a written_keys=()
    local base_had_token=0
    local n=0 line
    # Collect extracted value files in a private work dir so a value never lives
    # in a variable longer than necessary and is never echoed.
    local work; work=$(mktemp -d "$scope_dir/.recover.$key.XXXXXX") || { warn "recover-blob: mktemp -d failed"; return 1; }
    chmod 700 "$work"

    while IFS= read -r line || [ -n "$line" ]; do
        if [ "$n" -eq 0 ]; then
            if [[ "$line" =~ $_SECRET_SHAPE_BLOB_RE ]]; then
                # Line 0 is itself a KEY= line → the base key had no bare token.
                warn "recover-blob: $project/$key line 0 is a 'KEY=' line (no bare base token) \
— likely fully misfiled; extracting it as its own key."
                _recover_extract_kv "$line" "$work" written_keys
            else
                # Line 0 is the base-key value (bare token) — recorded for the
                # in-place base rewrite below (NOT added to written_keys).
                base_had_token=1
            fi
        else
            if [[ "$line" =~ $_SECRET_SHAPE_BLOB_RE ]]; then
                _recover_extract_kv "$line" "$work" written_keys
            fi
            # Non-KEY= continuation lines (blank, comments, base64 fragments) are
            # dropped — they are not standalone secrets. The full original is
            # preserved in the backup for manual inspection.
        fi
        n=$((n + 1))
    done < <(printf '%s' "$normalized")

    # (5) Install each EXTRACTED continuation key — collision-aware. (The base
    # key is handled separately below since its target is `src` itself.)
    local recovered=0 dropped=0 deferred=0 kept=0
    local wk wpath standalone
    for wk in "${written_keys[@]}"; do
        wpath="$work/$wk"
        [ -f "$wpath" ] || continue
        standalone="$scope_dir/$wk"
        if [ "$standalone" = "$src" ]; then
            # An extracted key whose name equals the blob's own key. Skip the
            # collision path — the base-rewrite below owns `src`. (Rare: a KEY=
            # line inside the blob repeats the file's own key name.)
            dropped=$((dropped + 1))
            continue
        fi
        if [ -f "$standalone" ]; then
            if cmp -s -- "$wpath" "$standalone"; then
                # Same value → drop the extracted copy (redundant).
                dropped=$((dropped + 1))
            else
                # Differ → KEEP standalone, never overwrite. Emit canonical deferral.
                kept=$((kept + 1))
                if emit_blob_collision_deferral "$wk" "$backup"; then
                    deferred=$((deferred + 1))
                fi
            fi
        else
            # No collision → install the extracted key.
            mv -- "$wpath" "$standalone"
            chmod 600 "$standalone"
            audit "recover-blob" "$project" "$(json_array_from_list "$wk")" "source=$key"
            recovered=$((recovered + 1))
        fi
    done

    # Clean the work dir (any leftover / redundant value files removed).
    rm -rf -- "$work"

    # (6) Base key: if line 0 was a bare token, rewrite `src` to hold ONLY that
    # token (the blob file becomes a clean single-line secret). If line 0 was
    # itself a KEY= line we already extracted it; leave the original in place
    # (backed up) + warn, since blindly deleting it could lose unreconciled data.
    if [ "$base_had_token" -eq 1 ]; then
        local token
        token=$(printf '%s' "$normalized" | sed -n '1p')
        printf '%s' "$token" > "$src"
        chmod 600 "$src"
        audit "recover-blob" "$project" "$(json_array_from_list "$key")" "base-token"
        # Confirm it's clean now (never print the value).
        local check
        check=$(cat -- "$src"; printf x); check=${check%x}
        if ! _is_single_line_secret "$check" "$key" 0 >/dev/null; then
            warn "recover-blob: $project/$key still not single-line-clean after split — inspect $backup"
        fi
        unset check token
    else
        warn "recover-blob: $project/$key had no bare base token (line 0 was a KEY= line). \
The original file is left in place and backed up at $(basename "$backup"); review + revoke it \
manually once you've confirmed every embedded key was recovered."
    fi
    unset normalized

    # (7) Summary (key names only).
    printf 'vct: recover-blob: %s/%s — recovered %d key(s), %d redundant dropped, %d collision(s) kept-standalone (%d deferred). Backup: %s\n' \
        "$project" "$key" "$recovered" "$dropped" "$kept" "$deferred" "$(basename "$backup")" >&2
    return 0
}

# _recover_extract_kv LINE WORKDIR WRITTEN_KEYS_ARRAYNAME — split a single
# `(export )?KEY=value` line, write value → WORKDIR/KEY (chmod 600), append KEY
# to the named array. First-`=` split via awk (preserves `==` + `=` in value).
# Never echoes the value.
_recover_extract_kv() {
    local line="$1" work="$2" arrname="$3"
    # Strip a leading `export ` (with the intervening blanks) from the key side.
    local kv="$line"
    case "$kv" in
        export[[:blank:]]*) kv=$(printf '%s' "$kv" | sed 's/^export[[:blank:]][[:blank:]]*//') ;;
    esac
    # First-`=` split.
    local ekey eval
    ekey=$(printf '%s' "$kv" | awk '{ i=index($0,"="); if (i>0) print substr($0,1,i-1) }')
    # value = everything after the first `=`.
    eval=$(printf '%s' "$kv" | awk '{ i=index($0,"="); if (i>0) print substr($0,i+1) }')
    # Validate the extracted key name (path-safe, [A-Za-z0-9_.-], 1..128).
    if [ -z "$ekey" ] || [ "${#ekey}" -gt 128 ]; then
        warn "recover-blob: skipping unparseable KEY= line (invalid key length)"
        return 0
    fi
    case "$ekey" in
        *..*|*/*|.*|-*) warn "recover-blob: skipping unsafe extracted key: $(redact_name "$ekey")"; return 0 ;;
    esac
    if printf '%s' "$ekey" | LC_ALL=C grep -q '[^A-Za-z0-9_.-]'; then
        warn "recover-blob: skipping extracted key with invalid chars: $(redact_name "$ekey")"
        return 0
    fi
    # CREATE boundary — the extracted key becomes a FILENAME. A blob whose
    # continuation line reads `<token>=<something>` would otherwise mint a
    # credential-shaped filename out of file content. Skip it; the full
    # original stays in the backup for manual inspection.
    if is_credential_shaped_name "$ekey"; then
        warn "recover-blob: skipping an extracted key whose NAME has the shape of a live \
credential (name not echoed). Inspect the backup by hand — that line is probably a value, not a \
KEY=VALUE pair."
        return 0
    fi
    printf '%s' "$eval" > "$work/$ekey"
    chmod 600 "$work/$ekey"
    unset eval
    # Append to the caller's array by name (bash nameref-free for 3.2 compat).
    eval "$arrname+=(\"\$ekey\")"
}

cmd_recover_blob() {
    local project="" key="" fix_all=0
    while [ $# -gt 0 ]; do
        case $1 in
            --project) project=$2; shift 2 ;;
            --key) key=$2; shift 2 ;;
            # --shared is the default scope (an explicit alias for "no --project").
            --shared) project=""; shift ;;
            --all) fix_all=1; shift ;;
            -h|--help) cmd_help; return 0 ;;
            *) die "recover-blob: unknown arg: $1 (expected [--key KEY] [--project NAME | --shared] [--all])" ;;
        esac
    done
    ensure_root

    # Resolve the scope directory.
    local scope_dir scope_label
    if [ -n "$project" ]; then
        validate_name "project" "$project"
        scope_dir="$VCT_SECRETS_DIR/projects/$project"
        scope_label="$project"
    else
        # Default (and --shared) → shared scope.
        scope_dir="$VCT_SECRETS_DIR/shared"
        scope_label="shared"
        project="shared"
    fi

    if [ ! -d "$scope_dir" ]; then
        die_code 2 "recover-blob: no such scope directory for $scope_label"
    fi

    if [ -n "$key" ]; then
        validate_name "key" "$key"
        local src="$scope_dir/$key"
        [ -f "$src" ] || die_code 2 "recover-blob: not found — $scope_label/$key"
        _recover_one_blob "$scope_label" "$key" "$src"
        return $?
    fi

    if [ "$fix_all" -eq 1 ]; then
        # Scan every regular file in the scope; recover the ones the predicate
        # flags as blobs. Skip dotfiles, _README.md, and existing backups.
        local f base processed=0
        for f in "$scope_dir"/*; do
            [ -f "$f" ] || continue
            base=$(basename "$f")
            case "$base" in .*|_README.md) continue ;; esac
            local v
            v=$(cat -- "$f"; printf x); v=${v%x}
            if _is_single_line_secret "$v" "$base" 0 >/dev/null; then
                unset v; continue   # already clean
            fi
            unset v
            # Only auto-recover splittable blobs (not length_corruption).
            local tx; tx=$(cat -- "$f"; printf x); tx=${tx%x}
            local tcls; tcls=$(_classify_secret_value "$tx" "$base"); unset tx
            [ "$tcls" = "blob" ] || continue
            _recover_one_blob "$scope_label" "$base" "$f"
            processed=$((processed + 1))
        done
        printf 'vct: recover-blob --all: processed %d blob(s) in %s.\n' "$processed" "$scope_label" >&2
        return 0
    fi

    die "recover-blob: pass --key KEY to recover one blob, or --all to scan the scope"
}

# can-read — probe whether a key resolves, without reading the value.
# Exit 0 = resolvable, 1 = not. Prints nothing (script-friendly).
cmd_can_read() {
    local project="" key=""
    while [ $# -gt 0 ]; do
        case $1 in
            --project) project=$2; shift 2 ;;
            --key) key=$2; shift 2 ;;
            -h|--help) cmd_help; return 0 ;;
            *) die "can-read: unknown arg: $1 (expected --key KEY [--project NAME])" ;;
        esac
    done
    [ -n "$project" ] || project="shared"
    [ -n "$key" ]     || die "can-read: --key required"
    validate_name "project" "$project"
    validate_name "key" "$key"
    ensure_root
    if resolve_secret "$project" "$key" >/dev/null; then
        return 0
    fi
    return 1
}

# resolve — print the file path the resolver would pick (project scope
# wins over shared). Never prints the value. Exit 2 if not found.
cmd_resolve() {
    local project="" key=""
    while [ $# -gt 0 ]; do
        case $1 in
            --project) project=$2; shift 2 ;;
            --key) key=$2; shift 2 ;;
            -h|--help) cmd_help; return 0 ;;
            *) die "resolve: unknown arg: $1 (expected --key KEY [--project NAME])" ;;
        esac
    done
    [ -n "$project" ] || project="shared"
    [ -n "$key" ]     || die "resolve: --key required"
    validate_name "project" "$project"
    validate_name "key" "$key"
    ensure_root
    local path
    if ! path=$(resolve_secret "$project" "$key"); then
        die_miss "resolve" 2 "$project" "$key"
    fi
    printf '%s\n' "$path"
}

# GitHub-token shape check used by doctor. Reads ONLY the file content
# of github_pat-named keys; emits warnings, never the value.
# Known shapes (2026):
#   classic PAT       ghp_[A-Za-z0-9]{36}        (40 chars)
#   fine-grained PAT  github_pat_[A-Za-z0-9_]{82} (93 chars)
#   App installation  ghs_[A-Za-z0-9]{36}        (40 chars)
#   OAuth token       gho_[A-Za-z0-9]{36}        (40 chars)
#
# Part C taxonomy: before the known-shape regex, classify the value's
# corruption MODE via the shared predicate so the remediation is right:
#   * blob              → several secrets glued together → `vct recover-blob`
#                         can split them (a `printf | vct set` re-set can't
#                         recover the other embedded keys, and post-Part-A
#                         `vct set` would REJECT the blob anyway).
#   * length_corruption → a single-line malformed/partial token (nothing to
#                         split) → manual re-issue or delete.
#   * legit_multiline   → an allowlisted PEM/cert/OpenSSH under a github_pat
#                         name is unusual but structurally valid → note, don't
#                         flag as corrupt.
#   * ok                → fall through to the known-GitHub-shape regex.
_doctor_check_github_pat_shape() {
    local f=$1
    local raw val len key scope_flag
    key=$(basename "$f")
    # The scope flag to quote back in every remediation below, derived ONCE
    # from the file's own location. Two of these strings used to be wrong:
    # the length_corruption arm emitted `vct set --key KEY` with no scope at
    # all (dies "--project required"), and the embedded-whitespace arm
    # hardcoded `--project shared` — the exact misfiling invocation this
    # release fixes, recommended by the tool's own doctor even for a
    # project-scoped file. A remediation you cannot paste is not a
    # remediation.
    if [ "${f#*/shared/}" != "$f" ]; then
        scope_flag="--shared"
    else
        scope_flag="--project $(basename "$(dirname "$f")")"
    fi
    # Read the RAW content (control chars / newlines intact) for the taxonomy;
    # never print it.
    raw=$(cat -- "$f"; printf x); raw=${raw%x}

    # Empty file — flag distinctly (no shape to classify).
    val="$raw"
    while [ "${val%$'\n'}" != "$val" ]; do val=${val%$'\n'}; done
    len=${#val}
    if [ "$len" -eq 0 ]; then
        warn "token-shape: $f is EMPTY"
        return 1
    fi

    # Part C: classify the corruption mode.
    local tax
    tax=$(_classify_secret_value "$raw" "$key")
    case "$tax" in
        blob)
            warn "token-shape: $f is a BLOB (several secrets glued together, $len+ chars). gh/git \
gets a multi-line 'password' and auth fails silently. Recover the embedded keys with: \
vct recover-blob --key $key $scope_flag"
            return 1
            ;;
        length_corruption)
            warn "token-shape: $f is LENGTH-CORRUPTION (a single-line malformed/partial token, \
$len chars — nothing to split). Manual fix: re-issue or delete the token, then re-set with: \
printf %s \"\$TOKEN\" | vct set $scope_flag --key $key"
            return 1
            ;;
        legit_multiline)
            warn "token-shape: $f is a legitimate multi-line secret (PEM/cert/OpenSSH) stored \
under a github_pat name — unusual but structurally valid; not a GitHub token."
            return 1
            ;;
    esac

    # tax == ok → single-line, well-formed shape. Keep the pre-existing
    # embedded-whitespace guard (a single interior space is single-line but
    # still breaks gh/git) then the known-GitHub-shape regex.
    case "$val" in
        *' '*|*$'\t'*|*$'\n'*|*$'\r'*)
            warn "token-shape: $f contains embedded whitespace/newlines ($len chars) — gh/git will reject it. Re-set with: printf %s \"\$TOKEN\" | vct set $scope_flag --key $key"
            return 1
            ;;
    esac
    if printf '%s' "$val" | LC_ALL=C grep -qE '^ghp_[A-Za-z0-9]{36}$|^ghs_[A-Za-z0-9]{36}$|^gho_[A-Za-z0-9]{36}$|^github_pat_[A-Za-z0-9_]{36,255}$'; then
        return 0
    fi
    warn "token-shape: $f ($len chars) does not match any known GitHub token shape (ghp_/ghs_/gho_ 40 chars, github_pat_ fine-grained). It may be corrupted or a different credential stored under a github_pat name."
    return 1
}

# ---------- doctor: misfiled shared-scope secrets (already-damaged stores) ----------
#
# Before `set --shared` existed, `vct set --project shared --key K` wrote
# projects/shared/K. No consumer of the shared namespace reads that path, so
# such a secret is inert: present, reported as stored, and never served.
# Stores created before this release may hold any number of them.
#
# WHY DETECT-AND-TELL BY DEFAULT, NEVER AUTO-MIGRATE:
#   1. `doctor` without an explicit --fix-* flag never mutates a secret. That
#      invariant predates this change (--fix-shape established it) and is
#      documented in `vct help`; quietly moving credentials would break it.
#   2. projects/shared/ is AMBIGUOUS. It is the misfiling spot, but it is
#      also where a project legitimately named "shared" would live. Nothing
#      on disk distinguishes the two. Only the user knows, so only the user
#      can authorise the move — which is exactly what passing the flag is.
#   3. A collision is a human decision. If shared/K already exists with a
#      different value, no rule picks the winner. The store's established
#      answer for that class (recover-blob) is: keep what is there, never
#      overwrite, report. Same answer here.
#
# WHY OFFER THE MOVE AT ALL, rather than detect-only: the alternative the user
# would otherwise type is `vct get ... | vct set ...` followed by a delete —
# which routes the value through a pipe, leaves it in two places mid-way, and
# can lose it if the second step fails. `mv` inside one store root is a
# rename(2): one inode, atomic, cannot duplicate, cannot lose, and never reads
# the value. Handing the user the safe move is strictly better than leaving
# them to improvise an unsafe one.
#
# Returns the number of misfiled keys still needing attention.
_doctor_check_misfiled_shared() {
    local do_fix="$1"
    local misdir="$VCT_SECRETS_DIR/projects/shared"
    [ -d "$misdir" ] || { printf '0'; return 0; }

    local f base pending=0 moved=0 collided=0
    for f in "$misdir"/*; do
        [ -f "$f" ] || continue
        base=$(basename "$f")
        case "$base" in .*|_README.md) continue ;; esac
        local dest="$VCT_SECRETS_DIR/shared/$base"
        if [ "$do_fix" -eq 1 ]; then
            if [ -e "$dest" ]; then
                # NEVER overwrite. Both copies are preserved; the user decides.
                warn "shared-scope: $misdir/$(redact_name "$base") and $dest BOTH exist and were \
not compared — refusing to overwrite. Keep the correct one by hand, then delete the other."
                collided=$((collided + 1))
                pending=$((pending + 1))
            else
                mkdir -p "$VCT_SECRETS_DIR/shared"
                chmod 700 "$VCT_SECRETS_DIR/shared"
                # Atomic rename inside one store root: one inode, never two
                # copies, never zero. The value is never read.
                if mv -- "$f" "$dest"; then
                    chmod 600 "$dest"
                    audit "promote-shared" "shared" "$(json_array_from_list "$base")" "from=projects/shared"
                    printf 'vct: shared-scope: moved %s → %s\n' \
                        "$(redact_name "$base")" "$dest" >&2
                    moved=$((moved + 1))
                else
                    warn "shared-scope: could not move $misdir/$(redact_name "$base") → $dest \
(left untouched)"
                    pending=$((pending + 1))
                fi
            fi
        else
            warn "shared-scope: $f is misfiled — nothing that reads the SHARED namespace looks \
in projects/shared/ (not the per-project resolver, not vct_secrets_resolve.sh, not \
agent_secrets, not git-credential-vct). It was almost certainly written by the pre-fix \
'vct set --project shared'. Move it with: vct doctor --fix-shared-scope"
            pending=$((pending + 1))
        fi
    done

    if [ "$do_fix" -eq 1 ] && [ $((moved + collided)) -gt 0 ]; then
        printf 'vct: shared-scope: %d moved, %d collision(s) left for you to reconcile.\n' \
            "$moved" "$collided" >&2
        # Only remove the directory when it is genuinely empty — rmdir refuses
        # otherwise, which is the behaviour we want (never recursive).
        rmdir -- "$misdir" 2>/dev/null || true
    fi
    printf '%d' "$pending"
    return 0
}

# ---------- doctor: a SECOND, possibly stale, deployed copy of this CLI ----------
#
# `vct` is deployed by COPY (the documented setup is "copy it from
# tools/vct-secrets/"), and NOTHING refreshes that copy — not install.py, not
# the launcher, not `--update`. A copy taken once and never touched keeps
# working, keeps printing a plausible version, and silently lacks every guard
# added since. A user whose store copy predates the write-time guards should
# learn that from this tool, not from an incident.
#
# The check is CODE-only: it compares the running script with the copy in the
# store by content and by capability stamp. It never reads a secret, and it
# NEVER overwrites the deployed copy — that file lives in the user's secrets
# directory, and refreshing it is the user's deliberate act, so we print the
# exact command instead of running it.
#
# Returns the number of issues found.
_doctor_check_deployed_copy() {
    local store_cli="$VCT_SECRETS_DIR/vct"
    [ -f "$store_cli" ] || { printf '0'; return 0; }

    local running="$_VCT_SELF_DIR/vct"
    # Same file (the normal case when running the deployed copy itself) → done.
    if [ "$store_cli" -ef "$running" ] 2>/dev/null; then
        # Running FROM the store. Then the store copy is the live one, and the
        # thing worth checking is whether it can even find its predicate lib.
        printf '0'
        return 0
    fi

    local issues=0
    if cmp -s -- "$store_cli" "$running" 2>/dev/null; then
        printf '0'
        return 0
    fi

    warn "deployed-copy: a SECOND copy of this CLI lives at $store_cli and differs from the one \
you just ran ($running). Whichever one is first on your PATH decides which guards apply."
    issues=$((issues + 1))

    # Capability diff — name the guards the deployed copy is missing. A copy
    # predating the stamp has no VCT_GUARDS line at all, which is itself the
    # loudest possible signal.
    local g
    if ! grep -q '^VCT_GUARDS=' -- "$store_cli" 2>/dev/null; then
        warn "deployed-copy: $store_cli predates the guard capability stamp entirely — it is \
missing ALL of: $VCT_GUARDS"
    else
        local missing=""
        for g in $VCT_GUARDS; do
            grep -q -- "$g" "$store_cli" 2>/dev/null || missing="$missing $g"
        done
        [ -n "$missing" ] && warn "deployed-copy: $store_cli is missing guard(s):$missing"
    fi

    # A copy of the single file without lib/ cannot start at all on a current
    # release — worth naming, because "I copied vct" is the usual way to get here.
    # BOTH shared libs are required; a deployed copy predating
    # lib/credential_shapes.sh hits the same loud-fail gate, so name whichever
    # one is actually missing.
    for _dc_lib in secret_shape.sh credential_shapes.sh; do
        if [ ! -r "$VCT_SECRETS_DIR/lib/$_dc_lib" ]; then
            warn "deployed-copy: $VCT_SECRETS_DIR/lib/$_dc_lib is absent, so a current \
release copied into the store would refuse to start. Copy the TREE, not the file."
        fi
    done
    unset _dc_lib

    warn "deployed-copy: not touching it — it is inside your secrets directory. Refresh it \
yourself with EITHER of:
    ln -sfn $_VCT_SELF_DIR/vct ~/.local/bin/vct        # preferred: cannot go stale
    cp -a $_VCT_SELF_DIR/. $VCT_SECRETS_DIR/           # copy the whole tree, incl. lib/"
    printf '%d' "$issues"
    return 0
}

cmd_doctor() {
    local fix_shape=0 fix_shared_scope=0
    while [ $# -gt 0 ]; do
        case $1 in
            --fix-shape) fix_shape=1; shift ;;
            --fix-shared-scope) fix_shared_scope=1; shift ;;
            -h|--help) cmd_help; return 0 ;;
            *) die "doctor: unknown arg: $1 (expected [--fix-shape] [--fix-shared-scope])" ;;
        esac
    done
    ensure_root
    local issues=0 fixed=0
    # Check root dir
    local mode
    mode=$(stat -c '%a' "$VCT_SECRETS_DIR" 2>/dev/null || echo "")
    if [ "$mode" != "700" ]; then
        warn "root $VCT_SECRETS_DIR has mode $mode; fixing → 700"
        chmod 700 "$VCT_SECRETS_DIR"
        fixed=$((fixed+1))
    fi
    # Check subdirs
    local d
    while IFS= read -r d; do
        [ -z "$d" ] && continue
        mode=$(stat -c '%a' "$d" 2>/dev/null || echo "")
        if [ "$mode" != "700" ]; then
            warn "dir $d has mode $mode; fixing → 700"
            chmod 700 "$d"
            fixed=$((fixed+1))
        fi
    done < <(find "$VCT_SECRETS_DIR" -type d)
    # Check files (never read contents)
    local f
    while IFS= read -r f; do
        [ -z "$f" ] && continue
        # Skip CLI itself (needs +x) and tests dir scripts.
        # NOTE: the legacy `search-mcp-wrapper.sh` skip-arm was removed in
        # v0.2.54 (S-6) — that wrapper was retired in 0.1.7; stale copies
        # inside the store should be locked down like any other file.
        case "$f" in
            */vct|*/tests/*|*/migrate-shared.sh|*/git-credential-vct)
                continue ;;
        esac
        mode=$(stat -c '%a' "$f" 2>/dev/null || echo "")
        if [ "$mode" != "600" ]; then
            warn "file $f has mode $mode; fixing → 600"
            chmod 600 "$f"
            fixed=$((fixed+1))
        fi
    done < <(find "$VCT_SECRETS_DIR" -type f)

    # GitHub-token shape check (v0.2.54 S-3/S-4 sibling): wrong-shape
    # github_pat entries cost real debugging time (the "401 Bad
    # credentials with a 330-char blob" class). Check any key named
    # github_pat or github_pat.* in shared/ and projects/*/.
    #
    # With --fix-shape: for any BLOB-classified github_pat file, actively run
    # the recovery (Part B) instead of only warning. length_corruption /
    # legit_multiline are NOT auto-fixed (nothing to split / nothing wrong) —
    # they still warn. A doctor run WITHOUT --fix-shape never mutates a secret.
    local recovered_blobs=0
    while IFS= read -r f; do
        [ -z "$f" ] && continue
        if ! _doctor_check_github_pat_shape "$f"; then
            issues=$((issues+1))
            if [ "$fix_shape" -eq 1 ]; then
                # Only splittable blobs are auto-recovered.
                local raw tax
                raw=$(cat -- "$f"; printf x); raw=${raw%x}
                tax=$(_classify_secret_value "$raw" "$(basename "$f")")
                unset raw
                if [ "$tax" = "blob" ]; then
                    # Derive scope + key from the path.
                    local base scope proj
                    base=$(basename "$f")
                    if [ "${f#*/shared/}" != "$f" ]; then
                        scope="shared"; proj="shared"
                    else
                        # projects/<name>/<key>
                        proj=$(basename "$(dirname "$f")")
                        scope="$proj"
                    fi
                    if _recover_one_blob "$scope" "$base" "$f"; then
                        recovered_blobs=$((recovered_blobs + 1))
                    fi
                fi
            fi
        fi
    done < <(find "$VCT_SECRETS_DIR/shared" "$VCT_SECRETS_DIR/projects" \
                  -type f \( -name 'github_pat' -o -name 'github_pat.*' \) 2>/dev/null)

    # Credential-shaped key NAMES already on disk (a store damaged before the
    # name-shape guard existed). Report the COUNT and the containing directory
    # only — never the name, which IS the credential. `vct list` still prints
    # names verbatim, so the user has a way to see and revoke them; this is the
    # detection that tells them to go look.
    local shaped=0 sf sdir
    while IFS= read -r sf; do
        [ -z "$sf" ] && continue
        if is_credential_shaped_name "$(basename "$sf")"; then
            shaped=$((shaped + 1))
            sdir=$(dirname "$sf")
        fi
    done < <(find "$VCT_SECRETS_DIR/shared" "$VCT_SECRETS_DIR/projects" -type f 2>/dev/null)
    if [ "$shaped" -gt 0 ]; then
        warn "name-shape: $shaped secret file(s) have a NAME with the shape of a live credential \
(names not echoed; last seen under $sdir). That happens when a VALUE was passed where the --key \
NAME belongs. Those credentials are on disk as FILENAMES and in older audit.log rows. \
Rotate them, then remove each with: vct list [--project NAME] ; vct revoke ... --key <name> --yes"
        issues=$((issues + shaped))
    fi

    # Store-integrity checks that are reported, and only repaired on request.
    local misfiled deployed
    misfiled=$(_doctor_check_misfiled_shared "$fix_shared_scope")
    issues=$((issues + misfiled))
    deployed=$(_doctor_check_deployed_copy)
    issues=$((issues + deployed))

    if [ "$fix_shape" -eq 1 ]; then
        printf 'vct doctor: %d perms fixed, %d shape issue(s) found, %d blob(s) recovered.\n' \
            "$fixed" "$issues" "$recovered_blobs" >&2
    else
        printf 'vct doctor: %d issues fixed, %d remaining.\n' "$fixed" "$issues" >&2
    fi
    return 0
}

cmd_detect_project() {
    local cur
    cur=$(pwd -P)
    while [ "$cur" != "/" ] && [ -n "$cur" ]; do
        if [ -f "$cur/.vct-project" ]; then
            local name
            name=$(head -n1 "$cur/.vct-project" | tr -d '[:space:]')
            if [ -n "$name" ]; then
                printf '%s\n' "$name"
                return 0
            fi
        fi
        cur=$(dirname "$cur")
    done
    die_code 1 "detect-project: no .vct-project file found walking up from $(pwd -P)"
}

# ---------- Dispatcher ----------
main() {
    if [ $# -eq 0 ]; then
        cmd_help
        exit 0
    fi
    # Accept both `vct <cmd>` and `vct secret <cmd>`
    if [ "$1" = "secret" ]; then
        shift
        if [ $# -eq 0 ]; then cmd_help; exit 0; fi
    fi
    local sub=$1; shift
    case "$sub" in
        list)              cmd_list "$@" ;;
        set)               cmd_set "$@" ;;
        get)               cmd_get "$@" ;;
        exec)              cmd_exec "$@" ;;
        can-read)          cmd_can_read "$@" ;;
        resolve)           cmd_resolve "$@" ;;
        revoke)            cmd_revoke "$@" ;;
        copy)              cmd_copy "$@" ;;
        migrate-from-env)  cmd_migrate_from_env "$@" ;;
        recover-blob)      cmd_recover_blob "$@" ;;
        doctor)            cmd_doctor "$@" ;;
        detect-project)    cmd_detect_project "$@" ;;
        help|--help|-h)    cmd_help ;;
        version|--version) cmd_version ;;
        *) die "unknown subcommand: $sub (try 'vct help')" ;;
    esac
}

main "$@"
