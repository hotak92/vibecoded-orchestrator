#!/usr/bin/env bash
# vct — VCT Secrets Primitive CLI (Phase 1, Bash)
# Per-project secret store with project-first resolution + audit log.
# Design: docs/VCT_SECRETS_PRIMITIVE.md (in the vibecoded-orchestrator repo)
#
# Root: $VCT_SECRETS_DIR (default: ~/.vct-secrets)
#   projects/<NAME>/<KEY>  — per-project secret files (chmod 600)
#   shared/<KEY>           — cross-project fallback
#   audit.log              — append-only JSON-lines log
#
# Safety: umask 077, no secrets on argv, no secrets in logs. The store itself
# never touches the network; the ONLY network access is a bounded, read-only,
# localhost-only vct-hub probe on a file-store MISS (v0.2.76 R4) purely to make
# the miss message honest — it never fetches or writes a value and soft-fails
# silently when the hub is absent/unreachable. v0.2.91: that probe may make ONE
# extra bounded request when a PROVABLY-stale $VCT_HUB_TOKEN was refused
# (401/403) and the on-disk hub.token differs — set VCT_HUB_TOKEN_STRICT=1 to
# disable. Still read-only, still localhost, still never a value in a log.

set -u
umask 077

# ---------- Configuration ----------
VCT_SECRETS_DIR="${VCT_SECRETS_DIR:-$HOME/.vct-secrets}"
AUDIT_LOG="$VCT_SECRETS_DIR/audit.log"
VERSION="0.1.0-phase1"

# ---------- Shared secret-shape predicate (bash mirror of the Python SSOT) ----------
# tools/vct-secrets/lib/secret_shape.sh defines _is_single_line_secret() and
# _classify_secret_value(), the bash mirror of vco_lib/secret_value_shape.py
# (locked by tests/fixtures/secret_value_shape_parity.json). ONE copy, sourced
# by both this CLI and migrate-shared.sh (SHARED-CODE RULE — no duplication).
# The lib lives next to this script even when `vct` is deployed to
# ~/.vct-secrets/vct (install materialises the whole tools/vct-secrets tree).
# CDPATH= prefixes the `cd` (neutralises a user CDPATH); not a var assignment.
# shellcheck disable=SC1007
_VCT_SELF_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]:-$0}")" && pwd)
# shellcheck source=lib/secret_shape.sh
if [ -r "$_VCT_SELF_DIR/lib/secret_shape.sh" ]; then
    . "$_VCT_SELF_DIR/lib/secret_shape.sh"
else
    # Loud-fail: a broken deployment missing the shared predicate must NOT
    # silently write unguarded (the write-time guard is the whole point).
    printf 'vct: error: shared predicate missing at %s/lib/secret_shape.sh — broken install\n' \
        "$_VCT_SELF_DIR" >&2
    exit 1
fi

# Env vars to preserve into child when not --preserve-env.
# Covers locale, terminal, PATH, home — drops everything else.
PRESERVE_ENV_VARS=(PATH HOME USER LOGNAME TERM LANG SHELL PWD TMPDIR)

# ---------- Utility ----------
die() { printf 'vct: error: %s\n' "$*" >&2; exit 1; }
die_code() { local c=$1; shift; printf 'vct: error: %s\n' "$*" >&2; exit "$c"; }
warn() { printf 'vct: warning: %s\n' "$*" >&2; }

# ---------- vct-hub miss-hint probe (v0.2.76 R4) ----------
#
# `vct` reads ONLY the file store. Secrets saved via the launcher GUI live in
# the OS keychain and are served by vct-hub `/env`, NOT by this CLI — so a
# file-store miss for a GUI-saved key used to print `Fix: vct set …`, which,
# if followed, creates a SECOND divergent copy on disk (live bug
# "vct-get-hub-keychain-disjoint"). These helpers let the MISS path ASK the hub
# whether it has the key so the message can point at the resolver instead.
#
# Hub discovery mirrors templates/scripts/vct_secrets_resolve.sh (port/token
# files under $VCT_STATE_DIR, per-project token preferred). Everything here is
# best-effort and MUST soft-fail silently: no curl / no hub / no token / any
# non-200 → treated as "hub doesn't have it", falling back to the old message.
_hub_port() {
    if [ -n "${VCT_HUB_PORT:-}" ]; then printf '%s' "$VCT_HUB_PORT"; return 0; fi
    local state_dir="${VCT_STATE_DIR:-$HOME/.vct}" p
    if [ -f "$state_dir/hub.port" ]; then
        p=$(tr -d '[:space:]' < "$state_dir/hub.port" 2>/dev/null)
        [ -n "$p" ] && { printf '%s' "$p"; return 0; }
    fi
    printf '7700'
}

_hub_token() {
    # $1 = optional project id/slug (prefers the per-project token file).
    # The env pin wins here, as everywhere — only a PROVABLE refusal sets
    # it aside, via `_hub_stale_env_fallback_token` below.
    local project_id="${1:-}"
    if [ -n "${VCT_HUB_TOKEN:-}" ]; then printf '%s' "$VCT_HUB_TOKEN"; return 0; fi
    _hub_token_on_disk "$project_id"
}

# ── Stale-env hub-token fallback (v0.2.91, WP-D item 4) ─────────────────
#
# MUST MATCH the SSOT `vco_lib/project_config.py::_stale_env_token_fallback`
# and the mirrors in `templates/scripts/vct_secrets_resolve.{sh,ps1}`,
# `templates/scripts/vct_project_config.{sh,ps1}`,
# `claude_mcp_servers/wrappers/_base.py` and
# `launcher/tools/vct-cli/src/main.rs`.
#
# WHY here: the hub probe below is best-effort, but a stale exported
# `VCT_HUB_TOKEN` makes it answer "refused (401/403) — key state UNKNOWN"
# on a machine where the on-disk token would have answered definitively.
# One bounded extra request fixes the diagnostic; nothing loops.

# The ONE definitive line. Byte-identical across every mirror.
_VCT_STALE_ENV_TOKEN_MESSAGE="stale VCT_HUB_TOKEN in env overridden by on-disk hub.token — run \`unset VCT_HUB_TOKEN\` or open a new shell"
_VCT_STALE_ENV_WARNED=0

_warn_stale_env_token() {
    # Once per process, on stderr (never stdout — `vct get` pipes stdout).
    if [ "$_VCT_STALE_ENV_WARNED" -eq 0 ]; then
        _VCT_STALE_ENV_WARNED=1
        warn "$_VCT_STALE_ENV_TOKEN_MESSAGE"
    fi
}

_hub_token_on_disk() {
    # $1 = optional project id/slug. Prints the ON-DISK token, IGNORING
    # $VCT_HUB_TOKEN, preserving the scoped-vs-global preference.
    local project_id="${1:-}" state_dir="${VCT_STATE_DIR:-$HOME/.vct}"
    if [ -n "$project_id" ] && [ -r "$state_dir/hub.token.$project_id" ]; then
        tr -d '[:space:]' < "$state_dir/hub.token.$project_id" 2>/dev/null
        return 0
    fi
    if [ -f "$state_dir/hub.token" ]; then
        tr -d '[:space:]' < "$state_dir/hub.token" 2>/dev/null
        return 0
    fi
    printf ''
}

_hub_stale_env_fallback_token() {
    # $1 = optional project id/slug. Prints the on-disk token to retry
    # with and returns 0, or returns 1 (no output). Rules, in order:
    #   1. VCT_HUB_TOKEN_STRICT=1        → 1 (the pin is authoritative)
    #   2. VCT_HUB_TOKEN unset/empty     → 1 (nothing was pinned)
    #   3. no readable on-disk token     → 1 (nothing better to try)
    #   4. on-disk == env (whitespace-normalised) → 1 (pin is not stale)
    local project_id="${1:-}" env_tok disk_tok
    # Trimmed comparison to the literal 1 — the SSOT's spelling, so a
    # `VCT_HUB_TOKEN_STRICT=1` written with a trailing newline/CR means the
    # same thing in bash, PowerShell, Rust and Python.
    [ "$(printf '%s' "${VCT_HUB_TOKEN_STRICT:-}" | tr -d '[:space:]')" = "1" ] \
        && return 1
    env_tok=$(printf '%s' "${VCT_HUB_TOKEN:-}" | tr -d '[:space:]')
    [ -n "$env_tok" ] || return 1
    disk_tok=$(_hub_token_on_disk "$project_id")
    [ -n "$disk_tok" ] || return 1
    [ "$disk_tok" = "$env_tok" ] && return 1
    printf '%s' "$disk_tok"
    return 0
}

# hub_has_key PROJECT KEY → probe the launcher keychain via the hub.
# Exit codes:
#   0  confirmed HIT — the hub served a NON-EMPTY value for KEY on PROJECT.
#   2  hub reachable but the probe was REFUSED (403) or UNAUTHORIZED (401)
#      — the KEY STATE IS UNKNOWN. This is the v0.2.77 flip reality: the
#      probe presents `hub.token.<project>`, but scoped tokens are keyed by
#      launcher PROJECT_ID (a UUID) while PROJECT here is the FILE-STORE
#      NAME, so the scoped file rarely exists → the probe rides the global
#      hub.token → post-flip /env refuses it with 403. A 403/401 must NOT
#      be read as "the hub doesn't have the key" (see die_miss).
#   1  soft-fail — no curl / no hub / no token / any OTHER non-200. Treat
#      as "hub couldn't answer"; caller falls back to the file-store hint.
# Bounded (--max-time 3), localhost-only, token off argv (`--header @-`).
hub_has_key() {
    local project="$1" key="$2"
    command -v curl >/dev/null 2>&1 || return 1
    # "shared" is a file-store scope name, not a launcher project → don't probe.
    [ "$project" = "shared" ] && return 1
    local port token
    port=$(_hub_port)
    token=$(_hub_token "$project")
    [ -n "$token" ] || return 1
    local url="http://127.0.0.1:${port}/api/v1/projects/${project}/env?key=${key}"
    local body status
    body=$(curl --silent --show-error --max-time 3 \
                --header @- --output - --write-out '\n%{http_code}' "$url" \
                <<<"Authorization: Bearer ${token}" 2>/dev/null) || return 1
    status="${body##*$'\n'}"
    body="${body%$'\n'*}"
    # v0.2.91 (WP-D item 4): before classifying a refusal, give the ONE
    # bounded on-disk-token retry a chance — a stale exported
    # VCT_HUB_TOKEN otherwise degrades every probe to "UNKNOWN" on a
    # machine whose hub.token would have answered. Failure of the retry
    # leaves the classification below byte-identical.
    case "$status" in
        403|401)
            local fallback retry retry_status
            if fallback=$(_hub_stale_env_fallback_token "$project"); then
                if retry=$(curl --silent --show-error --max-time 3 \
                                --header @- --output - --write-out '\n%{http_code}' "$url" \
                                <<<"Authorization: Bearer ${fallback}" 2>/dev/null); then
                    retry_status="${retry##*$'\n'}"
                    # ADOPT only an answer that PROVES the fallback
                    # credential was accepted: 2xx, or 404 (the hub answers
                    # "no row" only AFTER its auth middleware accepted the
                    # bearer — a post-auth answer like a 200). Anything
                    # else — 5xx included — proves nothing, so the ORIGINAL
                    # 401/403 stands, this probe still reports UNKNOWN, and
                    # no definitive line is printed (v0.2.91 wave-3,
                    # MINOR-1).
                    case "$retry_status" in
                        2??|404)
                            _warn_stale_env_token
                            status="$retry_status"
                            body="${retry%$'\n'*}"
                            ;;
                        *) : ;;   # not proof — keep the original refusal
                    esac
                fi
            fi
            ;;
    esac
    # v0.2.77 Part 8 Task 4b (option iv): a 403/401 means the hub is up but
    # this probe's credential was refused — the key state is UNKNOWN, NOT a
    # confirmed absence. Signal that distinctly so die_miss withholds the
    # divergent-copy `vct set` hint.
    case "$status" in
        403|401) return 2 ;;
    esac
    [ "$status" = "200" ] || return 1
    # A 200 with an empty/absent value for the key is NOT a hit.
    case "$body" in
        ""|"{}"|"null") return 1 ;;
    esac
    # The value is present in the body — the hub has it. We do NOT parse or
    # print the value (this CLI never resolves keychain values).
    return 0
}

# Emit the correct miss diagnostic for a file-store miss on `verb` and exit `code`.
#
# Three outcomes from the hub probe:
#   * confirmed HIT (0)          → point at the RESOLVER (the keychain has
#                                  it; `vct set` would fork a divergent copy).
#   * reachable-but-refused (2)  → key state UNKNOWN (v0.2.77 flip: the probe
#                                  rode the global token and got 403/401).
#                                  Withhold the `vct set` hint — a wrong-copy
#                                  `vct set` while the keychain MIGHT already
#                                  hold the value is exactly the divergence we
#                                  avoid. Point at the resolver instead, noting
#                                  the probe couldn't confirm.
#   * soft-fail (1)              → hub couldn't answer → classic `vct set` hint.
die_miss() {
    local verb="$1" code="$2" project="$3" key="$4"
    hub_has_key "$project" "$key"
    local probe=$?
    if [ "$probe" -eq 0 ]; then
        die_code "$code" "$verb: not in the file store, but the launcher keychain HAS project=$project key=$key. \
Resolve it via '.claude/scripts/vct_secrets_resolve.sh <project_folder> $key' (or vco_lib.agent_secrets.get('$key')). \
Do NOT 'vct set' it — that creates a second, divergent copy on disk."
    fi
    if [ "$probe" -eq 2 ]; then
        die_code "$code" "$verb: not in the file store. The hub is running but this probe could not confirm the \
launcher keychain (403/401 — the per-project token file hub.token.<project_id> is keyed by the launcher PROJECT ID, \
not the name '$project', so the probe fell back to the global hub.token which the /env route no longer accepts). \
The keychain MAY already hold project=$project key=$key — resolve it via \
'.claude/scripts/vct_secrets_resolve.sh <project_folder> $key' (or vco_lib.agent_secrets.get('$key')). \
Do NOT 'vct set' it blindly — that risks a second, divergent copy on disk."
    fi
    die_code "$code" "$verb: secret not found — project=$project key=$key. Fix: vct set --project $project --key $key"
}

# Reject keys/projects with path-traversal or control chars.
# Allow: [A-Za-z0-9_.-], length 1..128.
validate_name() {
    local kind=$1 val=$2
    if [ -z "$val" ]; then
        die "$kind cannot be empty"
    fi
    if [ "${#val}" -gt 128 ]; then
        die "$kind too long (>128 chars)"
    fi
    case "$val" in
        *..*|*/*|*$'\n'*|*$'\t'*|.*|-*)
            die "$kind contains invalid characters: $val"
            ;;
    esac
    # Reject anything outside [A-Za-z0-9_.-]
    if printf '%s' "$val" | LC_ALL=C grep -q '[^A-Za-z0-9_.-]'; then
        die "$kind contains invalid characters: $val"
    fi
}

ensure_root() {
    if [ ! -d "$VCT_SECRETS_DIR" ]; then
        mkdir -p "$VCT_SECRETS_DIR"
        chmod 700 "$VCT_SECRETS_DIR"
    fi
    mkdir -p "$VCT_SECRETS_DIR/projects" "$VCT_SECRETS_DIR/shared"
    chmod 700 "$VCT_SECRETS_DIR/projects" "$VCT_SECRETS_DIR/shared" 2>/dev/null || true
    if [ ! -f "$AUDIT_LOG" ]; then
        touch "$AUDIT_LOG"
        chmod 600 "$AUDIT_LOG"
    fi
}

# ---------- Canonical deferral bridge (recover-blob collision, ruling #6) ----------
#
# recover-blob's collision handling must NOT hand-roll an UPDATE_DEFERRED writer.
# The canonical emitter is vco_lib.deferral_report (DeferralReport + safe_emit_
# entry), the SAME SSOT the Rust launcher shells out to (services/deferral.rs::
# emit_deferral_entry). deferral_report.py has NO CLI entrypoint, so we invoke it
# via an inline `python - <<PY` heredoc — mirroring the Rust bridge. On ANY
# failure (no python, no repo root, import error, bad target folder) we SOFT-FAIL
# to a clear stderr message (key names only) and never crash recover-blob, never
# fabricate a .claude/ tree in a non-project dir.

# _resolve_vco_python — echo a python interpreter that can import vco_lib, or
# empty on none found. Mirrors resolve_python_for_vco_lib()'s RT-4 ladder:
#   1. $VCT_PYTHON            (explicit override — interpreter binary)
#   2. $VCT_VENV              (venv dir or interpreter binary)
#   3. $VCT_INSTALL_ROOT      (<root>/.venv, <root>/claude_mcp_servers/.venv)
#   4. walk up from this script (≤8 hops) probing the same two venv layouts
#   5. python3 on PATH        (last resort)
_resolve_vco_python() {
    local c
    # 1. $VCT_PYTHON — explicit interpreter path.
    if [ -n "${VCT_PYTHON:-}" ] && [ -x "${VCT_PYTHON}" ]; then
        printf '%s' "$VCT_PYTHON"; return 0
    fi
    # 2. $VCT_VENV — venv dir or interpreter binary.
    if [ -n "${VCT_VENV:-}" ]; then
        for c in "$VCT_VENV/bin/python" "$VCT_VENV/bin/python3" "$VCT_VENV/Scripts/python.exe"; do
            [ -x "$c" ] && { printf '%s' "$c"; return 0; }
        done
        [ -x "${VCT_VENV}" ] && { printf '%s' "$VCT_VENV"; return 0; }
    fi
    # 3. $VCT_INSTALL_ROOT — two known venv layouts.
    if [ -n "${VCT_INSTALL_ROOT:-}" ]; then
        for c in "$VCT_INSTALL_ROOT/.venv/bin/python" "$VCT_INSTALL_ROOT/.venv/bin/python3" \
                 "$VCT_INSTALL_ROOT/claude_mcp_servers/.venv/bin/python" \
                 "$VCT_INSTALL_ROOT/claude_mcp_servers/.venv/bin/python3"; do
            [ -x "$c" ] && { printf '%s' "$c"; return 0; }
        done
    fi
    # 4. Walk up from this script's dir (≤8 hops).
    local cur="$_VCT_SELF_DIR" i
    for i in 1 2 3 4 5 6 7 8; do
        for c in "$cur/.venv/bin/python" "$cur/.venv/bin/python3" \
                 "$cur/claude_mcp_servers/.venv/bin/python" \
                 "$cur/claude_mcp_servers/.venv/bin/python3"; do
            [ -x "$c" ] && { printf '%s' "$c"; return 0; }
        done
        [ "$cur" = "/" ] && break
        cur=$(dirname "$cur")
    done
    # 5. PATH fallback.
    if command -v python3 >/dev/null 2>&1; then
        printf 'python3'; return 0
    fi
    printf ''
    return 1
}

# _resolve_vco_lib_root — echo a directory that contains an importable
# `vco_lib` package (has vco_lib/deferral_report.py), or empty. Checked:
#   1. $VCT_INSTALL_ROOT
#   2. walk up from this script's dir (≤8 hops)
_resolve_vco_lib_root() {
    if [ -n "${VCT_INSTALL_ROOT:-}" ] && [ -f "$VCT_INSTALL_ROOT/vco_lib/deferral_report.py" ]; then
        printf '%s' "$VCT_INSTALL_ROOT"; return 0
    fi
    local cur="$_VCT_SELF_DIR" i
    for i in 1 2 3 4 5 6 7 8; do
        if [ -f "$cur/vco_lib/deferral_report.py" ]; then
            printf '%s' "$cur"; return 0
        fi
        [ "$cur" = "/" ] && break
        cur=$(dirname "$cur")
    done
    printf ''
    return 1
}

# _resolve_deferral_target_folder — echo the project/orchestrator folder whose
# .claude/context/UPDATE_DEFERRED.md the deferral lands in, or empty (rootless).
#   (a) walk up from PWD for a .vct-project → the containing project root
#   (b) else the resolvable vco_lib root (orchestrator/install root)
#   (c) else empty → caller soft-fails to a stderr message
# NEVER fabricate a .claude/ tree — only return a folder that already looks like
# a managed project (has a .vct-project, a .claude/ dir, or is the vco_lib root).
_resolve_deferral_target_folder() {
    local cur
    cur=$(pwd -P 2>/dev/null) || cur=""
    while [ -n "$cur" ] && [ "$cur" != "/" ]; do
        if [ -f "$cur/.vct-project" ] || [ -d "$cur/.claude" ]; then
            printf '%s' "$cur"; return 0
        fi
        cur=$(dirname "$cur")
    done
    local root
    if root=$(_resolve_vco_lib_root) && [ -n "$root" ] && [ -d "$root/.claude" ]; then
        printf '%s' "$root"; return 0
    fi
    printf ''
    return 1
}

# emit_blob_collision_deferral KEY BACKUP_PATH  — route a secret_blob_collision
# through the canonical Python emitter. Key names only; NO values. Soft-fails to
# a stderr message when python / vco_lib root / project folder can't resolve.
emit_blob_collision_deferral() {
    local key="$1" backup="$2"
    local py root folder
    py=$(_resolve_vco_python)
    root=$(_resolve_vco_lib_root)
    folder=$(_resolve_deferral_target_folder)
    if [ -z "$py" ] || [ -z "$root" ] || [ -z "$folder" ]; then
        warn "recover-blob: collision on key '$key' (kept the existing standalone value; \
extracted copy differs). Could not record an UPDATE_DEFERRED entry (no VCO install / project \
folder resolved). Blob backup: $backup. Reconcile the two values manually."
        return 1
    fi
    # Pass all data via argv (never inline into the program text) so a key name
    # can't break the heredoc. The heredoc program reads sys.argv only.
    if "$py" - "$root" "$folder" "$key" "$backup" <<'PY' 2>/dev/null; then
import sys
root, folder, key, backup = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
sys.path.insert(0, root)
from pathlib import Path
from vco_lib.deferral_report import DeferralReport, safe_emit_entry
report = DeferralReport.read(Path(folder))
safe_emit_entry(
    report,
    condition_id="secret_blob_collision",
    title="Secret blob recovery — key collision (standalone kept)",
    detected=(
        f"'vct recover-blob' split a multi-secret blob and found key '{key}' already "
        f"exists as a standalone secret with a DIFFERENT value. The standalone value "
        f"was KEPT (never overwritten); the blob-embedded copy was left in the backup."
    ),
    why_deferred=(
        "The two values differ and recover-blob cannot know which is correct — "
        "resolving requires a human decision."
    ),
    command_to_apply=(
        f"# Compare the standalone value with the blob-embedded copy in the backup, "
        f"then keep the correct one:\n"
        f"#   backup: {backup}\n"
        f"#   key:    {key}\n"
        f"# (values are NOT shown here; inspect the chmod-600 files directly)"
    ),
    severity="warning",
)
report.write(Path(folder))
PY
        printf 'vct: recorded UPDATE_DEFERRED entry (secret_blob_collision) for key %s in %s\n' \
            "$key" "$folder" >&2
        return 0
    fi
    warn "recover-blob: collision on key '$key' (kept the existing standalone value). \
The canonical deferral emitter failed (python/import error). Blob backup: $backup. \
Reconcile the two values manually."
    return 1
}

# JSON-escape a string (minimal: quotes, backslashes, control chars).
json_escape() {
    local s=$1
    s=${s//\\/\\\\}
    s=${s//\"/\\\"}
    s=${s//$'\n'/\\n}
    s=${s//$'\r'/\\r}
    s=${s//$'\t'/\\t}
    printf '%s' "$s"
}

# audit op project keys_array caller_cmd
audit() {
    local op=$1 project=$2 keys=$3 caller_cmd=${4:-}
    local ts
    ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    local line
    line=$(printf '{"ts":"%s","op":"%s","project":"%s","secrets":%s,"caller_pid":%d,"caller_cmd":"%s"}' \
        "$ts" \
        "$(json_escape "$op")" \
        "$(json_escape "$project")" \
        "$keys" \
        "$$" \
        "$(json_escape "$caller_cmd")")
    printf '%s\n' "$line" >> "$AUDIT_LOG"
}

# Build JSON array from space-separated list.
json_array_from_list() {
    local first=1 out='['
    local k
    for k in "$@"; do
        if [ $first -eq 1 ]; then first=0; else out+=','; fi
        out+='"'$(json_escape "$k")'"'
    done
    out+=']'
    printf '%s' "$out"
}

# Resolve path for a secret. Prints the path on stdout; exit 0 if found, 2 if not.
resolve_secret() {
    local project=$1 key=$2
    local p_path="$VCT_SECRETS_DIR/projects/$project/$key"
    local s_path="$VCT_SECRETS_DIR/shared/$key"
    if [ -f "$p_path" ]; then
        printf '%s' "$p_path"
        return 0
    fi
    if [ -f "$s_path" ]; then
        printf '%s' "$s_path"
        return 0
    fi
    return 2
}

