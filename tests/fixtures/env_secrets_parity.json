{
  "_comment": "Cross-language parity fixture for the .env secret auditor + sentinel rewriter — consumed by BOTH tests/test_env_secrets_migrate_parity.py (Python vco_lib.secrets_audit) AND the Rust #[test] env_secrets_parity_matches_shared_fixture in launcher/src-tauri/src/commands/env_secrets_migrate.rs (Rust mirror). audit_expected = list of {key,value} the auditor must return; rewrite = {migrated_keys, expected_text, expected_replaced, expected_missed}. Note the quoted-value-drops-trailing-comment asymmetry both sides share. MUST MATCH between Python + Rust (B-3 fork-risk guard for ~250 lines of security-sensitive .env parsing).",
  "_format_version": 1,
  "cases": [
    {
      "name": "quoted_and_unquoted",
      "input": "# header comment\nexport GITHUB_TOKEN=ghp_realvalue\nOPENAI_API_KEY=\"sk-abc123\"\nDB_PASSWORD='hunter2'\nPLAIN_VAR=not-a-secret\n",
      "audit_expected": [
        {
          "key": "GITHUB_TOKEN",
          "value": "ghp_realvalue"
        },
        {
          "key": "OPENAI_API_KEY",
          "value": "sk-abc123"
        },
        {
          "key": "DB_PASSWORD",
          "value": "hunter2"
        }
      ],
      "rewrite": {
        "migrated_keys": [
          "GITHUB_TOKEN",
          "OPENAI_API_KEY",
          "DB_PASSWORD",
          "ABSENT_TOKEN"
        ],
        "expected_text": "# header comment\nexport GITHUB_TOKEN=__vco_keychain__\nOPENAI_API_KEY=__vco_keychain__\nDB_PASSWORD=__vco_keychain__\nPLAIN_VAR=not-a-secret\n",
        "expected_replaced": 3,
        "expected_missed": [
          "ABSENT_TOKEN"
        ]
      }
    },
    {
      "name": "trailing_comments_quoted_vs_unquoted",
      "input": "A_TOKEN=abc  # inline note\nB_SECRET=\"has # inside quotes\"\nC_TOKEN=xyz#nospace\n",
      "audit_expected": [
        {
          "key": "A_TOKEN",
          "value": "abc"
        },
        {
          "key": "B_SECRET",
          "value": "has # inside quotes"
        },
        {
          "key": "C_TOKEN",
          "value": "xyz"
        }
      ],
      "rewrite": {
        "migrated_keys": [
          "A_TOKEN",
          "B_SECRET",
          "C_TOKEN",
          "ABSENT_TOKEN"
        ],
        "expected_text": "A_TOKEN=__vco_keychain__  # inline note\nB_SECRET=__vco_keychain__\nC_TOKEN=__vco_keychain__  #nospace\n",
        "expected_replaced": 3,
        "expected_missed": [
          "ABSENT_TOKEN"
        ]
      }
    },
    {
      "name": "placeholders_and_migrated",
      "input": "API_TOKEN=changeme\nSTRIPE_KEY=<your-api-key>\nOLD_SECRET=__vco_keychain__\nEMPTY_TOKEN=\nGOOD_TOKEN=real\n",
      "audit_expected": [
        {
          "key": "GOOD_TOKEN",
          "value": "real"
        }
      ],
      "rewrite": {
        "migrated_keys": [
          "GOOD_TOKEN",
          "ABSENT_TOKEN"
        ],
        "expected_text": "API_TOKEN=changeme\nSTRIPE_KEY=<your-api-key>\nOLD_SECRET=__vco_keychain__\nEMPTY_TOKEN=\nGOOD_TOKEN=__vco_keychain__\n",
        "expected_replaced": 1,
        "expected_missed": [
          "ABSENT_TOKEN"
        ]
      }
    },
    {
      "name": "duplicate_first_occurrence",
      "input": "TOKEN=first\nPLAIN=keep\nTOKEN=second\n",
      "audit_expected": [
        {
          "key": "TOKEN",
          "value": "first"
        },
        {
          "key": "TOKEN",
          "value": "second"
        }
      ],
      "rewrite": {
        "migrated_keys": [
          "TOKEN",
          "TOKEN",
          "ABSENT_TOKEN"
        ],
        "expected_text": "TOKEN=__vco_keychain__\nPLAIN=keep\nTOKEN=second\n",
        "expected_replaced": 1,
        "expected_missed": [
          "ABSENT_TOKEN"
        ]
      }
    },
    {
      "name": "crlf_line_endings",
      "input": "SECRET_A=one\r\nPLAIN=two\r\nSECRET_B=three\r\n",
      "audit_expected": [
        {
          "key": "SECRET_A",
          "value": "one"
        },
        {
          "key": "SECRET_B",
          "value": "three"
        }
      ],
      "rewrite": {
        "migrated_keys": [
          "SECRET_A",
          "SECRET_B",
          "ABSENT_TOKEN"
        ],
        "expected_text": "SECRET_A=__vco_keychain__\nPLAIN=two\nSECRET_B=__vco_keychain__\n",
        "expected_replaced": 2,
        "expected_missed": [
          "ABSENT_TOKEN"
        ]
      }
    },
    {
      "name": "no_trailing_newline",
      "input": "SOLE_TOKEN=v",
      "audit_expected": [
        {
          "key": "SOLE_TOKEN",
          "value": "v"
        }
      ],
      "rewrite": {
        "migrated_keys": [
          "SOLE_TOKEN",
          "ABSENT_TOKEN"
        ],
        "expected_text": "SOLE_TOKEN=__vco_keychain__",
        "expected_replaced": 1,
        "expected_missed": [
          "ABSENT_TOKEN"
        ]
      }
    },
    {
      "name": "export_prefix_and_spacing",
      "input": "export   SPACED_TOKEN=spaced-value\n  export INDENTED_SECRET=deep\nNOEQ_LINE_NO_EQUALS\n=leadingeq\n",
      "audit_expected": [
        {
          "key": "SPACED_TOKEN",
          "value": "spaced-value"
        },
        {
          "key": "INDENTED_SECRET",
          "value": "deep"
        }
      ],
      "rewrite": {
        "migrated_keys": [
          "SPACED_TOKEN",
          "INDENTED_SECRET",
          "ABSENT_TOKEN"
        ],
        "expected_text": "export SPACED_TOKEN=__vco_keychain__\n  export INDENTED_SECRET=__vco_keychain__\nNOEQ_LINE_NO_EQUALS\n=leadingeq\n",
        "expected_replaced": 2,
        "expected_missed": [
          "ABSENT_TOKEN"
        ]
      }
    },
    {
      "name": "key_suffix_key_rule",
      "input": "SOME_KEY=k1\nKEY=barekey\nMONKEY=notsecret\nPYTHONPATH=/x\n",
      "audit_expected": [
        {
          "key": "SOME_KEY",
          "value": "k1"
        },
        {
          "key": "KEY",
          "value": "barekey"
        }
      ],
      "rewrite": {
        "migrated_keys": [
          "SOME_KEY",
          "KEY",
          "ABSENT_TOKEN"
        ],
        "expected_text": "SOME_KEY=__vco_keychain__\nKEY=__vco_keychain__\nMONKEY=notsecret\nPYTHONPATH=/x\n",
        "expected_replaced": 2,
        "expected_missed": [
          "ABSENT_TOKEN"
        ]
      }
    }
  ]
}
