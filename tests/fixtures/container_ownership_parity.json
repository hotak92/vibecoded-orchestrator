{
  "_comment": "v0.2.100 WP-06 (AD-5, AD-12): who owns a container, from its real labels. Executed by Rust (launcher/src-tauri/vct-launcher-core/src/services/container_ownership.rs tests) and Python (tests/test_v02100_container_ownership_parity.py over vco_lib/containers.py: compose_label_family, ComposeIdentity, foreign_compose_identity, compose_project_name; vco_lib/service_lifecycle.py: zombie_action for the base column). `expect_on_zombie` is the zombie verb once ownership is known: a recreate-eligible row whose container is not Owned is at most started by name (expect_on_foreign_project rows). Labels are in the object shape `inspect` prints.",
  "labels": {
    "compose_project": "com.docker.compose.project",
    "podman_compose_project": "io.podman.compose.project",
    "docker_config_hash": "com.docker.compose.config-hash",
    "launcher": "io.vibecoded.vct.launcher"
  },
  "identity_cases": [
    {"name": "podman-compose", "labels": {"com.docker.compose.project": "infrastructure", "io.podman.compose.project": "infrastructure"}, "expect_provider": "podman", "expect_project": "infrastructure"},
    {"name": "docker compose v2", "labels": {"com.docker.compose.project": "infrastructure", "com.docker.compose.config-hash": "abc123"}, "expect_provider": "docker", "expect_project": "infrastructure"},
    {"name": "legacy project, podman-compose", "labels": {"com.docker.compose.project": "vibecoded", "io.podman.compose.project": "vibecoded"}, "expect_provider": "podman", "expect_project": "vibecoded"},
    {"name": "project label only", "labels": {"com.docker.compose.project": "infrastructure"}, "expect_provider": "", "expect_project": "infrastructure"},
    {"name": "podman label only (no compose project)", "labels": {"io.podman.compose.project": "infrastructure"}, "expect_provider": "podman", "expect_project": null},
    {"name": "hand-made container", "labels": {"maintainer": "someone"}, "expect_provider": "", "expect_project": null},
    {"name": "no labels", "labels": null, "expect_provider": "", "expect_project": null},
    {"name": "blank project label", "labels": {"com.docker.compose.project": "  "}, "expect_provider": "", "expect_project": null}
  ],
  "project_name_cases": [
    {"name": "installer dir basename", "dir": "/opt/vco/infrastructure", "compose_text": "services:\n  weaviate: {}\n", "expect": "infrastructure"},
    {"name": "name key wins", "dir": "/opt/vco/infrastructure", "compose_text": "name: vcostack\nservices: {}\n", "expect": "vcostack"},
    {"name": "quoted name key", "dir": "/opt/vco/infrastructure", "compose_text": "name: \"my-stack\" # pinned\nservices: {}\n", "expect": "my-stack"},
    {"name": "nested name is not the project", "dir": "/opt/vco/infrastructure", "compose_text": "services:\n  weaviate:\n    name: other\n", "expect": "infrastructure"},
    {"name": "basename normalised", "dir": "/home/u/My.Stack Dir", "compose_text": "", "expect": "mystackdir"},
    {"name": "leading separators trimmed", "dir": "/tmp/_-Infra", "compose_text": "", "expect": "infra"},
    {"name": "legacy home", "dir": "/opt/vco/claude_mcp_servers", "compose_text": "", "expect": "claude_mcp_servers"}
  ],
  "ownership_cases": [
    {"name": "installer's own container, row records nothing", "service": "code_embed",
     "row": {"mode": "vco_managed"}, "installer_project": "infrastructure",
     "labels": {"com.docker.compose.project": "infrastructure", "io.podman.compose.project": "infrastructure"},
     "expect_ownership": "owned", "expect_on_zombie": "recreate"},
    {"name": "2026-09-29 incident: row-managed, container of another project", "service": "code_embed",
     "row": {"mode": "vco_managed"}, "installer_project": "infrastructure",
     "labels": {"com.docker.compose.project": "vibecoded", "io.podman.compose.project": "vibecoded"},
     "expect_ownership": "foreign", "expect_on_zombie": "start"},
    {"name": "row records the legacy project the container carries", "service": "ollama",
     "row": {"mode": "vco_managed", "compose_project": "vibecoded"}, "installer_project": "infrastructure",
     "labels": {"com.docker.compose.project": "vibecoded", "io.podman.compose.project": "vibecoded"},
     "expect_ownership": "owned", "expect_on_zombie": "recreate"},
    {"name": "row records the installer project, container is legacy", "service": "ollama",
     "row": {"mode": "vco_managed", "compose_project": "infrastructure"}, "installer_project": "infrastructure",
     "labels": {"com.docker.compose.project": "vibecoded"},
     "expect_ownership": "foreign", "expect_on_zombie": "start"},
    {"name": "hand-made container under VCO's name", "service": "weaviate",
     "row": {"mode": "vco_managed"}, "installer_project": "infrastructure",
     "labels": {"maintainer": "someone"},
     "expect_ownership": "foreign", "expect_on_zombie": "start"},
    {"name": "podman label only is not a compose project", "service": "weaviate",
     "row": {"mode": "vco_managed"}, "installer_project": "infrastructure",
     "labels": {"io.podman.compose.project": "infrastructure"},
     "expect_ownership": "foreign", "expect_on_zombie": "start"},
    {"name": "docker-compose created the installer project", "service": "weaviate",
     "row": {"mode": "vco_managed"}, "installer_project": "infrastructure",
     "labels": {"com.docker.compose.project": "infrastructure", "com.docker.compose.config-hash": "h"},
     "expect_ownership": "owned", "expect_on_zombie": "recreate"},
    {"name": "no row: installer project owned, still only started by name", "service": "ollama",
     "row": null, "installer_project": "infrastructure",
     "labels": {"com.docker.compose.project": "infrastructure"},
     "expect_ownership": "owned", "expect_on_zombie": "start"},
    {"name": "no row: another project", "service": "ollama",
     "row": null, "installer_project": "infrastructure",
     "labels": {"com.docker.compose.project": "vibecoded"},
     "expect_ownership": "foreign", "expect_on_zombie": "start"},
    {"name": "adopted container with autostart", "service": "weaviate",
     "row": {"mode": "adopted_container", "container_name": "their_weaviate"}, "installer_project": "infrastructure",
     "labels": {"com.docker.compose.project": "theirs"},
     "expect_ownership": "foreign", "expect_on_zombie": "start"},
    {"name": "disabled row", "service": "code_embed",
     "row": {"mode": "vco_managed", "enabled": false}, "installer_project": "infrastructure",
     "labels": {"com.docker.compose.project": "infrastructure"},
     "expect_ownership": "owned", "expect_on_zombie": "ignore"}
  ]
}
