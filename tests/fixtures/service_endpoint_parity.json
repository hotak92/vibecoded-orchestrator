{
  "_comment": [
    "v0.2.97 lane W: ONE case table for where VCO's core services are reached.",
    "Read by launcher/src-tauri/vct-launcher-core/src/services/service_endpoints.rs tests (Rust: the hub /config",
    "and the launcher's populate) AND by tests/test_v0297_service_endpoints_parity.py (Python:",
    "vco_lib/service_endpoints.py, which config_projection / env_template resolve through when no caller pins a value).",
    "The two implementations are a (C)-tier mirror: the hub answers /config on every hook call and cannot spawn a",
    "Python per request. This table is what keeps them one rule. A new case goes HERE, never in one side's tests.",
    "`statement` is the machine statement (VCT_WEAVIATE_URL, else vct-config.toml weaviate_url); `port_override` is the",
    "raw app_state value; `adoption` is the services.toml row for the service (null = no row).",
    "ollama_url_cases run the same chain for Ollama (statement = VCT_OLLAMA_URL; no vct-config.toml key — env only)."
  ],
  "constants": {
    "statement_env": "VCT_WEAVIATE_URL",
    "ollama_statement_env": "VCT_OLLAMA_URL",
    "config_file": "vct-config.toml",
    "config_key": "weaviate_url",
    "services": {
      "weaviate": {"app_state_key": "weaviate.port_override", "default_port": 8081},
      "ollama": {"app_state_key": "ollama.port_override", "default_port": 11435},
      "code_embed": {"app_state_key": "code_embed.port_override", "default_port": 11440}
    }
  },
  "weaviate_url_cases": [
    {"name": "nothing set", "statement": null, "port_override": null, "adoption": null,
     "expect_url": "http://localhost:8081", "expect_port": 8081},
    {"name": "statement beats override and adoption", "statement": "http://vm.lan:9000", "port_override": "18081",
     "adoption": {"mode": "adopt", "external_url": "http://localhost:18090", "parallel_port": null},
     "expect_url": "http://vm.lan:9000", "expect_port": 9000},
    {"name": "blank statement is unset", "statement": "  ", "port_override": null, "adoption": null,
     "expect_url": "http://localhost:8081", "expect_port": 8081},
    {"name": "statement trimmed and trailing slash dropped", "statement": " http://vm.lan:9000/ \r", "port_override": null,
     "adoption": null, "expect_url": "http://vm.lan:9000", "expect_port": 9000},
    {"name": "https statement without a port", "statement": "https://weaviate.example.com", "port_override": null,
     "adoption": null, "expect_url": "https://weaviate.example.com", "expect_port": 443},
    {"name": "override beats adoption", "statement": null, "port_override": "18081",
     "adoption": {"mode": "adopt", "external_url": "http://localhost:18090", "parallel_port": null},
     "expect_url": "http://localhost:18081", "expect_port": 18081},
    {"name": "override with whitespace", "statement": null, "port_override": " 18081 ", "adoption": null,
     "expect_url": "http://localhost:18081", "expect_port": 18081},
    {"name": "override zero ignored", "statement": null, "port_override": "0", "adoption": null,
     "expect_url": "http://localhost:8081", "expect_port": 8081},
    {"name": "override not a number ignored", "statement": null, "port_override": "abc", "adoption": null,
     "expect_url": "http://localhost:8081", "expect_port": 8081},
    {"name": "override signed ignored", "statement": null, "port_override": "+18081", "adoption": null,
     "expect_url": "http://localhost:8081", "expect_port": 8081},
    {"name": "override out of range ignored", "statement": null, "port_override": "70000", "adoption": null,
     "expect_url": "http://localhost:8081", "expect_port": 8081},
    {"name": "adopted external weaviate keeps its host", "statement": null, "port_override": null,
     "adoption": {"mode": "adopt", "external_url": "http://weaviate.lan:8090/v1/meta", "parallel_port": null},
     "expect_url": "http://weaviate.lan:8090", "expect_port": 8090},
    {"name": "adopted external weaviate without a port", "statement": null, "port_override": null,
     "adoption": {"mode": "adopt", "external_url": "http://weaviate.lan", "parallel_port": null},
     "expect_url": "http://weaviate.lan", "expect_port": 80},
    {"name": "adopted without a url", "statement": null, "port_override": null,
     "adoption": {"mode": "adopt", "external_url": null, "parallel_port": null},
     "expect_url": "http://localhost:8081", "expect_port": 8081},
    {"name": "parallel copy on its own port", "statement": null, "port_override": null,
     "adoption": {"mode": "parallel", "external_url": null, "parallel_port": 18082},
     "expect_url": "http://localhost:18082", "expect_port": 18082},
    {"name": "parallel without a port", "statement": null, "port_override": null,
     "adoption": {"mode": "parallel", "external_url": null, "parallel_port": null},
     "expect_url": "http://localhost:8081", "expect_port": 8081},
    {"name": "refused adoption is not an address", "statement": null, "port_override": null,
     "adoption": {"mode": "refuse", "external_url": "http://other:1", "parallel_port": null},
     "expect_url": "http://localhost:8081", "expect_port": 8081},
    {"name": "unresolved adoption is not an address", "statement": null, "port_override": null,
     "adoption": {"mode": "unresolved", "external_url": "http://other:1", "parallel_port": 2},
     "expect_url": "http://localhost:8081", "expect_port": 8081}
  ],
  "port_cases": [
    {"name": "ollama default", "service": "ollama", "port_override": null, "adoption": null, "expect_port": 11435},
    {"name": "code_embed default", "service": "code_embed", "port_override": null, "adoption": null, "expect_port": 11440},
    {"name": "ollama override", "service": "ollama", "port_override": "21435", "adoption": null, "expect_port": 21435},
    {"name": "ollama parallel", "service": "ollama", "port_override": null,
     "adoption": {"mode": "parallel", "external_url": null, "parallel_port": 11436}, "expect_port": 11436},
    {"name": "code_embed adopted url port", "service": "code_embed", "port_override": null,
     "adoption": {"mode": "adopt", "external_url": "http://localhost:11441/health", "parallel_port": null},
     "expect_port": 11441},
    {"name": "code_embed adopted url without port", "service": "code_embed", "port_override": null,
     "adoption": {"mode": "adopt", "external_url": "http://embed.lan", "parallel_port": null},
     "expect_port": 11440},
    {"name": "code_embed refuse", "service": "code_embed", "port_override": null,
     "adoption": {"mode": "refuse", "external_url": "http://localhost:1", "parallel_port": null},
     "expect_port": 11440}
  ],
  "ollama_url_cases": [
    {"name": "nothing set", "statement": null, "port_override": null, "adoption": null,
     "expect_url": "http://localhost:11435", "expect_port": 11435},
    {"name": "statement beats override and adoption", "statement": "http://ollama.lan:11500", "port_override": "21435",
     "adoption": {"mode": "adopt", "external_url": "http://localhost:21436", "parallel_port": null},
     "expect_url": "http://ollama.lan:11500", "expect_port": 11500},
    {"name": "blank statement is unset", "statement": "  ", "port_override": null, "adoption": null,
     "expect_url": "http://localhost:11435", "expect_port": 11435},
    {"name": "statement trimmed and trailing slash dropped", "statement": " http://ollama.lan:11500/ \r", "port_override": null,
     "adoption": null, "expect_url": "http://ollama.lan:11500", "expect_port": 11500},
    {"name": "https statement without a port", "statement": "https://ollama.example.com", "port_override": null,
     "adoption": null, "expect_url": "https://ollama.example.com", "expect_port": 443},
    {"name": "override beats adoption", "statement": null, "port_override": "21435",
     "adoption": {"mode": "parallel", "external_url": null, "parallel_port": 21436},
     "expect_url": "http://localhost:21435", "expect_port": 21435},
    {"name": "override zero ignored", "statement": null, "port_override": "0", "adoption": null,
     "expect_url": "http://localhost:11435", "expect_port": 11435},
    {"name": "override not a number ignored", "statement": null, "port_override": "abc", "adoption": null,
     "expect_url": "http://localhost:11435", "expect_port": 11435},
    {"name": "adopted external ollama keeps its host", "statement": null, "port_override": null,
     "adoption": {"mode": "adopt", "external_url": "http://ollama.lan:11439/api/tags", "parallel_port": null},
     "expect_url": "http://ollama.lan:11439", "expect_port": 11439},
    {"name": "parallel copy on its own port", "statement": null, "port_override": null,
     "adoption": {"mode": "parallel", "external_url": null, "parallel_port": 21436},
     "expect_url": "http://localhost:21436", "expect_port": 21436},
    {"name": "refused adoption is not an address", "statement": null, "port_override": null,
     "adoption": {"mode": "refuse", "external_url": "http://other:1", "parallel_port": null},
     "expect_url": "http://localhost:11435", "expect_port": 11435}
  ]
}
