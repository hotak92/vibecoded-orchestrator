{
  "_comment": [
    "v0.2.97 R9 H1(b)/H5 + R10 J3 — ONE fixture for the usual-tool-install-locations rule, read by",
    "tests/test_v0297_r9_runtime_locations.py (Python: vco_lib.tool_search_dirs.search_entries / lookup_entries) AND",
    "by launcher/src-tauri/vct-launcher-core/src/services/runtime.rs (Rust: tool_search_entries_for /",
    "augmented_entries, the launcher's and the hub's startup PATH augment). Both read the table",
    "vco_lib/tool_search_dirs.toml.",
    "`cases` pin the per-OS lists as [dir, placement] pairs and the expansion rule: `~/rest` needs a home,",
    "`${NAME}rest` a set non-empty NAME, anything else is literal; duplicates are dropped; VCT_TOOL_SEARCH_DIRS",
    "(set, even empty) REPLACES the list, split on the OS path separator, every entry placed `append`.",
    "`order_cases` pin THE ORDER RULE: [prepend-when-missing entries not on `path`] + `path` unchanged +",
    "[append entries not on `path`] must equal `expect_path`; then `resolve` names the first `expect_path`",
    "directory D for which D + sep + resolve is in `binaries` (sep `\\` for windows, `/` else) — `expect`,",
    "or null when none. `home` null = no home; `env` is the whole environment the case sees."
  ],
  "cases": [
    {
      "name": "linux_table_with_a_home",
      "os": "linux",
      "home": "/home/u",
      "env": {},
      "expect": [
        ["/home/u/.local/bin", "prepend-when-missing"],
        ["/home/u/.cargo/bin", "prepend-when-missing"],
        ["/home/linuxbrew/.linuxbrew/bin", "prepend-when-missing"],
        ["/snap/bin", "prepend-when-missing"],
        ["/var/lib/flatpak/exports/bin", "prepend-when-missing"],
        ["/home/u/bin", "append"],
        ["/usr/local/bin", "append"],
        ["/usr/bin", "append"]
      ]
    },
    {
      "name": "linux_without_a_home_drops_the_home_relative_entries",
      "os": "linux",
      "home": null,
      "env": {},
      "expect": [
        ["/home/linuxbrew/.linuxbrew/bin", "prepend-when-missing"],
        ["/snap/bin", "prepend-when-missing"],
        ["/var/lib/flatpak/exports/bin", "prepend-when-missing"],
        ["/usr/local/bin", "append"],
        ["/usr/bin", "append"]
      ]
    },
    {
      "name": "macos_table_covers_homebrew_podman_and_docker_desktop",
      "os": "macos",
      "home": "/Users/u",
      "env": {},
      "expect": [
        ["/opt/homebrew/bin", "prepend-when-missing"],
        ["/opt/homebrew/sbin", "prepend-when-missing"],
        ["/Users/u/.cargo/bin", "prepend-when-missing"],
        ["/Users/u/.local/bin", "prepend-when-missing"],
        ["/Users/u/bin", "append"],
        ["/usr/local/bin", "append"],
        ["/opt/podman/bin", "append"],
        ["/Applications/Docker.app/Contents/Resources/bin", "append"],
        ["/Users/u/Applications/Docker.app/Contents/Resources/bin", "append"],
        ["/Users/u/.docker/bin", "append"],
        ["/opt/local/bin", "append"],
        ["/usr/bin", "append"]
      ]
    },
    {
      "name": "windows_table_expands_the_installer_locations",
      "os": "windows",
      "home": null,
      "env": {
        "ProgramFiles": "C:\\Program Files",
        "LOCALAPPDATA": "C:\\Users\\u\\AppData\\Local"
      },
      "expect": [
        ["C:\\Program Files\\Docker\\Docker\\resources\\bin", "append"],
        ["C:\\Program Files\\RedHat\\Podman", "append"],
        ["C:\\Users\\u\\AppData\\Local\\Programs\\Podman", "append"]
      ]
    },
    {
      "name": "windows_entries_whose_variable_is_unset_or_empty_are_dropped",
      "os": "windows",
      "home": null,
      "env": {
        "ProgramFiles": ""
      },
      "expect": []
    },
    {
      "name": "an_os_without_a_list_has_none",
      "os": "other",
      "home": "/home/u",
      "env": {},
      "expect": []
    },
    {
      "name": "the_override_set_empty_means_no_directories",
      "os": "linux",
      "home": "/home/u",
      "env": {
        "VCT_TOOL_SEARCH_DIRS": ""
      },
      "expect": []
    },
    {
      "name": "the_override_replaces_the_list_with_the_same_syntax_all_appended",
      "os": "linux",
      "home": "/h/",
      "env": {
        "VCT_TOOL_SEARCH_DIRS": "~/bin::/opt/x:~/bin"
      },
      "expect": [
        ["/h/bin", "append"],
        ["/opt/x", "append"]
      ]
    },
    {
      "name": "the_windows_override_splits_on_semicolons",
      "os": "windows",
      "home": null,
      "env": {
        "VCT_TOOL_SEARCH_DIRS": "${ProgramFiles}\\X;C:\\Y",
        "ProgramFiles": "C:\\PF"
      },
      "expect": [
        ["C:\\PF\\X", "append"],
        ["C:\\Y", "append"]
      ]
    },
    {
      "name": "a_malformed_variable_reference_is_literal",
      "os": "linux",
      "home": null,
      "env": {
        "VCT_TOOL_SEARCH_DIRS": "${1BAD}/x:${}/y"
      },
      "expect": [
        ["${1BAD}/x", "append"],
        ["${}/y", "append"]
      ]
    }
  ],
