 "_doc": "Shared SSRF case table: every case runs against BOTH templates/hooks/_lib/ssrf-allowlist.sh and .ps1 (tests/test_v02100_ssrf_url_parity.py). expect = allow (a VCO service on this machine) | block (private / internal / unreadable) | pass (public). The env marker __NO_PYTHON__ runs that group with a PATH that holds no Python interpreter.",
 "envs": {
  "moved": {
   "WEAVIATE_URL": "http://127.0.0.1:18081",
   "OLLAMA_URL": "http://localhost:21435",
   "CODE_EMBED_SERVICE_URL": "http://GPU.LAN:11440"
  },
  "default": {},
  "nopython": {
   "__NO_PYTHON__": "1"
  }
 },
 "cases": [
  {
   "env": "moved",
   "url": "http://localhost:18081/v1/meta",
   "expect": "allow",
   "why": "moved Weaviate (row -> env)"
  },
  {
   "env": "moved",
   "url": "http://127.0.0.1:18081/",
   "expect": "allow",
   "why": "loopback spelling of a moved pair"
  },
  {
   "env": "moved",
   "url": "http://[::1]:18081/",
   "expect": "allow",
   "why": "IPv6 loopback spelling"
  },
  {
   "env": "moved",
   "url": "http://[0:0:0:0:0:0:0:1]:18081/",
   "expect": "allow",
   "why": "long-form IPv6 loopback is the same pair"
  },
  {
   "env": "moved",
   "url": "http://LOCALHOST:18081/",
   "expect": "allow",
   "why": "host case-folded"
  },
  {
   "env": "moved",
   "url": "HTTP://localhost:21435/api/tags",
   "expect": "allow",
   "why": "scheme case-insensitive (moved Ollama)"
  },
  {
   "env": "moved",
   "url": "http://localhost.:21435/",
   "expect": "allow",
   "why": "trailing dot"
  },
  {
   "env": "moved",
   "url": "http://gpu.lan:11440/health",
   "expect": "allow",
   "why": "adopted non-loopback service (env spelled GPU.LAN)"
  },
  {
   "env": "moved",
   "url": "http://localhost:8082/",
   "expect": "allow",
   "why": "literal :8082"
  },
  {
   "env": "moved",
   "url": "http://localhost:7860/",
   "expect": "allow",
   "why": "Gradio literal"
  },
  {
   "env": "moved",
   "url": "http://localhost:7700/api/v1/health",
   "expect": "allow",
   "why": "hub default port (no resolver)"
  },
  {
   "env": "moved",
   "url": " http://localhost:18081 ",
   "expect": "allow",
   "why": "surrounding spaces trimmed"
  },
  {
   "env": "moved",
   "url": "http://localhost:8081/v1/meta",
   "expect": "block",
   "why": "Weaviate's OLD port once it moved"
  },
  {
   "env": "moved",
   "url": "http://127.0.0.1:9999/",
   "expect": "block",
   "why": "a random local port"
  },
  {
   "env": "moved",
   "url": "http://10.0.0.1:22\\@localhost:18081/",
   "expect": "block",
   "why": "R18-04 backslash: WHATWG host is 10.0.0.1:22"
  },
  {
   "env": "moved",
   "url": "http://10.0.0.1:22\\@127.0.0.1:18081/",
   "expect": "block",
   "why": "R18-04 backslash, 127.0.0.1 decoy"
  },
  {
   "env": "moved",
   "url": "http://10.0.0.1:22\\@[::1]:18081/",
   "expect": "block",
   "why": "R18-04 backslash, [::1] decoy"
  },
  {
   "env": "moved",
   "url": "http://localhost:18081\\@evil.example/",
   "expect": "block",
   "why": "backslash in the authority is never allowed"
  },
  {
   "env": "moved",
   "url": "http://localhost:18081@10.0.0.5:22/",
   "expect": "block",
   "why": "userinfo trick: host is 10.0.0.5"
  },
  {
   "env": "moved",
   "url": "http://evil@localhost:18081/",
   "expect": "block",
   "why": "userinfo on an allowed pair is not a clean authority"
  },
  {
   "env": "moved",
   "url": "http:\\\\10.0.0.1\\x",
   "expect": "block",
