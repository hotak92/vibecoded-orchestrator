    {"name": "exe inside the clone (cargo target layout)", "files": {"clone/vct-module.json": "@orchestrator"}, "db_cached": null, "exe": "clone/launcher/src-tauri/target/release/vct-launcher", "expect": {"kind": "ok", "root": "clone", "source": "exe_walk", "exe_inside": true}},
    {"name": "macOS .app bundle inside the clone", "files": {"clone/vct-module.json": "@orchestrator"}, "db_cached": null, "exe": "clone/launcher/dist/macos-arm64/VCT Launcher.app/Contents/MacOS/vct-launcher", "expect": {"kind": "ok", "root": "clone", "source": "exe_walk", "exe_inside": true}},
    {"name": "macOS .app in /Applications with a cached clone", "files": {"clone/vct-module.json": "@orchestrator"}, "db_cached": "clone", "exe": "Applications/VCT Launcher.app/Contents/MacOS/vct-launcher", "expect": {"kind": "ok", "root": "clone", "source": "db_cache", "exe_inside": false}},
    {"name": "exe outside the clone, cache present", "files": {"clone/vct-module.json": "@orchestrator", "clone/install.py": "", "clone/CLAUDE.md": ""}, "db_cached": "clone", "exe": "tmpbin/vct-launcher", "expect": {"kind": "ok", "root": "clone", "source": "db_cache", "exe_inside": false}},
    {"name": "exe outside the clone, no cache", "files": {"clone/vct-module.json": "@orchestrator"}, "db_cached": null, "exe": "tmpbin/vct-launcher", "expect": {"kind": "not_found"}},
    {"name": "exe under an unrelated git tree never yields a root", "files": {"home/.git/HEAD": "ref: refs/heads/main\n", "home/install.py": "", "home/CLAUDE.md": "", "home/vct-module.json": "{\"id\": \"dotfiles\"}"}, "db_cached": null, "exe": "home/bin/vct-launcher", "expect": {"kind": "not_found"}},
    {"name": "exe under an unrelated git tree with a cached clone", "files": {"home/.git/HEAD": "ref: refs/heads/main\n", "home/install.py": "", "home/CLAUDE.md": "", "clone/vct-module.json": "@orchestrator"}, "db_cached": "clone", "exe": "home/bin/vct-launcher", "expect": {"kind": "ok", "root": "clone", "source": "db_cache", "exe_inside": false}},
    {"name": "missing markers: install.py + CLAUDE.md only", "files": {"clone/install.py": "", "clone/CLAUDE.md": ""}, "db_cached": null, "exe": "clone/launcher/dist/linux-x64/vct-launcher", "expect": {"kind": "not_found"}},
    {"name": "stale cache falls through to the walk", "files": {"clone/vct-module.json": "@orchestrator"}, "db_cached": "moved-away", "exe": "clone/launcher/dist/linux-x64/vct-launcher", "expect": {"kind": "ok", "root": "clone", "source": "exe_walk", "exe_inside": true}},
    {"name": "cache naming an unrelated directory falls through", "files": {"clone/vct-module.json": "@orchestrator", "random/install.py": "", "random/CLAUDE.md": ""}, "db_cached": "random", "exe": "clone/launcher/dist/linux-x64/vct-launcher", "expect": {"kind": "ok", "root": "clone", "source": "exe_walk", "exe_inside": true}},
    {"name": "cache naming a foreign module's manifest falls through", "files": {"clone/vct-module.json": "@orchestrator", "mod/vct-module.json": "{\"id\": \"vct-rl-reranker\"}", "mod/install.py": "", "mod/CLAUDE.md": ""}, "db_cached": "mod", "exe": "clone/launcher/dist/linux-x64/vct-launcher", "expect": {"kind": "ok", "root": "clone", "source": "exe_walk", "exe_inside": true}},
    {"name": "stale pre-0.2.100 structural-only cache, exe outside any clone, is not a root", "files": {"old/install.py": "", "old/CLAUDE.md": ""}, "db_cached": "old", "exe": "tmpbin/vct-launcher", "expect": {"kind": "not_found"}},
    {"name": "user project with install.py + CLAUDE.md + a bundled compose copy is never the cached root", "files": {"clone/vct-module.json": "@orchestrator", "proj/install.py": "", "proj/CLAUDE.md": "", "proj/infrastructure/docker-compose.yml": "services: {}\n"}, "db_cached": "proj", "exe": "clone/launcher/dist/linux-x64/vct-hub", "expect": {"kind": "ok", "root": "clone", "source": "exe_walk", "exe_inside": true}},
    {"name": "cache wins over the walk when both are valid", "files": {"clone/vct-module.json": "@orchestrator", "other/vct-module.json": "@orchestrator"}, "db_cached": "clone", "exe": "other/launcher/dist/linux-x64/vct-launcher", "expect": {"kind": "ok", "root": "clone", "source": "db_cache", "exe_inside": false}},
    {"name": "walk reaches the 8th level", "files": {"clone/vct-module.json": "@orchestrator"}, "db_cached": null, "exe": "clone/a/b/c/d/e/f/g/vct-launcher", "expect": {"kind": "ok", "root": "clone", "source": "exe_walk", "exe_inside": true}},
    {"name": "walk is bounded to 8 levels", "files": {"clone/vct-module.json": "@orchestrator"}, "db_cached": null, "exe": "clone/a/b/c/d/e/f/g/h/vct-launcher", "expect": {"kind": "not_found"}},
    {"name": "nearest clone wins over an outer unrelated repo", "files": {"home/.git/HEAD": "ref: refs/heads/main\n", "home/dev/clone/vct-module.json": "@orchestrator"}, "db_cached": null, "exe": "home/dev/clone/launcher/dist/linux-x64/vct-launcher", "expect": {"kind": "ok", "root": "home/dev/clone", "source": "exe_walk", "exe_inside": true}}
  ],
