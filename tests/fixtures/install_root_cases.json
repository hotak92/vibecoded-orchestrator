{
  "_comment": "v0.2.100 WP-02 (AD-2) shared case table for the ONE install-root resolver. Rule-C mirror: the Rust implementation is launcher/src-tauri/vct-launcher-core/src/services/install_root.rs (is_orchestrator_clone / resolve / exe_is_inside); the Python lock is tests/test_v02100_install_root_identity.py. Both read THIS file; MUST stay in lockstep. Paths are '/'-separated and relative to a per-case temp dir; `files` maps a relative path to its content (the value `@orchestrator` is shorthand for a vct-module.json whose id is `orchestrator`). `identity` rows: is `dir` an orchestrator clone? (looks_like_orchestrator_root — vct-module.json OR install.py+CLAUDE.md — AND the vct-module.json `id` is exactly `orchestrator`). `resolve` rows: `db_cached` is the launcher.install_path cache (null = none) — accepted ONLY when it passes the same identity rule as the walk (W1R-06), else it falls through to the walk, `exe` the running binary; expect.kind is ok|not_found, expect.source db_cache|exe_walk, expect.exe_inside says whether a self-update may run from this binary (false = RootError::ExeOutsideClone naming <root>/launcher/dist/). `containment` rows are string-level (they include Windows verbatim-prefix and UNC shapes a POSIX host cannot create on disk).",
  "identity": [
    {"name": "full clone: manifest id orchestrator + install.py + CLAUDE.md", "files": {"clone/vct-module.json": "@orchestrator", "clone/install.py": "", "clone/CLAUDE.md": ""}, "dir": "clone", "expect": true},
    {"name": "manifest alone with the orchestrator id", "files": {"clone/vct-module.json": "@orchestrator"}, "dir": "clone", "expect": true},
    {"name": "install.py + CLAUDE.md without a manifest is not identity-confirmed", "files": {"clone/install.py": "", "clone/CLAUDE.md": ""}, "dir": "clone", "expect": false},
    {"name": "another module's manifest", "files": {"mod/vct-module.json": "{\"id\": \"vct-rl-reranker\"}", "mod/install.py": "", "mod/CLAUDE.md": ""}, "dir": "mod", "expect": false},
    {"name": "id comparison is exact (case)", "files": {"clone/vct-module.json": "{\"id\": \"Orchestrator\"}"}, "dir": "clone", "expect": false},
    {"name": "unparseable manifest", "files": {"clone/vct-module.json": "{not json", "clone/install.py": "", "clone/CLAUDE.md": ""}, "dir": "clone", "expect": false},
    {"name": "manifest without an id", "files": {"clone/vct-module.json": "{\"name\": \"VibeCoded Orchestrator\"}"}, "dir": "clone", "expect": false},
    {"name": "manifest id not a string", "files": {"clone/vct-module.json": "{\"id\": 7}"}, "dir": "clone", "expect": false},
    {"name": "manifest is a directory", "files": {"clone/vct-module.json/x": ""}, "dir": "clone", "expect": false},
    {"name": "unrelated git work tree", "files": {"home/.git/HEAD": "ref: refs/heads/main\n", "home/install.py": "", "home/CLAUDE.md": ""}, "dir": "home", "expect": false},
    {"name": "empty directory", "files": {"empty/.keep": ""}, "dir": "empty", "expect": false}
  ],
  "resolve": [
