{
  "_comment": "v0.2.100 W5R-04: the ONE argv shape for syncing a single extra code-graph path. Asserted by vct-launcher-core db::codegraph_extras::extra_path_sync_args (Rust, panel Sync button) AND vco_lib.codegraph_extras_refresh.build_extra_sync_argv (Python, automatic Stop-drain refresh). Edit both sides together. The stale_cases table pins the shared 'needs a re-index' rule (Rust extra_path_is_stale / Python extra_path_is_stale): stale iff the repo HEAD is known and differs from last_indexed_commit.",
  "cases": [
    {
      "name": "full pass (incremental off)",
      "path": "/srv/clone",
      "prefix": "Acme",
      "incremental": false,
      "since_commit": "abc1234",
      "argv": [
        "/srv/clone",
        "--project",
        "Acme",
        "--json-progress"
      ]
    },
    {
      "name": "incremental with last indexed commit",
      "path": "/srv/clone",
      "prefix": "Acme",
      "incremental": true,
      "since_commit": "abc1234",
      "argv": [
        "/srv/clone",
        "--project",
        "Acme",
        "--json-progress",
        "--incremental",
        "--since-commit",
        "abc1234"
      ]
    },
    {
      "name": "incremental without a commit",
      "path": "/srv/clone",
      "prefix": "Acme",
      "incremental": true,
      "since_commit": null,
      "argv": [
        "/srv/clone",
        "--project",
        "Acme",
        "--json-progress",
        "--incremental"
      ]
    },
    {
      "name": "blank commit treated as absent",
      "path": "C:/work/clone",
      "prefix": "My_Proj",
      "incremental": true,
      "since_commit": "  ",
      "argv": [
        "C:/work/clone",
        "--project",
        "My_Proj",
        "--json-progress",
        "--incremental"
      ]
    }
  ],
  "stale_cases": [
    {
      "head": "aaa",
      "last": "aaa",
      "stale": false
    },
    {
      "head": "bbb",
      "last": "aaa",
      "stale": true
    },
    {
      "head": "bbb",
      "last": null,
      "stale": true
    },
    {
      "head": null,
      "last": "aaa",
      "stale": false
    },
    {
      "head": null,
      "last": null,
      "stale": false
    },
    {
      "head": " aaa\n",
      "last": "aaa",
      "stale": false
    }
  ]
}
